<wxs src="/i18n/i18n.wxs" module="i18n" />
<view class="page-container wizard">
  <!-- 进度条：让人知道还有几步，不至于填到一半跑掉 -->
  <view class="steps">
    <block wx:if="{{ordering}}">
      <view class="step-dot {{step >= 1 ? 'on' : ''}}">1</view>
      <view class="step-bar {{step >= 2 ? 'on' : ''}}"></view>
      <view class="step-dot {{step >= 2 ? 'on' : ''}}">2</view>
      <view class="step-bar {{step >= 3 ? 'on' : ''}}"></view>
      <view class="step-dot {{step >= 3 ? 'on' : ''}}">3</view>
    </block>
    <block wx:else>
      <view class="step-dot on">1</view>
      <view class="step-bar {{step >= 3 ? 'on' : ''}}"></view>
      <view class="step-dot {{step >= 3 ? 'on' : ''}}">2</view>
    </block>
  </view>

  <!-- ========== 第 1 步：这家店是什么 ========== -->
  <block wx:if="{{step === 1}}">
    <view class="wizard-title">{{i18n.t('你的小店叫什么？', lang)}}</view>
    <view class="wizard-sub">{{i18n.t('开店码找明尼助手要，店名和介绍之后都能改。', lang)}}</view>

    <ban-bar />

    <input placeholder="{{i18n.t('开店码', lang)}}" value="{{create_code}}" bindinput="onCodeInput" maxlength="8" class="card form-card code-input" />

    <input placeholder="{{i18n.t('小店名称（必填）', lang)}}" value="{{name}}" bindinput="onInput" data-field="name" class="card form-card" />

    <textarea placeholder="{{i18n.t('一句话介绍（选填，做什么、有什么特色）', lang)}}" value="{{description}}" bindinput="onInput" data-field="description" maxlength="300" class="card form-card" style="width: auto; height: 140rpx;"></textarea>
  </block>

  <!-- ========== 第 2 步：买家去哪取货 ========== -->
  <block wx:if="{{ordering && step === 2}}">
    <view class="wizard-title">{{i18n.t('买家去哪取货？', lang)}}</view>
    <view class="wizard-sub">{{i18n.t('设几个取货点，开团时再选这一场去哪几个。', lang)}}</view>

    <plan-editor part="points"
                 init-points="{{planPoints}}"
                 bind:change="onPlanChange" />
  </block>

  <!-- ========== 第 3 步：怎么找到你 ========== -->
  <block wx:if="{{step === 3}}">
    <view class="wizard-title">{{i18n.t('买家怎么找到你？', lang)}}</view>
    <view class="wizard-sub">{{i18n.t('手机号和消息联系方式是必填的，其余可以之后再补。', lang)}}</view>

    <input type="number" maxlength="15" placeholder="{{i18n.t('手机号（必填，买家有急事时打给你）', lang)}}" value="{{contact_phone}}" bindinput="onInput" data-field="contact_phone" class="card form-card" />

    <!-- 联系方式（微信号或邮箱都行，界面上不提邮箱）。成团时拼团成功通知的「联系人」写这个，通知里最多放 20 个字，再长就只写手机号 -->
    <input maxlength="40" placeholder="{{i18n.t('消息联系方式，如微信号（必填，成团后你用它联系买家）', lang)}}" value="{{contact_handle}}" bindinput="onInput" data-field="contact_handle" class="card form-card" />

    <view class="section-title">{{i18n.t('详细信息（选填）', lang)}}</view>

    <view class="logo-row card" bindtap="chooseLogo">
      <image wx:if="{{logo}}" src="{{logo}}" mode="aspectFill" class="logo-img" />
      <view wx:else class="logo-img logo-placeholder">+</view>
      <view class="logo-hint">
        <view>{{i18n.t('小店 Logo', lang)}}</view>
        <view class="text-light">{{i18n.f('点击{0}，建议正方形', lang, logo ? i18n.t('更换', lang) : i18n.t('上传', lang))}}</view>
      </view>
    </view>

    <input wx:if="{{ordering}}" placeholder="{{i18n.t('起送价（美元，不填就是不限）', lang)}}" type="digit" value="{{min_order}}" bindinput="onInput" data-field="min_order" class="card form-card" />

    <view class="card license-row" bindtap="chooseLicense">
      <image wx:if="{{licenseImage}}" src="{{licenseImage}}" mode="aspectFill" class="license-img" />
      <view wx:else class="license-img license-placeholder">+</view>
      <view class="license-hint">
        <view>{{i18n.t('许可证 / 资质凭证', lang)}}</view>
        <view class="text-light">{{i18n.f('点击{0}。会在小店页公开展示，请遮住证件号等个人信息', lang, licenseImage ? i18n.t('更换', lang) : i18n.t('上传', lang))}}</view>
      </view>
    </view>

    <disclaimer-bar type="apply" full="{{true}}" />

    <view class="agree-row">
      <checkbox-group bindchange="onAgreeChange">
        <label class="agree-label">
          <checkbox value="1" checked="{{agreed}}" color="#7A0019" />
          <text class="agree-text">{{i18n.t('我已阅读并同意', lang)}}</text>
        </label>
      </checkbox-group>
      <text class="agree-link" catchtap="openAgreement">{{i18n.t('《店长责任告知书》', lang)}}</text>
    </view>
  </block>

  <!-- 底部固定操作栏 -->
  <view class="wizard-spacer"></view>
  <view class="wizard-bar">
    <button wx:if="{{step > 1}}" class="btn-outline wizard-btn" bindtap="prev">{{i18n.t('上一步', lang)}}</button>
    <button wx:if="{{step < 3}}" class="btn-primary wizard-btn" bindtap="next">{{i18n.t('下一步', lang)}}</button>
    <button wx:else class="btn-primary wizard-btn" bindtap="submit" loading="{{saving}}">{{i18n.t('开店', lang)}}</button>
  </view>
</view>
