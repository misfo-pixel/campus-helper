/* ---------- 向导骨架 ---------- */
.wizard {
  padding-bottom: 0;
}

.steps {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin-bottom: 40rpx;
}

.step-dot {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #eee;
  color: #aaa;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.step-dot.on {
  background: var(--color-primary);
  color: #fff;
}

.step-bar {
  width: 80rpx;
  height: 4rpx;
  background: #eee;
}

.step-bar.on {
  background: var(--color-primary);
}

.wizard-title {
  font-size: 40rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.wizard-sub {
  font-size: 26rpx;
  color: var(--color-text-light);
  line-height: 1.6;
  margin-bottom: 32rpx;
}

/* 底部固定操作栏，给内容留出等高的空位 */
.wizard-spacer {
  height: 160rpx;
}

.wizard-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 20rpx;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid #eee;
}

.wizard-btn {
  flex: 1;
  margin: 0;
}

/* ---------- 二选一大卡片 ---------- */
.pick {
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
  padding: 32rpx 28rpx;
  border: 2rpx solid #eee;
  border-radius: 16rpx;
  background: #fff;
  margin-bottom: 20rpx;
}

.pick-on {
  border-color: var(--color-primary);
  background: #fdf7f8;
}

.pick-sm {
  padding: 24rpx 28rpx;
}

.pick-emoji {
  font-size: 48rpx;
  line-height: 1.2;
}

.pick-body {
  flex: 1;
  min-width: 0;
}

.pick-name {
  font-size: 30rpx;
  font-weight: bold;
}

.pick-desc {
  font-size: 24rpx;
  color: var(--color-text-light);
  line-height: 1.6;
  margin-top: 6rpx;
}

/* ---------- 表单件（与 shopedit 保持一致的观感）---------- */
.form-card {
  padding: 24rpx;
  font-size: 30rpx;
}

.logo-row,
.license-row {
  display: flex;
  align-items: center;
  padding: 24rpx;
  gap: 24rpx;
}

.logo-img,
.license-img {
  width: 140rpx;
  height: 140rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
}

.logo-placeholder,
.license-placeholder {
  border: 2rpx dashed #ccc;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #999;
  font-size: 56rpx;
}

.logo-hint,
.license-hint {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
}

.license-hint .text-light,
.logo-hint .text-light {
  font-size: 24rpx;
  line-height: 1.5;
  margin-top: 6rpx;
}

.agree-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  margin-top: 32rpx;
}

.agree-label {
  display: flex;
  align-items: center;
}

.agree-text {
  font-size: 26rpx;
  color: #555;
}

.agree-link {
  font-size: 26rpx;
  color: var(--color-primary);
}

/* 开关坐在小节标题右边，跟小店设置那边保持一致 */
.title-switch {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  margin: 24rpx 0 8rpx;
}

.title-switch-label {
  margin: 0;
}

/* 置灰：送达时间没有队能接时，「找配送队」这一项 */
.pick-off {
  opacity: 0.45;
}

/* 具体选哪一支队，缩进一档表示从属关系 */
.team-pick {
  margin-left: 32rpx;
}

.team-closed {
  font-size: 24rpx;
  color: var(--color-text-light);
  font-weight: normal;
}

.team-empty {
  margin: 0 0 20rpx 32rpx;
}

/* 队伍卡片上的可配送时段。时间对不上的队也照样摆出来——
   店长照着改自己的送达时间就能用上，比只看到一张灰卡片有用 */
.team-slots {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--color-text-light);
  line-height: 1.6;
}

.team-slot {
  display: inline-block;
  margin-right: 12rpx;
}

/* 选完队又把送达时间改到人家没空的点上。不解绑，只在这里说一句 */
.team-warn {
  margin: 0 0 16rpx 32rpx;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  background: #FFF6E5;
  color: #8A5A00;
  font-size: 24rpx;
  line-height: 1.6;
}

