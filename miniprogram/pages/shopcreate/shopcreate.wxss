/* ---------- 向导骨架 ---------- */
.wizard {
  padding-bottom: 0;
}

.steps {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin-bottom: 40rpx;
}

.step-dot {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #eee;
  color: #aaa;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.step-dot.on {
  background: var(--color-primary);
  color: #fff;
}

.step-bar {
  width: 80rpx;
  height: 4rpx;
  background: #eee;
}

.step-bar.on {
  background: var(--color-primary);
}

.wizard-title {
  font-size: 40rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.wizard-sub {
  font-size: 26rpx;
  color: var(--color-text-light);
  line-height: 1.6;
  margin-bottom: 32rpx;
}

/* 底部固定操作栏，给内容留出等高的空位 */
.wizard-spacer {
  height: 160rpx;
}

.wizard-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 20rpx;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid #eee;
}

.wizard-btn {
  flex: 1;
  margin: 0;
}

/* ---------- 二选一大卡片 ---------- */
.pick {
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
  padding: 32rpx 28rpx;
  border: 2rpx solid #eee;
  border-radius: 16rpx;
  background: #fff;
  margin-bottom: 20rpx;
}

.pick-on {
  border-color: var(--color-primary);
  background: #fdf7f8;
}

.pick-sm {
  padding: 24rpx 28rpx;
}

.pick-emoji {
  font-size: 48rpx;
  line-height: 1.2;
}

.pick-body {
  flex: 1;
  min-width: 0;
}

.pick-name {
  font-size: 30rpx;
  font-weight: bold;
}

.pick-desc {
  font-size: 24rpx;
  color: var(--color-text-light);
  line-height: 1.6;
  margin-top: 6rpx;
}

/* ---------- 表单件（与 shopedit 保持一致的观感）---------- */
.form-card {
  padding: 24rpx;
  font-size: 30rpx;
}

.picker-row {
  display: flex;
  align-items: center;
}

.picker-row .placeholder {
  color: #999;
}

.picker-arrow {
  margin-left: auto;
  color: #ccc;
  font-size: 36rpx;
}

.logo-row,
.license-row {
  display: flex;
  align-items: center;
  padding: 24rpx;
  gap: 24rpx;
}

.logo-img,
.license-img {
  width: 140rpx;
  height: 140rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
}

.logo-placeholder,
.license-placeholder {
  border: 2rpx dashed #ccc;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #999;
  font-size: 56rpx;
}

.logo-hint,
.license-hint {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
}

.license-hint .text-light,
.logo-hint .text-light {
  font-size: 24rpx;
  line-height: 1.5;
  margin-top: 6rpx;
}

.agree-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  margin-top: 32rpx;
}

.agree-label {
  display: flex;
  align-items: center;
}

.agree-text {
  font-size: 26rpx;
  color: #555;
}

.agree-link {
  font-size: 26rpx;
  color: var(--color-primary);
}
