<!--pages/publishselect/publishselect.wxml-->
<view class="page-container">
  <view style="font-size: 44rpx; font-weight: bold; margin-bottom: 8rpx;">发布</view>

  <!-- 发布闲置 -->
  <view bindtap="publishItem" class="card" style="display: flex; align-items: center; padding: 32rpx;">
    <view style="font-size: 44rpx; width: 88rpx; height: 88rpx; background: #f5f5f5; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin-right: 24rpx;">♻️</view>
    <view style="flex: 1;">
      <view style="font-size: 32rpx; font-weight: bold;">发布闲置</view>
      <view class="text-light">闲置变现金，几步搞定</view>
    </view>
    <view style="color: #ccc; font-size: 40rpx;">›</view>
  </view>

  <!-- 发布转租 -->
  <view bindtap="publishSublet" class="card" style="display: flex; align-items: center; padding: 32rpx;">
    <view style="font-size: 44rpx; width: 88rpx; height: 88rpx; background: #f5f5f5; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin-right: 24rpx;">🏠</view>
    <view style="flex: 1;">
      <view style="font-size: 32rpx; font-weight: bold;">发布转租</view>
      <view class="text-light">找到下一位租客</view>
    </view>
    <view style="color: #ccc; font-size: 40rpx;">›</view>
  </view>

  <!-- 发布委托 -->
  <view bindtap="publishTask" class="card" style="display: flex; align-items: center; padding: 32rpx;">
    <view style="font-size: 44rpx; width: 88rpx; height: 88rpx; background: #f5f5f5; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin-right: 24rpx;">🙋</view>
    <view style="flex: 1;">
      <view style="font-size: 32rpx; font-weight: bold;">发布委托</view>
      <view class="text-light">求购物品/找人帮忙</view>
    </view>
    <view style="color: #ccc; font-size: 40rpx;">›</view>
  </view>
</view>