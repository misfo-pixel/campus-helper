<wxs src="/i18n/i18n.wxs" module="i18n" />
<skeleton wx:if="{{loading}}" type="form" />
<view wx:if="{{!loading}}" class="page-container">
  <view class="role-hint">
    {{as === 'shop' ? i18n.t('你是店长：买家把配送费一起付给了你，这些钱要结给配送队。', lang) : i18n.t('你是配送队：这些配送费由店长代收，需要向店长结算。', lang)}}
  </view>

  <!-- 待结算 -->
  <view class="section-title">{{i18n.t('待结算', lang)}}</view>
  <view wx:if="{{groups.length === 0}}" class="text-light empty">
    {{i18n.t('没有待结算的配送费。订单完成后会自动累计到这里。', lang)}}
  </view>

  <view wx:for="{{groups}}" wx:key="id" class="card group">
    <view class="group-head">
      <view class="group-name">{{item.name}}</view>
      <view class="group-amount">${{item.amount}}</view>
    </view>
    <view class="text-light group-sub">{{i18n.f('{0} 单', lang, item.count)}}</view>

    <!-- 店长侧显示队伍的收款方式，方便直接转 -->
    <view wx:if="{{as === 'shop' && item.payment_note}}" class="pay-line">
      <text class="text-light">{{i18n.t('收款方式：', lang)}}</text>
      <text class="pay-note">{{item.payment_note}}</text>
      <text class="pay-copy" bindtap="copyText" data-text="{{item.payment_note}}">{{i18n.t('复制', lang)}}</text>
    </view>
    <view wx:if="{{as === 'shop' && item.contact_wechat}}" class="pay-line">
      <text class="text-light">{{i18n.t('队长微信：', lang)}}</text>
      <text class="pay-note">{{item.contact_wechat}}</text>
      <text class="pay-copy" bindtap="copyText" data-text="{{item.contact_wechat}}">{{i18n.t('复制', lang)}}</text>
    </view>

    <button class="btn-primary group-btn btn-sm" bindtap="createBill"
            data-id="{{item.id}}" data-name="{{item.name}}"
            data-amount="{{item.amount}}" data-count="{{item.count}}">{{i18n.t('发起对账', lang)}}</button>
  </view>

  <!-- 历史账单 -->
  <view class="section-title">{{i18n.t('账单记录', lang)}}</view>
  <view wx:if="{{settlements.length === 0}}" class="text-light empty-small">{{i18n.t('还没有账单', lang)}}</view>

  <view wx:for="{{settlements}}" wx:key="_id" class="card bill">
    <view class="bill-head">
      <view class="bill-name">{{as === 'shop' ? item.team_name : item.shop_name}}</view>
      <view class="bill-status bill-{{item.status}}">{{item.statusText}}</view>
    </view>

    <view class="bill-row">
      <text class="bill-amount">${{item.amount}}</text>
      <text class="text-light bill-meta">{{i18n.f('{0} 单 · {1} ~ {2}', lang, item.order_count, item.period_from, item.period_to)}}</text>
    </view>

    <view wx:if="{{as === 'shop' && item.status === 'pending' && item.team_payment_note}}" class="pay-line">
      <text class="text-light">{{i18n.t('转到：', lang)}}</text>
      <text class="pay-note">{{item.team_payment_note}}</text>
      <text class="pay-copy" bindtap="copyText" data-text="{{item.team_payment_note}}">{{i18n.t('复制', lang)}}</text>
    </view>

    <view class="bill-actions">
      <!-- 店长：还没转账时可以标记已转 -->
      <button wx:if="{{as === 'shop' && item.status === 'pending'}}" class="btn-primary btn-sm"
              bindtap="markPaid" data-id="{{item._id}}">{{i18n.t('我已转账', lang)}}</button>

      <!-- 配送队：店长转了之后确认收款 -->
      <button wx:if="{{as === 'team' && item.status === 'paid'}}" class="btn-primary btn-sm"
              bindtap="confirmReceived" data-id="{{item._id}}">{{i18n.t('确认收到', lang)}}</button>

      <!-- 队伍等店长转账时的提示 -->
      <text wx:if="{{as === 'team' && item.status === 'pending'}}" class="text-light bill-wait">{{i18n.t('等店长转账', lang)}}</text>
      <text wx:if="{{as === 'shop' && item.status === 'paid'}}" class="text-light bill-wait">{{i18n.t('等队伍确认', lang)}}</text>

      <text wx:if="{{item.status !== 'settled'}}" class="bill-cancel"
            bindtap="cancelBill" data-id="{{item._id}}">{{i18n.t('撤回', lang)}}</text>
    </view>
  </view>
</view>
