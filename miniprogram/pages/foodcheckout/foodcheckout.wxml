<view wx:if="{{cart && !loading}}" class="page-container">
  <view class="page-title">确认订单</view>

  <!-- 商品清单 -->
  <view class="card order-card">
    <view class="shop-name">{{cart.shopName}}</view>
    <view wx:for="{{cart.items}}" wx:key="item_id" class="line">
      <text class="line-name">{{item.name}}</text>
      <text class="line-count">×{{item.count}}</text>
      <text class="line-price">${{item.lineTotal}}</text>
    </view>

    <view class="divider"></view>
    <view class="line">
      <text class="line-name">小计</text>
      <text class="line-price">${{cart.subtotal}}</text>
    </view>
    <view class="line">
      <text class="line-name">配送费{{pointIndex === null ? '（选服务地点后计算）' : ''}}</text>
      <text class="line-price">${{deliveryFee}}</text>
    </view>
    <view class="line line-total">
      <text class="line-name">合计</text>
      <text class="line-price">${{total}}</text>
    </view>
  </view>

  <view class="section-title">服务地点</view>
  <view class="field-hint">到服务地点自取，不送到公寓门口。不同点位的配送费不一样。</view>

  <picker mode="selector" range="{{pointLabels}}" value="{{pointIndex}}" bindchange="onPointChange">
    <view class="card picker-row">
      <text class="{{pointIndex === null ? 'placeholder' : ''}}">
        {{pointIndex === null ? '选择服务地点（必填）' : pointLabels[pointIndex]}}
      </text>
      <text class="picker-arrow">›</text>
    </view>
  </picker>

  <input placeholder="你的微信号（必填，商家和配送员联系用）" value="{{contact_wechat}}" bindinput="onInput" data-field="contact_wechat" class="card" style="padding: 24rpx;" />

  <view class="section-title">服务时间</view>
  <view class="field-hint">同一时段一趟送多单，配送费因此更便宜，请按时到服务地点。</view>

  <picker mode="selector" range="{{batchLabels}}" value="{{batchIndex}}" bindchange="onBatchChange">
    <view class="card picker-row">
      <text>{{batchLabels[batchIndex]}}</text>
      <text class="picker-arrow">›</text>
    </view>
  </picker>

  <textarea placeholder="备注（规格、特殊要求等）" value="{{note}}" bindinput="onInput" data-field="note" class="card" style="padding: 24rpx; width: auto; height: 140rpx; margin-top: 24rpx;"></textarea>

  <!-- 平台只记录下单意向：不展示收款方式，不出现任何支付指引 -->
  <view class="field-hint" style="margin-top: 24rpx;">提交后商家会在工作台看到这笔订单，并通过微信与你联系确认。平台只记录下单意向，不参与交易。</view>

  <disclaimer-bar type="buyer" />

  <button class="btn-primary" bindtap="submit" loading="{{submitting}}" style="margin-top: 24rpx;">
    提交订单
  </button>
</view>
