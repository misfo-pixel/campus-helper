.order-card {
  padding: 28rpx;
}

.shop-name {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
}

.line {
  display: flex;
  align-items: baseline;
  font-size: 28rpx;
  line-height: 2;
}

.line-name {
  flex: 1;
}

.line-count {
  color: var(--color-text-light);
  margin-right: 24rpx;
}

.line-price {
  font-variant-numeric: tabular-nums;
}

.divider {
  height: 1rpx;
  background: var(--color-border);
  margin: 16rpx 0;
}

.line-total {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--color-primary);
}

/* 付款说明 */
.pay-box {
  background: #f5f8ff;
  border: 1rpx solid #d6e2f7;
  border-radius: 12rpx;
  padding: 28rpx;
}

.pay-note {
  font-size: 32rpx;
  font-weight: bold;
  color: #2b4a7d;
  margin-bottom: 16rpx;
  word-break: break-all;
}

.pay-desc {
  font-size: 26rpx;
  line-height: 1.7;
  color: #4a5a75;
}

.pay-amount {
  font-weight: bold;
  color: var(--color-primary);
}

.pay-warn {
  font-size: 24rpx;
  line-height: 1.7;
  color: #8a8a8a;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #d6e2f7;
}

.picker-row {
  display: flex;
  align-items: center;
  padding: 24rpx;
  font-size: 28rpx;
}

.picker-row .placeholder {
  color: #999;
}

.picker-arrow {
  margin-left: auto;
  color: #ccc;
  font-size: 36rpx;
}

