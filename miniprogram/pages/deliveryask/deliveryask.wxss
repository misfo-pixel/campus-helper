.wizard-title {
  font-size: 40rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.wizard-sub {
  font-size: 26rpx;
  color: var(--color-text-light);
  line-height: 1.6;
  margin-bottom: 16rpx;
}

/* 和开店向导里的二选一卡片同一套观感 */
.pick {
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
  padding: 28rpx;
  border: 2rpx solid #eee;
  border-radius: 16rpx;
  background: #fff;
  margin-bottom: 20rpx;
}

.pick-on {
  border-color: var(--color-primary);
  background: #fdf7f8;
}

.pick-emoji {
  font-size: 44rpx;
  line-height: 1.2;
}

.pick-body {
  flex: 1;
  min-width: 0;
}

.pick-name {
  font-size: 30rpx;
  font-weight: bold;
}

.pick-desc {
  font-size: 24rpx;
  color: var(--color-text-light);
  line-height: 1.6;
  margin-top: 6rpx;
}

/* 可配送时段：一个时段一个小标签，换行排。
   用标签而不是一行逗号隔开，是因为「9-19 周六 18:00-20:00」本身就有三段，
   连着写成一串的话，店长得逐字断句才看得出哪到哪是一个时段。 */
.pick-slots {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 12rpx;
}

.pick-slot {
  font-size: 22rpx;
  color: var(--color-primary);
  background: #fdf0f2;
  border-radius: 6rpx;
  padding: 6rpx 12rpx;
}

.pick-slot-more {
  font-size: 22rpx;
  color: var(--color-text-light);
  padding: 6rpx 0;
}

.pick-slots-none {
  font-size: 22rpx;
  color: var(--color-text-light);
  margin-top: 12rpx;
}

.note-box {
  width: auto;
  height: 180rpx;
  padding: 24rpx;
  font-size: 28rpx;
}

/* ---------- 配送记录 ---------- */
.req {
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.req-head {
  display: flex;
  align-items: baseline;
}

.req-team {
  font-size: 30rpx;
  font-weight: bold;
}

.req-status {
  margin-left: auto;
  font-size: 22rpx;
  border-radius: 6rpx;
  padding: 4rpx 14rpx;
  background: #f2f2f2;
  color: #888;
}

.req-status-accepted {
  background: #fff6e5;
  color: #b8860b;
}

.req-status-delivered {
  background: #eaf6ec;
  color: #3a7d44;
}

.req-time {
  font-size: 22rpx;
  margin-top: 6rpx;
}

.req-note {
  line-height: 1.6;
  white-space: pre-wrap;
  word-break: break-word;
  margin-top: 12rpx;
}

.req-done {
  font-size: 24rpx;
  color: #3a7d44;
  margin-top: 16rpx;
}

.req-photos {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 12rpx;
}

.req-photo {
  width: 180rpx;
  height: 180rpx;
  border-radius: 12rpx;
  background: #f2f2f2;
}
