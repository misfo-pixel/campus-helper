.wizard-title {
  font-size: 40rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.wizard-sub {
  font-size: 26rpx;
  color: var(--color-text-light);
  line-height: 1.6;
  margin-bottom: 16rpx;
}

/* 和开店向导里的二选一卡片同一套观感 */
.pick {
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
  padding: 28rpx;
  border: 2rpx solid #eee;
  border-radius: 16rpx;
  background: #fff;
  margin-bottom: 20rpx;
}

.pick-on {
  border-color: var(--color-primary);
  background: #fdf7f8;
}

.pick-emoji {
  font-size: 44rpx;
  line-height: 1.2;
}

.pick-body {
  flex: 1;
  min-width: 0;
}

.pick-name {
  font-size: 30rpx;
  font-weight: bold;
}

.pick-desc {
  font-size: 24rpx;
  color: var(--color-text-light);
  line-height: 1.6;
  margin-top: 6rpx;
}

.note-box {
  width: auto;
  height: 180rpx;
  padding: 24rpx;
  font-size: 28rpx;
}

/* ---------- 配送记录 ---------- */
.req {
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.req-head {
  display: flex;
  align-items: baseline;
}

.req-team {
  font-size: 30rpx;
  font-weight: bold;
}

.req-status {
  margin-left: auto;
  font-size: 22rpx;
  border-radius: 6rpx;
  padding: 4rpx 14rpx;
  background: #f2f2f2;
  color: #888;
}

.req-status-accepted {
  background: #fff6e5;
  color: #b8860b;
}

.req-status-delivered {
  background: #eaf6ec;
  color: #3a7d44;
}

.req-status-no_show {
  background: #fdecee;
  color: #C8102E;
}

.req-ops {
  display: flex;
  justify-content: flex-end;
  gap: 40rpx;
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--color-border);
}

.req-op {
  font-size: 24rpx;
  color: var(--color-text-light);
}

.req-op-bad {
  color: #C8102E;
  font-weight: 700;
}

/* 队伍靠不靠谱：送达几单、爽约几次 */
.pick-rep {
  font-size: 22rpx;
  color: #3a7d44;
  margin-top: 8rpx;
}

.pick-rep-bad {
  color: #C8102E;
}

.req-time {
  font-size: 22rpx;
  margin-top: 6rpx;
}

.req-note {
  line-height: 1.6;
  white-space: pre-wrap;
  word-break: break-word;
  margin-top: 12rpx;
}

.req-done {
  font-size: 24rpx;
  color: #3a7d44;
  margin-top: 16rpx;
}

.req-photos {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 12rpx;
}

.req-photo {
  width: 180rpx;
  height: 180rpx;
  border-radius: 12rpx;
  background: #f2f2f2;
}

/* ---------- 页头 ---------- */
.ask-hero {
  padding: 40rpx 36rpx 36rpx;
}

.ask-hero .hero-sub {
  line-height: 1.6;
  position: relative;
  z-index: 1;
}

.ask-off {
  line-height: 1.6;
}

.ask-link {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--color-primary);
}

.ask-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

/* 送上门 / 送到取货点。工作台卡片上是同一个标签 */
.ask-tag {
  flex-shrink: 0;
  font-size: 22rpx;
  font-weight: 700;
  color: var(--color-primary);
  background: var(--color-accent);
  border-radius: 999rpx;
  padding: 4rpx 16rpx;
}

/* ---------- 送哪、几单 ---------- */
.lines {
  padding: 8rpx 28rpx 24rpx;
}

.line {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}

.line-name {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 600;
}

.line-fee {
  margin-left: 12rpx;
  font-size: 24rpx;
  font-weight: normal;
  color: var(--color-text-light);
}

.line-count {
  width: 120rpx;
  height: 64rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 700;
  background: var(--color-bg);
  border-radius: 12rpx;
}

.line-unit {
  font-size: 26rpx;
  color: var(--color-text-light);
}

.line-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 20rpx;
}

.line-total {
  font-size: 36rpx;
  font-weight: 800;
  color: var(--color-primary);
}

.line-warn {
  margin-top: 16rpx;
  padding: 14rpx 20rpx;
  border-radius: 12rpx;
  background: #fdecee;
  color: #C8102E;
  font-size: 24rpx;
  line-height: 1.6;
}

/* ---------- 记录里的价格行 ---------- */
.req-price {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 12rpx;
}

.req-price-detail {
  font-size: 26rpx;
}

.req-price-total {
  margin-left: auto;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-primary);
}
