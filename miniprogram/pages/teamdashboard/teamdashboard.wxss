.empty-box {
  text-align: center;
  padding: 120rpx 40rpx;
}

.empty-emoji {
  font-size: 100rpx;
}

.empty-title {
  font-size: 36rpx;
  font-weight: bold;
  margin: 24rpx 0 12rpx;
}

.empty-desc {
  font-size: 28rpx;
  line-height: 1.6;
}

.empty {
  text-align: center;
  margin-top: 120rpx;
  line-height: 1.6;
}

.team-head {
  display: flex;
  align-items: center;
  padding: 28rpx;
}

.team-meta {
  flex: 1;
}

.team-name {
  font-size: 34rpx;
  font-weight: bold;
}

.team-set {
  font-size: 26rpx;
  color: var(--color-text-light);
  margin-left: 24rpx;
}

.batch {
  margin-top: 32rpx;
}

.batch-head {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.batch-label {
  font-size: 32rpx;
  font-weight: bold;
}

.batch-time {
  font-size: 24rpx;
}

.shop-row {
  display: flex;
  align-items: center;
  padding: 24rpx;
  gap: 16rpx;
}

.shop-meta {
  flex: 1;
  min-width: 0;
}

.shop-name {
  font-size: 30rpx;
  font-weight: bold;
}

.shop-sub {
  font-size: 24rpx;
  margin-top: 4rpx;
}

.shop-taken {
  font-size: 26rpx;
}

/* ---------- 配送请求收件箱 ---------- */
.req {
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.req-head {
  display: flex;
  align-items: baseline;
  margin-bottom: 12rpx;
}

.req-shop {
  font-size: 30rpx;
  font-weight: bold;
}

.req-time {
  margin-left: auto;
  font-size: 22rpx;
  color: #bbb;
}

/* 店长填的说明可能是多行的，保住换行 */
.req-note {
  line-height: 1.6;
  white-space: pre-wrap;
  word-break: break-word;
}

.req-contact {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 16rpx;
}

.req-copy {
  font-size: 24rpx;
  color: var(--color-primary);
}

.req-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 20rpx;
}

.req-status {
  margin-left: auto;
  font-size: 22rpx;
  border-radius: 6rpx;
  padding: 4rpx 14rpx;
  background: #f2f2f2;
  color: #888;
}

.req-status-accepted {
  background: #fff6e5;
  color: #b8860b;
}

.req-status-delivered {
  background: #eaf6ec;
  color: #3a7d44;
}

/* 送达照片 */
.req-photos {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.req-photo {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  background: #f2f2f2;
}

/* ---------- 可配送时段 ---------- */
.slots {
  padding: 24rpx 28rpx;
  margin-bottom: 24rpx;
}

.slots-head {
  display: flex;
  align-items: center;
}

.slots-title {
  font-size: 30rpx;
  font-weight: bold;
}

.slots-add {
  margin-left: auto;
  font-size: 26rpx;
  color: var(--color-primary);
}

.slots-desc {
  margin-top: 6rpx;
  line-height: 1.5;
}

.slots-empty {
  margin-top: 16rpx;
  line-height: 1.6;
}

/* 一行就是一个时段：日期 + 起 - 止 + 删除。
   三个选择器挤在一行是故意的——队长改的是「这一天的这一段」，
   拆成三行反而看不出它们是一条。 */
.slot-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--color-border);
}

.slot-pick {
  font-size: 26rpx;
  color: #555;
  background: #f5f5f5;
  padding: 10rpx 16rpx;
  border-radius: 8rpx;
}

.slot-date {
  min-width: 160rpx;
  text-align: center;
}

.slot-dash {
  font-size: 26rpx;
  color: var(--color-text-light);
}

.slot-del {
  margin-left: auto;
  font-size: 24rpx;
  color: #C8102E;
  flex-shrink: 0;
}

/* 队员只能看，一整行就是一句话 */
.slot-readonly {
  font-size: 28rpx;
}
