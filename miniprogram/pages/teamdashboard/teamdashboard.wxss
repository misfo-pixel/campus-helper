.empty-box {
  text-align: center;
  padding: 120rpx 40rpx;
}

.empty-emoji {
  font-size: 100rpx;
}

.empty-title {
  font-size: 36rpx;
  font-weight: bold;
  margin: 24rpx 0 12rpx;
}

.empty {
  text-align: center;
  margin-top: 120rpx;
  line-height: 1.6;
}

/* ---------- 队头 ---------- */
.head {
  padding: 36rpx 32rpx 32rpx;
}

.head-top {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.head-name {
  font-size: 40rpx;
  font-weight: 700;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.head-role {
  flex-shrink: 0;
  font-size: 22rpx;
  font-weight: 700;
  color: var(--color-primary);
  background: var(--color-accent);
  border-radius: 999rpx;
  padding: 4rpx 16rpx;
}

.head-icons {
  margin-left: auto;
  display: flex;
  gap: 16rpx;
  flex-shrink: 0;
}

.head-chip {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
}

.head-chip:active {
  opacity: .8;
}

.head-ico {
  width: 44rpx;
  height: 44rpx;
}

.head-stats {
  position: relative;
  z-index: 1;
  display: flex;
  margin-top: 32rpx;
}

.head-stat {
  flex: 1;
}

.head-stat + .head-stat {
  border-left: 1rpx solid rgba(255, 255, 255, .2);
  padding-left: 28rpx;
}

.head-num {
  font-size: 52rpx;
  font-weight: 800;
  line-height: 1.1;
}

.head-num-hot {
  color: var(--color-accent);
}

.head-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, .78);
  margin-top: 4rpx;
}

/* ---------- 被下架 ---------- */
.takedown {
  padding: 24rpx 28rpx;
  margin-bottom: 8rpx;
  border-radius: var(--radius);
  background: #4a4a4a;
  color: #fff;
}

.takedown-title {
  font-size: 30rpx;
  font-weight: 700;
}

.takedown-desc {
  margin-top: 6rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: rgba(255, 255, 255, .8);
}

/* ---------- 分节 ---------- */
.block-empty {
  text-align: center;
  padding: 48rpx 28rpx;
}

/* ---------- 待处理 ---------- */
.req {
  padding: 28rpx;
  border-left: 8rpx solid var(--color-border);
}

/* 左边一道色条区分「该我联系了」和「已经在送」 */
.req-open {
  border-left-color: var(--color-accent);
}

.req-accepted {
  border-left-color: var(--color-primary);
}

.req-head {
  display: flex;
  align-items: center;
}

.req-shop {
  font-size: 32rpx;
  font-weight: 700;
}

.req-status {
  margin-left: auto;
  flex-shrink: 0;
  font-size: 22rpx;
  border-radius: 999rpx;
  padding: 4rpx 16rpx;
  background: #f2f2f2;
  color: #888;
}

.req-status-open {
  background: #fff4d1;
  color: #8a6100;
}

.req-status-accepted {
  background: rgba(122, 0, 25, .08);
  color: var(--color-primary);
}

.req-status-delivered {
  background: #eaf6ec;
  color: #3a7d44;
}

.req-status-no_show {
  background: #fdecee;
  color: #C8102E;
}

.req-time {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: var(--color-text-light);
}

/* 群发的单子别的队也看得到，提醒一句要抢 */
.req-race {
  margin-left: 12rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: var(--color-primary);
}

/* 送哪、几单、合计。合计放大，接不接主要看它 */
.req-price {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  background: #fdf7f8;
}

.req-tag {
  flex-shrink: 0;
  font-size: 22rpx;
  font-weight: 700;
  color: var(--color-primary);
  background: var(--color-accent);
  border-radius: 999rpx;
  padding: 4rpx 16rpx;
}

.req-price-detail {
  font-size: 26rpx;
}

.req-price-total {
  margin-left: auto;
  font-size: 34rpx;
  font-weight: 800;
  color: var(--color-primary);
}

/* 店长填的说明可能是多行的，保住换行 */
.req-note {
  margin-top: 16rpx;
  line-height: 1.6;
  white-space: pre-wrap;
  word-break: break-word;
}

.req-contact {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 20rpx;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  background: var(--color-bg);
}

.req-wechat-label {
  flex-shrink: 0;
  font-size: 24rpx;
  color: var(--color-text-light);
}

.req-wechat {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  word-break: break-all;
}

.req-copy {
  flex-shrink: 0;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--color-primary);
}

.req-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 32rpx;
  margin-top: 24rpx;
}

.req-decline {
  font-size: 26rpx;
  color: var(--color-text-light);
  padding: 12rpx 8rpx;
}

/* ---------- 历史 ---------- */
.history {
  padding: 0 28rpx;
}

.his-row {
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}

.his-head {
  display: flex;
  align-items: center;
}

.his-shop {
  font-size: 28rpx;
  font-weight: 700;
}

.his-time {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--color-text-light);
}

.his-note {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #555;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.his-photos {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.his-photo {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  background: #f2f2f2;
}

.his-more {
  padding: 24rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: var(--color-primary);
}

.his-row:last-child {
  border-bottom: none;
}
