.empty-box {
  text-align: center;
  padding: 120rpx 40rpx;
}

.empty-emoji {
  font-size: 100rpx;
}

.empty-title {
  font-size: 36rpx;
  font-weight: bold;
  margin: 24rpx 0 12rpx;
}

.empty-desc {
  font-size: 28rpx;
  line-height: 1.6;
}

.empty {
  text-align: center;
  margin-top: 120rpx;
  line-height: 1.6;
}

.team-head {
  display: flex;
  align-items: center;
  padding: 28rpx;
}

.team-meta {
  flex: 1;
}

.team-name {
  font-size: 34rpx;
  font-weight: bold;
}

.team-set {
  font-size: 26rpx;
  color: var(--color-text-light);
  margin-left: 24rpx;
}

.audit-box {
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.audit-pending {
  background: #fff8e6;
  border: 1rpx solid #f0e0b8;
}

.audit-rejected {
  background: #fff2f2;
  border: 1rpx solid #f5c6c6;
}

.audit-title {
  font-size: 28rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.audit-desc {
  font-size: 26rpx;
  line-height: 1.6;
  color: #666;
}

.batch {
  margin-top: 32rpx;
}

.batch-head {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.batch-label {
  font-size: 32rpx;
  font-weight: bold;
}

.batch-time {
  font-size: 24rpx;
}

.shop-row {
  display: flex;
  align-items: center;
  padding: 24rpx;
  gap: 16rpx;
}

.shop-meta {
  flex: 1;
  min-width: 0;
}

.shop-name {
  font-size: 30rpx;
  font-weight: bold;
}

.shop-sub {
  font-size: 24rpx;
  margin-top: 4rpx;
}

.shop-taken {
  font-size: 26rpx;
}
