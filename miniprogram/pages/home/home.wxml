<view class="page-container">
  <view style="font-size: 44rpx; font-weight: bold; margin-bottom: 8rpx;">👋 明尼生活，一站搞定</view>
  <!-- 二手市场 -->
  <view bindtap="goToMarket" class="card" style="display: flex; align-items: center; padding: 32rpx;">
    <view style="font-size: 44rpx; width: 88rpx; height: 88rpx; background: #f5f5f5; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin-right: 24rpx;">♻️</view>
    <view style="flex: 1;">
      <view style="font-size: 32rpx; font-weight: bold;">二手市场</view>
      <view class="text-light">低价淘，轻松出</view>
    </view>
    <view style="color: #ccc; font-size: 40rpx;">›</view>
  </view>

  <!-- 公寓转租 -->
  <view bindtap="goToSublet" class="card" style="display: flex; align-items: center; padding: 32rpx;">
    <view style="font-size: 44rpx; width: 88rpx; height: 88rpx; background: #f5f5f5; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin-right: 24rpx;">🏠</view>
    <view style="flex: 1;">
      <view style="font-size: 32rpx; font-weight: bold;">公寓转租</view>
      <view class="text-light">找房、转租、找室友</view>
    </view>
    <view style="color: #ccc; font-size: 40rpx;">›</view>
  </view>

  <!-- 任务委托 -->
  <view bindtap="goToTask" class="card" style="display: flex; align-items: center; padding: 32rpx;">
    <view style="font-size: 44rpx; width: 88rpx; height: 88rpx; background: #f5f5f5; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin-right: 24rpx;">🙋</view>
    <view style="flex: 1;">
      <view style="font-size: 32rpx; font-weight: bold;">任务委托</view>
      <view class="text-light">代取、代购、跑腿都行</view>
    </view>
    <view style="color: #ccc; font-size: 40rpx;">›</view>
  </view>

  <!-- 校外服务（店长自营小店）：由 config.js 的 SHOP_MODULE_ENABLED 控制 -->
  <view wx:if="{{shopEnabled}}" bindtap="goToShops" class="card" style="display: flex; align-items: center; padding: 32rpx;">
    <view style="font-size: 44rpx; width: 88rpx; height: 88rpx; background: #f5f5f5; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin-right: 24rpx;">🏪</view>
    <view style="flex: 1;">
      <view style="font-size: 32rpx; font-weight: bold;">校外服务</view>
      <view class="text-light">校外的小店与服务，都在这儿</view>
    </view>
    <view style="color: #ccc; font-size: 40rpx;">›</view>
  </view>

  <!-- 意见反馈 -->
  <view bindtap="goToFeedback" class="card" style="display: flex; align-items: center; padding: 32rpx;">
    <view style="font-size: 44rpx; width: 88rpx; height: 88rpx; background: #f5f5f5; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin-right: 24rpx;">💬</view>
    <view style="flex: 1;">
      <view style="font-size: 32rpx; font-weight: bold;">意见反馈</view>
      <view class="text-light">遇到问题 / 建议？欢迎给我们留言</view>
    </view>
    <view style="color: #ccc; font-size: 40rpx;">›</view>
  </view>
</view>