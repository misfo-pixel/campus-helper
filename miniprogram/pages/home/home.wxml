<view class="page-container">
  <!-- 潜鸟 + 广告语整条是图：广告语用的展示字体小程序加载不了。源文件 posters/home/header.html -->
  <image src="/images/home-header.png" mode="widthFix" class="home-header"></image>

  <!-- 活动横幅：config.js 的 HOME_BANNERS，按日期自动上下架 -->
  <image wx:if="{{banner}}" src="{{banner.image}}" mode="aspectFill" bindtap="onTapBanner" class="home-banner"></image>

  <!-- 入口格，哪些模块显示由 config.js 的开关决定（见 home.js 的 TILES） -->
  <view class="tile-grid">
    <view wx:for="{{tiles}}" wx:key="key" bindtap="onTapTile" data-url="{{item.url}}"
          class="tile {{item.wide ? 'tile-wide' : ''}}">
      <view wx:if="{{item.sticker}}" class="tile-sticker">{{item.sticker}}</view>
      <view class="icon-box {{item.color ? 'tint-' + item.color : ''}}"><image src="/images/modules/{{item.key}}.svg"></image></view>
      <view>
        <view class="tile-title">{{item.title}}</view>
        <view class="tile-sub">{{item.sub}}</view>
      </view>
    </view>
  </view>

  <!-- 特别感谢（赞助商）：数据在 sponsors 集合，config.js 的 SPONSORS_ENABLED 控制 -->
  <block wx:if="{{sponsorsEnabled}}">
    <!-- 「赞助」小标签别删：收了钱的展示要让人看得出是商业推广（《互联网广告管理办法》），
         光写「特别感谢」看不出来 -->
    <view class="sponsor-title">特别感谢<text class="sponsor-tag">赞助</text></view>
    <scroll-view scroll-x enhanced show-scrollbar="{{false}}" class="sponsor-row">
      <view wx:for="{{sponsors}}" wx:key="_id" bindtap="onTapSponsor" data-link="{{item.link}}" class="sponsor">
        <image src="{{item.logo}}" mode="aspectFill" class="sponsor-logo"></image>
        <view class="sponsor-name">{{item.name}}</view>
      </view>
      <view bindtap="onTapSponsorSlot" class="sponsor">
        <view class="sponsor-logo sponsor-slot">+</view>
        <view class="sponsor-name">等你加入</view>
      </view>
    </scroll-view>
  </block>
</view>
