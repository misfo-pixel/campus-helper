<!--index.wxml-->
<view class="page-container">
  <view class="page-title">今天吃点什么 🍱</view>

  <view class="section-title">今日放单</view>
  <view wx:for="{{offers}}" wx:key="_id" class="card">
    <view>餐厅：{{item.restaurant_name}}</view>
    <view>日期：{{item.delivery_date}}</view>
    <view>状态：{{item.status}}</view>
  </view>

  <view class="section-title">菜单</view>
  <view wx:for="{{menuItems}}" wx:key="_id" class="card" style="display: flex; justify-content: space-between; align-items: center;">
    <view>{{item.name}}</view>
    <view style="display: flex; align-items: center;">
      <view class="price" style="margin-right: 20rpx;">${{item.price_after_tax}}</view>
      <button size="mini" class="btn-primary" bindtap="openOrderForm" data-item="{{item}}">下单</button>
    </view>
  </view>

  <button class="btn-outline" bindtap="goToMyOrders" style="margin-top: 20rpx;">我的订单</button>
  <button wx:if="{{isAdmin}}" class="btn-outline" bindtap="goToAdmin" style="margin-top: 20rpx;">管理员：确认订单</button>
  <button class="btn-outline" bindtap="goToMarket" style="margin-top: 20rpx;">二手市场</button>

<!-- 下单表单弹层 -->
<view wx:if="{{showOrderForm}}" style="position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.5); display: flex; align-items: center; justify-content: center;">
  <view style="background: #fff; width: 600rpx; padding: 40rpx; border-radius: 20rpx;">
    <view style="font-size: 34rpx; font-weight: bold; margin-bottom: 20rpx;">下单：{{selectedItem.name}}</view>
    <view style="color: #07c160; margin-bottom: 30rpx;">${{selectedItem.price_after_tax}}</view>

    <view style="margin-bottom: 20rpx;">取餐名</view>
    <input placeholder="请输入取餐名" value="{{pickupName}}" bindinput="onPickupNameInput" style="border: 1rpx solid #ddd; border-radius: 8rpx; padding: 16rpx; margin-bottom: 30rpx;" />

    <view style="margin-bottom: 20rpx;">送餐楼栋</view>
    <picker mode="selector" range="{{buildings}}" value="{{buildingIndex}}" bindchange="onBuildingChange">
      <view style="border: 1rpx solid #ddd; border-radius: 8rpx; padding: 16rpx; margin-bottom: 30rpx; color: {{buildingIndex === null ? '#999' : '#000'}};">
        {{buildingIndex === null ? '请选择楼栋' : buildings[buildingIndex]}}
      </view>
    </picker>

    <view style="display: flex; justify-content: space-between; margin-top: 20rpx;">
      <button size="mini" bindtap="closeOrderForm">取消</button>
      <button size="mini" bindtap="submitOrder" style="background: #07c160; color: white;">确认下单</button>
    </view>
  </view>
</view>
</view>