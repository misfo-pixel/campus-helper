.empty-apply {
  text-align: center;
  padding: 120rpx 40rpx;
}

.empty-emoji {
  font-size: 100rpx;
}

.empty-title {
  font-size: 36rpx;
  font-weight: bold;
  margin: 24rpx 0 12rpx;
}

.empty-desc {
  font-size: 28rpx;
  line-height: 1.6;
}

/* 审核状态 */
.audit-box {
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.audit-pending {
  background: #fff8e6;
  border: 1rpx solid #f0e0b8;
}

.audit-rejected {
  background: #fff2f2;
  border: 1rpx solid #f5c6c6;
}

.audit-title {
  font-size: 28rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.audit-desc {
  font-size: 26rpx;
  line-height: 1.6;
  color: #666;
}

.audit-action {
  font-size: 26rpx;
  color: var(--color-primary);
  margin-top: 12rpx;
}

/* 店头 */
.shop-head {
  display: flex;
  align-items: center;
  padding: 28rpx;
  gap: 20rpx;
}

.shop-logo {
  width: 100rpx;
  height: 100rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
}

.shop-logo-fallback {
  background: #f2f2f2;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
}

.shop-meta {
  flex: 1;
  min-width: 0;
}

.shop-name {
  font-size: 34rpx;
  font-weight: bold;
}

.shop-cat {
  font-size: 24rpx;
  margin-top: 4rpx;
}

.status-pill {
  padding: 10rpx 24rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  flex-shrink: 0;
}

.status-open {
  background: #e8f6ec;
  color: #1a7f37;
}

.status-paused {
  background: #f2f2f2;
  color: #888;
}

.status-closed {
  background: #f2f2f2;
  color: #888;
}

/* 今日数据 */
.summary {
  display: flex;
  padding: 28rpx 0;
}

.summary-cell {
  flex: 1;
  text-align: center;
}

.summary-num {
  font-size: 40rpx;
  font-weight: bold;
}

.summary-hot {
  color: #C8102E;
}

.summary-label {
  font-size: 24rpx;
  margin-top: 4rpx;
}

/* tab */
.tabs {
  display: flex;
  gap: 16rpx;
  margin: 32rpx 0 24rpx;
}

.tab {
  padding: 12rpx 32rpx;
  border-radius: 32rpx;
  background: var(--color-card);
  border: 1rpx solid var(--color-border);
  font-size: 28rpx;
  color: var(--color-text-light);
}

.tab-on {
  background: var(--color-primary);
  border-color: var(--color-primary);
  color: #fff;
}

.empty-orders {
  text-align: center;
  margin: 100rpx 0;
}

/* 订单卡片 */
.order {
  padding: 28rpx;
}

.order-head {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.order-id {
  font-size: 28rpx;
  font-weight: bold;
}

.order-time {
  font-size: 24rpx;
  flex: 1;
}

.order-total {
  font-size: 34rpx;
  font-weight: bold;
  color: var(--color-primary);
}

.order-buyer {
  font-size: 28rpx;
  color: #555;
  margin-bottom: 16rpx;
}

.order-items {
  border-top: 1rpx solid var(--color-border);
  padding-top: 16rpx;
}

.order-product {
  display: flex;
  justify-content: space-between;
  font-size: 28rpx;
  line-height: 1.8;
}

.order-product-count {
  color: var(--color-text-light);
}

.order-note {
  font-size: 26rpx;
  color: #b8860b;
  margin-top: 12rpx;
}

.order-contact {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 16rpx;
  font-size: 26rpx;
}

.order-copy {
  color: var(--color-primary);
}

.order-cancel {
  font-size: 26rpx;
  color: #999;
  margin-top: 12rpx;
}

.order-actions {
  display: flex;
  justify-content: flex-end;
  gap: 20rpx;
  margin-top: 24rpx;
}

.order-done {
  font-size: 26rpx;
}

/* 底部入口 */
.entries {
  display: flex;
  gap: 20rpx;
}

.entry {
  flex: 1;
  text-align: center;
  padding: 32rpx 0;
}

.entry-icon {
  font-size: 44rpx;
}

.entry-label {
  font-size: 28rpx;
  margin-top: 8rpx;
}

/* 买家下单时附的图。工作台一屏要塞很多单，所以给得比买家侧小一号，
   点开是大图，够店长核对款式 */
.order-note-imgs {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 12rpx;
}

.order-note-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 8rpx;
  background: #f7f7f7;
}
