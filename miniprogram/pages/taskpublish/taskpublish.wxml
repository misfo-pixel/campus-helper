<!--pages/taskpublish/taskpublish.wxml-->
<view class="page-container with-submit-bar">
  <view class="page-head">
    <view class="icon-box tint-maroon"><image src="/images/modules/task.svg"></image></view>
    <view class="page-head-text"><view class="page-head-title">发布委托</view></view>
  </view>

  <view class="section-title">任务信息（必填）</view>
  <view class="form-group">
    <input placeholder="任务标题（如 上门保洁、接机送机）" value="{{title}}" bindinput="onInput" data-field="title" class="form-input" />
    <input placeholder="报酬（美元）" type="digit" value="{{reward}}" bindinput="onInput" data-field="reward" class="form-input" />
    <textarea placeholder="任务描述（具体做什么、有什么要求）" value="{{description}}" bindinput="onInput" data-field="description" class="form-textarea"></textarea>
    <input placeholder="你的微信号（接单人联系用）" value="{{contact_wechat}}" bindinput="onInput" data-field="contact_wechat" class="form-input" />
  </view>

  <view class="section-title">补充信息（选填）</view>
  <view class="form-group">
    <picker mode="date" value="{{deadline}}" bindchange="onDeadlineChange">
      <view class="form-row">
        <text class="form-row-label">截止时间</text>
        <text class="form-row-value {{deadline ? '' : 'form-row-empty'}}">{{deadline || '请选择'}}</text>
        <text class="form-row-arrow">›</text>
      </view>
    </picker>
    <input placeholder="地点（如 在哪取 / 送到哪）" value="{{location}}" bindinput="onInput" data-field="location" class="form-input" />
    <view class="uploader">
      <view class="uploader-inner">
        <view wx:for="{{images}}" wx:key="*this" class="uploader-cell">
          <image src="{{item}}" mode="aspectFill" class="uploader-img"></image>
          <view catchtap="removeImage" data-index="{{index}}" class="uploader-del"><view>×</view></view>
        </view>
        <view wx:if="{{images.length < 6}}" bindtap="chooseImages" class="uploader-cell uploader-add">
          <image src="/images/ui/camera.svg"></image>
          <text>{{images.length}}/6</text>
        </view>
      </view>
    </view>
  </view>

  <disclaimer-bar type="publish" />
</view>

<!-- 发布按钮钉在底部（app.wxss 的 .submit-bar），长表单不用滑到底才找得到 -->
<view class="submit-bar">
  <button class="btn-primary" bindtap="submitPublish">发布</button>
</view>
