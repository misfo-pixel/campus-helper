.empty {
  text-align: center;
  margin-top: 120rpx;
}

.order {
  padding: 28rpx;
}

.order-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.order-shop {
  font-size: 32rpx;
  font-weight: bold;
}

.order-status {
  font-size: 24rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

.order-status-pending {
  background: #fff4e0;
  color: #b8860b;
}

.order-status-accepted,
.order-status-delivering {
  background: #e8f0fb;
  color: #2b4a7d;
}

.order-status-completed {
  background: #e8f6ec;
  color: #1a7f37;
}

.order-status-cancelled {
  background: #f2f2f2;
  color: #888;
}

.order-sub {
  font-size: 24rpx;
  margin-top: 6rpx;
}

.order-items {
  border-top: 1rpx solid var(--color-border);
  margin-top: 16rpx;
  padding-top: 16rpx;
}

.order-dish {
  display: flex;
  justify-content: space-between;
  font-size: 28rpx;
  line-height: 1.8;
}

.order-dish-count {
  color: var(--color-text-light);
}

.order-total {
  font-size: 28rpx;
  margin-top: 16rpx;
}

.order-amount {
  font-size: 34rpx;
  font-weight: bold;
  color: var(--color-primary);
}

.order-fee {
  font-size: 24rpx;
}

.order-hint {
  font-size: 26rpx;
  color: #666;
  margin-top: 12rpx;
  line-height: 1.6;
}

.pay-box {
  background: #f5f8ff;
  border: 1rpx solid #d6e2f7;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-top: 16rpx;
}

.pay-label {
  font-size: 24rpx;
  color: #4a5a75;
}

.pay-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 8rpx;
}

.pay-note {
  flex: 1;
  font-size: 30rpx;
  font-weight: bold;
  color: #2b4a7d;
  word-break: break-all;
}

.pay-copy,
.order-copy {
  font-size: 26rpx;
  color: var(--color-primary);
  flex-shrink: 0;
}

.pay-warn {
  font-size: 22rpx;
  color: #8a8a8a;
  margin-top: 12rpx;
  line-height: 1.6;
}

.order-cancel {
  font-size: 26rpx;
  color: #999;
  margin-top: 12rpx;
}

.order-contact {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 16rpx;
  font-size: 26rpx;
}

.order-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 20rpx;
}
