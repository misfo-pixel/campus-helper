<!--pages/subletmarket/subletmarket.wxml-->
<view class="page-container with-kind-pill">
  <view class="page-head">
    <view class="icon-box"><image src="/images/modules/sublet.svg"></image></view>
    <view class="page-head-text">
      <view class="page-head-title">找房转租</view>
      <view class="page-head-sub">转租、求租、找室友</view>
    </view>
    <button class="btn-primary btn-sm" bindtap="goToPublish">+ 发布</button>
  </view>

  <skeleton wx:if="{{loading}}" type="{{demand ? 'text' : 'row'}}" />

  <view wx:elif="{{items.length === 0}}" class="empty-state">
    <view class="icon-box"><image src="/images/modules/sublet.svg"></image></view>
    <view class="empty-state-text">{{emptyText}}</view>
    <button class="btn-primary" bindtap="goToPublish">{{demand ? '发一条求租' : '发布房源'}}</button>
  </view>

  <!-- 转租：有房源图，横向卡片 -->
  <view wx:elif="{{!demand}}">
    <view wx:for="{{items}}" wx:key="_id" bindtap="goToDetail" data-id="{{item._id}}" class="card card-tap sublet-card">
      <image src="{{item.thumb || item.images[0]}}" mode="aspectFill" lazy-load class="sublet-img"></image>
      <view class="sublet-body">
        <view class="text-card-title">{{item.title}}</view>
        <view class="price sublet-price">${{item.rent}}<text class="sublet-unit">/月</text></view>
        <view>
          <text wx:if="{{item.room_type}}" class="chip">{{item.room_type}}</text>
          <text wx:if="{{item.start_date}}" class="chip">{{item.start_date}} 起</text>
        </view>
        <view wx:if="{{item.address}}" class="text-card-meta sublet-addr">{{item.address}}</view>
      </view>
    </view>
  </view>

  <!-- 求租：没有房源图，改成文字列表 -->
  <view wx:else>
    <view wx:for="{{items}}" wx:key="_id" bindtap="goToDetail" data-id="{{item._id}}" class="card card-tap">
      <view class="text-card-head">
        <view class="text-card-title">{{item.title}}</view>
        <view class="price text-card-price">预算 ${{item.rentText}}/月</view>
      </view>
      <view style="margin-top: 12rpx;">
        <text class="chip">{{item.room_type || '房型不限'}}</text>
        <text class="chip">{{item.address || '区域不限'}}</text>
      </view>
      <view wx:if="{{item.description}}" class="text-card-desc">{{item.description}}</view>
    </view>
  </view>

  <loading-spinner wx:if="{{loadingMore}}" />
  <view wx:elif="{{noMore && items.length >= 20}}" class="list-foot">没有更多了</view>
</view>

<view class="kind-pill">
  <view wx:for="{{kinds}}" wx:for-item="k" wx:key="key"
        bindtap="onTapKind" data-key="{{k.key}}"
        class="kind-pill-item {{kind === k.key ? 'kind-pill-on' : ''}}">{{k.label}}</view>
</view>
