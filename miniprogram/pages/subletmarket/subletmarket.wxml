<!--pages/subletmarket/subletmarket.wxml-->
<view class="page-container">
  <view style="display: flex; justify-content: space-between; align-items: center;">
    <view class="page-title" style="margin-bottom: 0;">找房转租 🏠</view>
    <view style="display: flex; align-items: center;">
      <button size="mini" class="btn-primary" bindtap="goToPublish">+ 发布</button>
    </view>
  </view>

  <view wx:if="{{items.length === 0}}" class="text-light" style="text-align: center; margin-top: 100rpx;">
    还没有转租房源，来发布第一个吧
  </view>

  <!-- 房源列表：横向卡片 -->
  <view style="margin-top: 32rpx;">
    <view wx:for="{{items}}" wx:key="_id" bindtap="goToDetail" data-id="{{item._id}}" class="card" style="display: flex; padding: 20rpx;">
      <image src="{{item.images[0]}}" mode="aspectFill" style="width: 200rpx; height: 200rpx; border-radius: 12rpx; margin-right: 20rpx; background: #f0f0f0;"></image>
      <view style="flex: 1;">
        <view style="font-size: 30rpx; font-weight: bold; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">{{item.title}}</view>
        <view class="price" style="margin: 8rpx 0;">${{item.rent}}/月</view>
        <view class="text-light" style="font-size: 24rpx;">{{item.room_type}} · {{item.address}}</view>
        <view class="text-light" style="font-size: 24rpx; margin-top: 4rpx;">{{item.start_date}} 起</view>
      </view>
    </view>
  </view>
</view>