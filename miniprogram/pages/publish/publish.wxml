<!--pages/publish/publish.wxml-->
<view class="page-container with-submit-bar">
  <view class="page-head">
    <view class="icon-box tint-gold"><image src="/images/modules/market.svg"></image></view>
    <view class="page-head-text"><view class="page-head-title">{{demand ? '发布求购' : '发布你的闲置'}}</view></view>
  </view>

  <!-- 这是表单的第一个决定，会改变下面填什么，所以放最上面 -->
  <view class="kind-switch">
    <view wx:for="{{kinds}}" wx:for-item="k" wx:key="key"
          bindtap="onTapKind" data-key="{{k.key}}"
          class="kind-switch-item {{kind === k.key ? 'kind-switch-on' : ''}}">
      {{k.action}}
    </view>
  </view>

  <view class="section-title">基本信息（必填）</view>
  <view class="form-group">
    <!-- 图片上传区。求购没有实物可拍，整块收起来 -->
    <block wx:if="{{!demand}}">
      <view class="uploader">
        <view class="uploader-inner">
          <view wx:for="{{images}}" wx:key="*this" class="uploader-cell">
            <image src="{{item}}" mode="aspectFill" class="uploader-img"></image>
            <view catchtap="removeImage" data-index="{{index}}" class="uploader-del"><view>×</view></view>
          </view>
          <view wx:if="{{images.length < 6}}" bindtap="chooseImages" class="uploader-cell uploader-add">
            <image src="/images/ui/camera.svg"></image>
            <text>{{images.length}}/6</text>
          </view>
        </view>
      </view>
    </block>
    <input placeholder="{{demand ? '想要什么（如 二手显示器）' : '商品名称（如 宜家台灯）'}}" value="{{title}}" bindinput="onInput" data-field="title" class="form-input" />
    <input placeholder="{{demand ? '预算（美元）' : '价格（美元）'}}" type="digit" value="{{price}}" bindinput="onInput" data-field="price" class="form-input" />
    <input placeholder="{{demand ? '你的微信号（卖家联系用）' : '你的微信号（买家联系用）'}}" value="{{seller_wechat}}" bindinput="onInput" data-field="seller_wechat" class="form-input" />
  </view>

  <view class="section-title">详细信息（选填）</view>
  <view class="form-group">
    <textarea placeholder="{{demand ? '补充说明（想要的成色、型号等）' : '描述（成色、转手原因等）'}}" value="{{description}}" bindinput="onInput" data-field="description" class="form-textarea"></textarea>
    <!-- 不填就一直挂着，直到自己标已售 -->
    <picker mode="date" value="{{expire_date}}" bindchange="onDateChange">
      <view class="form-row">
        <text class="form-row-label">自动下架</text>
        <text class="form-row-value {{expire_date ? '' : 'form-row-empty'}}">{{expire_date || '如离美日期'}}</text>
        <text class="form-row-arrow">›</text>
      </view>
    </picker>
  </view>

  <disclaimer-bar type="publish" />
</view>

<!-- 发布按钮钉在底部（app.wxss 的 .submit-bar），长表单不用滑到底才找得到 -->
<view class="submit-bar">
  <button class="btn-primary" bindtap="submitPublish">发布</button>
</view>
