/* pages/subletpublish/subletpublish.wxss */

/* 起止日期同一张卡，两行之间一条分隔线 */
.date-card {
  padding: 0 24rpx;
}

.date-row {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}

.date-row-last {
  border-bottom: none;
}

.date-label {
  font-size: 30rpx;
}

.date-value {
  margin-left: auto;
  font-size: 30rpx;
}

.date-empty {
  color: #999;
}

.date-arrow {
  margin-left: 12rpx;
  color: #ccc;
  font-size: 36rpx;
  line-height: 1;
}
