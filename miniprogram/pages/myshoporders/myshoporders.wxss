.empty {
  text-align: center;
  margin-top: 120rpx;
}

.order {
  padding: 28rpx;
}

.order-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.order-shop {
  font-size: 32rpx;
  font-weight: bold;
}

.order-status {
  font-size: 24rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

.order-status-forming {
  background: #f6e3e6;
  color: var(--color-primary);
}

.order-status-confirming,
.order-status-pending {
  background: #fff4d1;
  color: #7a5200;
}

.order-status-accepted,
.order-status-delivering {
  background: #e8f0fb;
  color: #2b4a7d;
}

.order-status-completed {
  background: #e8f6ec;
  color: #1a7f37;
}

.order-status-cancelled {
  background: #f2f2f2;
  color: #888;
}

.order-sub {
  font-size: 24rpx;
  margin-top: 6rpx;
}

.order-items {
  border-top: 1rpx solid var(--color-border);
  margin-top: 16rpx;
  padding-top: 16rpx;
}

.order-product {
  display: flex;
  justify-content: space-between;
  font-size: 28rpx;
  line-height: 1.8;
}

.order-product-count {
  color: var(--color-text-light);
}

.order-total {
  font-size: 28rpx;
  margin-top: 16rpx;
}

.order-amount {
  font-size: 34rpx;
  font-weight: bold;
  color: var(--color-primary);
}

.order-fee {
  font-size: 24rpx;
}

.order-hint {
  font-size: 26rpx;
  color: #666;
  margin-top: 12rpx;
  line-height: 1.6;
}

.note-box {
  background: var(--color-bg, #f7f7f7);
  border-radius: 12rpx;
  padding: 20rpx;
  margin-top: 16rpx;
}

.note-label {
  font-size: 24rpx;
  color: var(--color-text-light);
}

.note-text {
  font-size: 28rpx;
  line-height: 1.6;
  margin-top: 8rpx;
  word-break: break-all;
}

.note-imgs {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 12rpx;
}

.note-img {
  width: 140rpx;
  height: 140rpx;
  border-radius: 8rpx;
  background: #fff;
}

.order-copy {
  font-size: 26rpx;
  color: var(--color-primary);
  flex-shrink: 0;
}

.order-cancel {
  font-size: 26rpx;
  color: #999;
  margin-top: 12rpx;
}

.order-contact {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 16rpx;
  font-size: 26rpx;
}

.order-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 20rpx;
}

.order-bar {
  margin-top: 20rpx;
}

/* 待确认那一句要显眼：过了时间这一单就自动取消了 */
.order-hint-hot {
  color: #7a5200;
  font-weight: 700;
}

.order-share {
  width: auto !important;
  height: 52rpx;
  line-height: 52rpx;
  margin: 0 !important;
  padding: 0 24rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #fff;
  background: var(--color-primary);
}


