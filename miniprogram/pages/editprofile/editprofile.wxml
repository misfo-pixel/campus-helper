<view class="page-container">
  <view class="page-title">编辑资料</view>

  <!-- 头像：点一下弹微信头像选择（也可以拍照/相册） -->
  <button class="card avatar-row" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
    <view class="avatar-label">头像</view>
    <image wx:if="{{avatarUrl}}" src="{{avatarUrl}}" mode="aspectFill" class="avatar-img" />
    <view wx:else class="avatar-img avatar-fallback">🐿️</view>
    <view class="chevron">›</view>
  </button>

  <view class="section-title">昵称</view>
  <!-- type="nickname" 会弹「使用微信昵称」的快捷填写 -->
  <input type="nickname" placeholder="填一个昵称" value="{{nickname}}" bindinput="onInput" bindblur="onInput" data-field="nickname" class="card" style="padding: 24rpx;" />

  <view class="section-title">微信号</view>
  <input placeholder="填你的微信号（发布时自动填入）" value="{{wechat}}" bindinput="onInput" data-field="wechat" class="card" style="padding: 24rpx;" />
  <view class="text-light" style="margin-top: 12rpx;">存一次，以后发布二手/转租/委托时自动填好联系方式</view>

  <button class="btn-primary" bindtap="save" style="margin-top: 40rpx;">保存</button>
</view>
