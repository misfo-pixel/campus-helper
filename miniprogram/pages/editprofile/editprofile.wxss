/* pages/editprofile/editprofile.wxss */

/* 头像那一行本身是个 button，先把小程序默认按钮样式抹掉 */
.avatar-row {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
  line-height: normal;
  font-size: 30rpx;
  color: var(--color-text);
  text-align: left;
}
.avatar-row:active { opacity: .9; }

.avatar-label { flex: 1; }

.avatar-img {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: var(--color-bg);
}


.chevron {
  color: #ccc;
  font-size: 40rpx;
  margin-left: 16rpx;
}

/* 邮箱：输入框和「发送验证码」挤在一行 */
.email-row {
  display: flex;
  align-items: center;
  padding: 24rpx;
  gap: 16rpx;
}
.email-text { flex: 1; min-width: 0; word-break: break-all; }
.email-input { flex: 1; min-width: 0; }
.email-action {
  flex-shrink: 0;
  font-size: 28rpx;
  color: var(--color-primary);
}
.email-action-off { color: var(--color-text-light); }

/* 和小店设置的「删除小店」一样：放最底下、做成文字，别和「保存」抢 */
.delete-account {
  margin: 56rpx auto 24rpx;
  padding: 16rpx;
  text-align: center;
  font-size: 28rpx;
  color: #C8102E;
}
