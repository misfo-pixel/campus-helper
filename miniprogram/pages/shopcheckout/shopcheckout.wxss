.order-card {
  padding: 28rpx;
}

.shop-name {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
}

.line {
  display: flex;
  align-items: baseline;
  font-size: 28rpx;
  line-height: 2;
}

.line-name {
  flex: 1;
}

.line-count {
  color: var(--color-text-light);
  margin-right: 24rpx;
}

.line-price {
  font-variant-numeric: tabular-nums;
}

.divider {
  height: 1rpx;
  background: var(--color-border);
  margin: 16rpx 0;
}

.line-total {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--color-primary);
}

/* 付款说明 */
.pay-box {
  background: #f5f8ff;
  border: 1rpx solid #d6e2f7;
  border-radius: 12rpx;
  padding: 28rpx;
}

.pay-note {
  font-size: 32rpx;
  font-weight: bold;
  color: #2b4a7d;
  margin-bottom: 16rpx;
  word-break: break-all;
}

.pay-desc {
  font-size: 26rpx;
  line-height: 1.7;
  color: #4a5a75;
}

.pay-amount {
  font-weight: bold;
  color: var(--color-primary);
}

.pay-warn {
  font-size: 24rpx;
  line-height: 1.7;
  color: #8a8a8a;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #d6e2f7;
}

/* 取货地点 / 服务时间：一张卡，每行左标签右内容 */
.info-card {
  padding: 0 24rpx;
}

.info-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 0;
}

/* 取货地点那行下面才有分隔线：服务时间永远是最后一行 */
.info-row-split {
  border-bottom: 1rpx solid var(--color-border);
}

.info-label {
  flex-shrink: 0;
}

.info-value {
  flex: 1;
  min-width: 0;
  text-align: right;
}

.info-value.placeholder {
  color: #999;
}

.info-sub {
  font-size: 24rpx;
  color: var(--color-text-light);
  margin-top: 4rpx;
}

.picker-arrow {
  color: #ccc;
  font-size: 36rpx;
  line-height: 1;
}


/* 买家补充说明的配图。和发布页那几个图片格子保持同一套尺寸，
   不另起一套——买家在别的板块已经见过这个交互了 */
.note-imgs {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 16rpx;
}

.note-img-box {
  position: relative;
  width: 160rpx;
  height: 160rpx;
}

.note-img {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
  background: #f7f7f7;
}

/* 删除角标压在图片右上角。做得够大能点中，但不至于盖住内容 */
.note-img-del {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 40rpx;
  height: 40rpx;
  line-height: 36rpx;
  text-align: center;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.55);
  color: #fff;
  font-size: 28rpx;
}

.note-img-add {
  width: 160rpx;
  height: 160rpx;
  border: 2rpx dashed #ccc;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #999;
  font-size: 56rpx;
}

