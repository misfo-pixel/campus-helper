<!--pages/admin/admin.wxml-->
<view style="padding: 40rpx;">
  <view style="font-size: 40rpx; font-weight: bold; margin-bottom: 30rpx;">待确认订单（管理员）</view>

  <button bindtap="goToSummary" style="margin-bottom: 30rpx;">查看汇总清单</button>

  <view wx:if="{{pendingOrders.length === 0}}" style="color: #999; text-align: center; margin-top: 100rpx;">
    没有待确认的订单
  </view>

  <view wx:for="{{pendingOrders}}" wx:key="_id" style="padding: 24rpx; background: #fff; border: 1rpx solid #eee; border-radius: 12rpx; margin-bottom: 20rpx;">
    <view style="font-size: 32rpx; font-weight: bold;">{{item.item_name}}</view>
    <view style="color: #07c160; margin: 10rpx 0;">${{item.price}}</view>

    <!-- 付款截图 -->
    <image wx:if="{{item.payment_proof_url}}" src="{{item.payment_proof_url}}" style="width: 200rpx; height: 200rpx; margin: 10rpx 0; border-radius: 8rpx;" mode="aspectFill"></image>

    <view style="margin-top: 16rpx;">
      <button size="mini" bindtap="confirmOrder" data-id="{{item._id}}" style="background: #07c160; color: white;">确认收款</button>
    </view>
  </view>
</view>