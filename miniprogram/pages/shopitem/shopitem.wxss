.img-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.dish-img {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
}

.dish-img-placeholder {
  border: 2rpx dashed #ccc;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #999;
  font-size: 60rpx;
}

.img-hint {
  font-size: 26rpx;
}

.avail-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  margin-top: 24rpx;
}

.avail-hint {
  font-size: 24rpx;
  margin-top: 4rpx;
}
