/* pages/itemdetail/itemdetail.wxss */
/* 已下架 的占位状态：撑开高度并居中，避免出现半屏空白 */
.detail-state {
  padding: 160rpx 64rpx;
  text-align: center;
  color: var(--color-text-light);
}
.detail-state-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--color-text);
}

/* 分享落地页专用：给没有上一页可退的人一个入口 */
.detail-more {
  margin-top: 32rpx;
  padding: 24rpx;
  text-align: center;
  font-size: 28rpx;
  color: var(--color-primary);
  background: var(--color-card);
  border-radius: var(--radius);
}

/* 发布者可改的下架日期行：左边整块是日期选择，右边「不自动下架」单独可点 */
.expire-row { align-items: center; }
.expire-picker { flex: 1; min-width: 0; }
.expire-picker-inner { display: flex; align-items: center; }
.expire-clear {
  flex-shrink: 0;
  margin-left: 24rpx;
  padding-left: 24rpx;
  font-size: 26rpx;
  color: var(--color-primary);
  border-left: 1rpx solid var(--color-border);
}
