<!--pages/itemdetail/itemdetail.wxml-->
<view wx:if="{{item}}">
  <!-- 图片轮播（多张图可滑动） -->
  <swiper wx:if="{{item.images.length > 0}}" style="width: 100%; height: 600rpx;" indicator-dots circular>
    <swiper-item wx:for="{{item.images}}" wx:for-item="img" wx:key="*this">
      <image src="{{img}}" mode="aspectFill" style="width: 100%; height: 100%;"></image>
    </swiper-item>
  </swiper>

  <view class="page-container">
    <view style="font-size: 40rpx; font-weight: bold;">{{item.title}}</view>
    <view class="price" style="font-size: 44rpx; margin: 16rpx 0;">${{item.price}}</view>

    <view class="section-title">物品描述</view>
    <view style="line-height: 1.6; color: #555;">{{item.description}}</view>

    <view class="text-light" style="margin-top: 32rpx;">下架日期：{{item.expire_date}}</view>

    <!-- 卖家名片 -->
    <contact-card avatar="{{seller.avatarUrl}}" nickname="{{seller.nickname}}" wechat="{{item.seller_wechat}}"
      link-to-store="{{true}}" bindviewstore="goToSellerStore" />

    <button wx:if="{{canDelete}}" bindtap="deleteItem" style="margin-top: 24rpx; background: #fff; color: #C8102E; border: 1rpx solid #C8102E;">删除商品</button>

    <button wx:if="{{isOwner}}" bindtap="markSold"
    style="margin-top: 24rpx; background: #fff; color: #C8102E; border: 1rpx solid #C8102E;">标记已售</button>

    <!-- 从分享卡片冷启动进来的，页面栈里只有这一页，退无可退。
         给一个往下逛的出口，别让人看完就退出小程序。 -->
    <view wx:if="{{isRootPage}}" class="detail-more" bindtap="goToMarket">逛逛更多闲置 ›</view>

    <disclaimer-bar type="trade" />

    <report-bar target-type="item" target-id="{{item._id}}" />
  </view>
</view>

<!-- 首次进来还没拿到数据。不显示这个的话，慢网络下就是一段白屏。 -->
<view wx:elif="{{loading}}" class="detail-state">加载中…</view>

<!-- 分享卡片会在群里躺很久，点开时商品可能已删或已售。
     这里必须给出口，否则就是白屏——落地页不能假设数据一定还在。 -->
<view wx:else class="detail-state">
  <view class="detail-state-title">这件闲置已经下架了</view>
  <view class="text-light" style="margin-top: 12rpx;">可能已经卖出，或者被发布者删掉了</view>
  <button class="btn-primary" style="margin-top: 40rpx;" bindtap="goToMarket">去看看别的闲置</button>
</view>