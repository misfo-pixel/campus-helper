<!--pages/myorders.wxml-->
<view class="page-container">
  <view style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24rpx;">
    <view class="page-title" style="margin-bottom: 0;">今天淘点什么 ♻️</view>
    <button size="mini" class="btn-primary" bindtap="goToPublish">+ 发布</button>
  </view>

  <view wx:if="{{items.length === 0}}" class="text-light" style="text-align: center; margin-top: 100rpx;">
    还没有商品，来发布第一个吧
  </view>

  <view wx:for="{{myOrders}}" wx:key="_id" style="padding: 24rpx; background: #fff; border: 1rpx solid #eee; border-radius: 12rpx; margin-bottom: 20rpx;">
  <view style="font-size: 32rpx; font-weight: bold;">{{item.item_name}}</view>
  <view style="color: #07c160; margin: 10rpx 0;">${{item.price}}</view>
  <view style="color: #999; font-size: 26rpx;">状态：{{statusText[item.status]}}</view>

  <!-- 待付款：显示上传截图按钮 -->
  <button wx:if="{{item.status === 'pending_payment'}}" size="mini" bindtap="uploadProof" data-id="{{item._id}}" style="margin-top: 16rpx; background: #07c160; color: white;">上传付款截图</button>

  <!-- 已上传：显示截图 -->
  <image wx:if="{{item.payment_proof_url}}" src="{{item.payment_proof_url}}" style="width: 200rpx; height: 200rpx; margin-top: 16rpx; border-radius: 8rpx;" mode="aspectFill"></image>
</view>
</view>