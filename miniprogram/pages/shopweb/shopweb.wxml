<wxs src="/i18n/i18n.wxs" module="i18n" />
<view class="page-container">
  <skeleton wx:if="{{stage === 'starting'}}" type="text" />

  <block wx:else>
    <view class="card step">
      <view class="step-row"><text class="step-num">1</text><text>{{i18n.t('用电脑浏览器打开', lang)}}</text></view>
      <view class="url-row" bindtap="copyUrl">
        <text class="url">{{url}}</text>
        <text class="copy">{{i18n.t('复制网址', lang)}}</text>
      </view>
      <view class="step-row"><text class="step-num">2</text><text>{{i18n.t('输入登录码', lang)}}</text></view>
      <view class="code {{stage === 'expired' ? 'code-dead' : ''}}" bindtap="copyCode">{{codeText}}</view>
      <view wx:if="{{stage === 'ready'}}" class="text-light hint">{{i18n.f('{0} 分钟内有效，只能用一次', lang, minutes)}}</view>
    </view>

    <button wx:if="{{stage === 'expired'}}" class="btn-primary" bindtap="start">{{i18n.t('登录码已过期，重新生成', lang)}}</button>

    <view class="card about">
      <view class="about-title">{{i18n.t('网页上能做的', lang)}}</view>
      <view class="text-light about-line">{{i18n.t('看订单、确认订单、一键复制待确认买家的邮箱、导出订单表格', lang)}}</view>
      <view class="text-light about-line">{{i18n.t('开团、改场次、照常送、取消场次', lang)}}</view>
      <view class="text-light about-line">{{i18n.t('新增和修改商品文字、改价格、上下架', lang)}}</view>
      <view class="about-title about-gap">{{i18n.t('还是要在小程序里做的', lang)}}</view>
      <view class="text-light about-line">{{i18n.t('小店设置（店名、logo、取货点）、商品照片、海报、新单提醒', lang)}}</view>
    </view>

    <view class="logout" bindtap="logoutAll">{{i18n.t('退出所有网页登录', lang)}}</view>
  </block>
</view>
