/* pages/myitems/myitems.wxss */

.share-card {
  display: flex;
  align-items: center;
}
.share-text { flex: 1; margin-right: 20rpx; }
.share-title { font-size: 30rpx; font-weight: 600; }
.share-preview {
  /* 只有一行小字，热区太窄容易点空：撑成行内块再加内边距，指头点得中 */
  display: inline-block;
  margin-top: 6rpx;
  padding: 10rpx 4rpx;
  font-size: 26rpx;
  color: var(--color-primary);
}

.btn-busy { opacity: .6; }
