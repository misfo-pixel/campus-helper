<view wx:if="{{!loading}}" class="page-container">
  <view class="page-title">{{isNew ? '申请入驻 🏪' : '店铺设置'}}</view>

  <disclaimer-bar wx:if="{{isNew}}" type="apply" />

  <!-- 必填的东西全在「详细信息（选填）」之前，所以只在首尾各标一次，
       中间的分节标题不再重复标注——标多了反而没人看 -->
  <view class="section-title">基本信息（必填）</view>

  <input placeholder="店铺名称" value="{{name}}" bindinput="onInput" data-field="name" class="card form-card" />

  <picker mode="selector" range="{{categories}}" value="{{categoryIndex}}" bindchange="onCategoryChange">
    <view class="card form-card">分类：{{categories[categoryIndex]}}</view>
  </picker>

  <view class="subsection-title">配送方式</view>

  <radio-group bindchange="onDeliveryModeChange">
    <label class="card mode-row">
      <radio value="self" checked="{{deliveryMode === 'self'}}" color="#7A0019" />
      <view class="mode-text">
        <view class="mode-title">我自己送 / 顾客自取</view>
        <view class="text-light mode-desc">配送费归你，不用跟谁结算。只做自取也选这个，配送费填 0</view>
      </view>
    </label>
    <label class="card mode-row">
      <radio value="outsourced" checked="{{deliveryMode === 'outsourced'}}" color="#7A0019" />
      <view class="mode-text">
        <view class="mode-title">外包给配送队</view>
        <view class="text-light mode-desc">买家把配送费一起付给你，你事后按对账结果结给队伍</view>
      </view>
    </label>
  </radio-group>

  <picker wx:if="{{deliveryMode === 'outsourced'}}" mode="selector" range="{{teamNames}}" value="{{teamIndex}}" bindchange="onTeamChange">
    <view class="card picker-row">
      <text class="{{teamIndex === null ? 'placeholder' : ''}}">
        {{teamIndex === null ? '选择配送队（必填）' : teamNames[teamIndex]}}
      </text>
      <text class="picker-arrow">›</text>
    </view>
  </picker>

  <view wx:if="{{deliveryMode === 'outsourced' && teamNames.length === 0}}" class="field-hint">
    目前还没有通过审核的配送队，暂时只能选自己送。
  </view>

  <view wx:if="{{deliveryMode === 'outsourced' && teamIndex !== null}}" class="field-hint">
    服务地点和配送时间用这支队伍的，你不用填。
  </view>

  <!-- 自己送：服务地点和批次由你自己定 -->
  <plan-editor wx:if="{{deliveryMode === 'self'}}"
               init-points="{{planPoints}}" init-batches="{{planBatches}}"
               bind:change="onPlanChange" />

  <view class="subsection-title">联系方式</view>
  <view class="field-hint">买家下单后通过微信联系你确认。平台只展示信息、记录订单，不参与交易。</view>

  <input placeholder="联系微信（买家联系用）" value="{{contact_wechat}}" bindinput="onInput" data-field="contact_wechat" class="card form-card" />

  <view class="section-title">详细信息（选填）</view>

  <view class="logo-row card" bindtap="chooseLogo">
    <image wx:if="{{logo}}" src="{{logo}}" mode="aspectFill" class="logo-img" />
    <view wx:else class="logo-img logo-placeholder">+</view>
    <view class="logo-hint">
      <view>店铺 Logo</view>
      <view class="text-light">点击{{logo ? '更换' : '上传'}}，建议正方形</view>
    </view>
  </view>

  <textarea placeholder="店铺简介（做什么、有什么特色）" value="{{description}}" bindinput="onInput" data-field="description" class="card form-card" style="width: auto; height: 140rpx;"></textarea>

  <input placeholder="营业时间（如 周一至周五 11:00-20:00）" value="{{business_hours}}" bindinput="onInput" data-field="business_hours" class="card form-card" />
  <input placeholder="起送价（美元，不填就是不限）" type="digit" value="{{min_order}}" bindinput="onInput" data-field="min_order" class="card form-card" />

  <view class="card license-row" bindtap="chooseLicense">
    <image wx:if="{{licenseImage}}" src="{{licenseImage}}" mode="aspectFill" class="license-img" />
    <view wx:else class="license-img license-placeholder">+</view>
    <view class="license-hint">
      <view>许可证 / 资质凭证</view>
      <view class="text-light">点击{{licenseImage ? '更换' : '上传'}}。是否需要许可证，以你所在地的规定为准</view>
    </view>
  </view>

  <!-- 入驻时必须勾选，已入驻的改资料就不用重复勾了 -->
  <view wx:if="{{isNew}}" class="agree-row">
    <checkbox-group bindchange="onAgreeChange">
      <label class="agree-label">
        <checkbox value="1" checked="{{agreed}}" color="#7A0019" />
        <text class="agree-text">我已阅读并同意</text>
      </label>
    </checkbox-group>
    <text class="agree-link" catchtap="openAgreement">《商家责任告知书》</text>
  </view>

  <button class="btn-primary" bindtap="submit" loading="{{saving}}" style="margin-top: 32rpx;">
    {{isNew ? '提交入驻申请' : '保存'}}
  </button>
</view>
