.logo-row {
  display: flex;
  align-items: center;
  padding: 24rpx;
  gap: 24rpx;
}

.logo-img {
  width: 140rpx;
  height: 140rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
}

.logo-placeholder {
  border: 2rpx dashed #ccc;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #999;
  font-size: 56rpx;
}

.logo-hint {
  font-size: 28rpx;
}

/* 表单输入框。正文 30rpx，比 28rpx 的小标题大一点没关系——
   小标题是加粗的，字重拉开了层级，不用再靠字号压它。 */
.form-card {
  padding: 24rpx;
  font-size: 30rpx;
}

.agree-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  margin-top: 32rpx;
}

.agree-label {
  display: flex;
  align-items: center;
}

.agree-text {
  font-size: 26rpx;
  color: #555;
}

.agree-link {
  font-size: 26rpx;
  color: var(--color-primary);
}

.mode-row {
  display: flex;
  align-items: center;
  padding: 24rpx;
  gap: 16rpx;
}

.mode-text {
  flex: 1;
  min-width: 0;
}

.mode-title {
  font-size: 30rpx;
}

.mode-desc {
  font-size: 24rpx;
  margin-top: 4rpx;
  line-height: 1.5;
}

.license-row {
  display: flex;
  align-items: center;
  padding: 24rpx;
  gap: 24rpx;
}

.license-img {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}

.license-placeholder {
  border: 2rpx dashed #ccc;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #999;
  font-size: 56rpx;
}

.license-hint {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
}

.license-hint .text-light {
  font-size: 24rpx;
  line-height: 1.5;
  margin-top: 6rpx;
}

/* 「需要配送」开关那一行 */
.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding: 24rpx;
}

.switch-text {
  flex: 1;
  min-width: 0;
}

.switch-title {
  font-size: 30rpx;
}

.switch-desc {
  font-size: 24rpx;
  line-height: 1.5;
  margin-top: 4rpx;
}

/* 分组卡：开关当表头，打开后归它管的设置收在同一张卡里。
   关着的时候就是一行「名称 + 开关」，和添加商品页的「当前上架」同一个样子 */
.group {
  padding: 24rpx;
}

.group-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.group-head-text {
  flex: 1;
  min-width: 0;
}

.group-title {
  font-size: 30rpx;
}

.group-hint {
  font-size: 24rpx;
  margin-top: 4rpx;
}

.group-body {
  margin-top: 24rpx;
  border-top: 1rpx solid var(--color-border);
}

/* 卡里的小标签。比表头轻一档（灰、26rpx），层级靠它和灰底框拉开 */
.group-label {
  font-size: 26rpx;
  color: var(--color-text-light);
  margin: 24rpx 0 12rpx;
}

/* 卡里的浅灰底框：同一块灰底里的东西是一伙的 */
.well {
  background: var(--color-bg);
  border-radius: 16rpx;
  padding: 20rpx;
}

/* 分段按钮坐在灰底框顶上，轨道直接用框的底色，不再自带一层灰 */
.well .well-switch {
  padding: 0;
  margin-bottom: 20rpx;
  background: transparent;
}

.well-card {
  box-shadow: none;
  margin-bottom: 0;
}

.fee-hint {
  margin: 12rpx 0 0;
}

.well-input {
  margin-top: 24rpx;
  font-size: 30rpx;
}

