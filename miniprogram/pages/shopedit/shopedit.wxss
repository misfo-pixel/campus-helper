.logo-row {
  display: flex;
  align-items: center;
  padding: 24rpx;
  gap: 24rpx;
}

.logo-img {
  width: 140rpx;
  height: 140rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
}

.logo-placeholder {
  border: 2rpx dashed #ccc;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #999;
  font-size: 56rpx;
}

.logo-hint {
  font-size: 28rpx;
}

/* 表单输入框。正文 30rpx，比 28rpx 的小标题大一点没关系——
   小标题是加粗的，字重拉开了层级，不用再靠字号压它。 */
.form-card {
  padding: 24rpx;
  font-size: 30rpx;
}

.agree-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  margin-top: 32rpx;
}

.agree-label {
  display: flex;
  align-items: center;
}

.agree-text {
  font-size: 26rpx;
  color: #555;
}

.agree-link {
  font-size: 26rpx;
  color: var(--color-primary);
}

.mode-row {
  display: flex;
  align-items: center;
  padding: 24rpx;
  gap: 16rpx;
}

.mode-text {
  flex: 1;
  min-width: 0;
}

.mode-title {
  font-size: 30rpx;
}

.mode-desc {
  font-size: 24rpx;
  margin-top: 4rpx;
  line-height: 1.5;
}

.picker-row {
  display: flex;
  align-items: center;
  padding: 24rpx;
  font-size: 28rpx;
}

.picker-row .placeholder {
  color: #999;
}

.picker-arrow {
  margin-left: auto;
  color: #ccc;
  font-size: 36rpx;
}

.license-row {
  display: flex;
  align-items: center;
  padding: 24rpx;
  gap: 24rpx;
}

.license-img {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}

.license-placeholder {
  border: 2rpx dashed #ccc;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #999;
  font-size: 56rpx;
}

.license-hint {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
}

.license-hint .text-light {
  font-size: 24rpx;
  line-height: 1.5;
  margin-top: 6rpx;
}

/* 「需要配送」开关那一行 */
.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding: 24rpx;
}

.switch-text {
  flex: 1;
  min-width: 0;
}

.switch-title {
  font-size: 30rpx;
}

.switch-desc {
  font-size: 24rpx;
  line-height: 1.5;
  margin-top: 4rpx;
}

/* 收款码上传 */
.qr-row {
  display: flex;
  align-items: center;
  padding: 24rpx;
  gap: 24rpx;
}

.qr-img {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  background: #f7f7f7;
}

.qr-placeholder {
  border: 2rpx dashed #ccc;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #999;
  font-size: 56rpx;
}

.qr-hint {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
}

.qr-hint .text-light {
  font-size: 24rpx;
  line-height: 1.5;
  margin-top: 6rpx;
}
