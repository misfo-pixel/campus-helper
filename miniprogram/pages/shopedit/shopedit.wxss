.logo-row {
  display: flex;
  align-items: center;
  padding: 24rpx;
  gap: 24rpx;
}

.logo-img {
  width: 140rpx;
  height: 140rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
}

.logo-placeholder {
  border: 2rpx dashed #ccc;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #999;
  font-size: 56rpx;
}

.logo-hint {
  font-size: 28rpx;
}

/* 表单输入框。正文 30rpx，比 28rpx 的小标题大一点没关系——
   小标题是加粗的，字重拉开了层级，不用再靠字号压它。 */
.form-card {
  padding: 24rpx;
  font-size: 30rpx;
}

.reject-box {
  background: #fff2f2;
  border: 1rpx solid #f5c6c6;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.reject-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #C8102E;
  margin-bottom: 8rpx;
}

.reject-reason {
  font-size: 26rpx;
  color: #8a3a3a;
  line-height: 1.6;
}

.reject-tip {
  font-size: 24rpx;
  color: var(--color-text-light);
  margin-top: 12rpx;
}

.agree-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  margin-top: 32rpx;
}

.agree-label {
  display: flex;
  align-items: center;
}

.agree-text {
  font-size: 26rpx;
  color: #555;
}

.agree-link {
  font-size: 26rpx;
  color: var(--color-primary);
}

.mode-row {
  display: flex;
  align-items: center;
  padding: 24rpx;
  gap: 16rpx;
}

.mode-text {
  flex: 1;
  min-width: 0;
}

.mode-title {
  font-size: 30rpx;
}

.mode-desc {
  font-size: 24rpx;
  margin-top: 4rpx;
  line-height: 1.5;
}

.picker-row {
  display: flex;
  align-items: center;
  padding: 24rpx;
  font-size: 28rpx;
}

.picker-row .placeholder {
  color: #999;
}

.picker-arrow {
  margin-left: auto;
  color: #ccc;
  font-size: 36rpx;
}

.license-row {
  display: flex;
  align-items: center;
  padding: 24rpx;
  gap: 24rpx;
}

.license-img {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}

.license-placeholder {
  border: 2rpx dashed #ccc;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #999;
  font-size: 56rpx;
}

.license-hint {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
}

.license-hint .text-light {
  font-size: 24rpx;
  line-height: 1.5;
  margin-top: 6rpx;
}
