.step { padding: 32rpx; }
.step-row { display: flex; align-items: center; gap: 16rpx; margin-top: 24rpx; font-size: 28rpx; }
.step-row:first-child { margin-top: 0; }
.step-num {
  width: 40rpx; height: 40rpx; line-height: 40rpx; text-align: center; flex: none;
  font-size: 24rpx; font-weight: 700; color: var(--color-primary); background: var(--color-accent); border-radius: 50%;
}
.url-row { display: flex; align-items: center; justify-content: space-between; margin: 16rpx 0 0 56rpx; padding: 18rpx 24rpx; background: #f5f2ee; border-radius: 12rpx; }
.url { font-weight: 700; color: var(--color-text); }
.copy { font-size: 24rpx; color: var(--color-primary); }
.code { margin: 16rpx 0 0 56rpx; font-size: 72rpx; font-weight: 800; letter-spacing: 12rpx; color: var(--color-primary); font-family: Menlo, monospace; }
.code-dead { color: #c4bcb6; text-decoration: line-through; }
.waiting { margin-top: 32rpx; text-align: center; }

.list-head { display: flex; justify-content: space-between; margin-bottom: 16rpx; font-size: 26rpx; color: var(--color-text-light); }
.pick-all { color: var(--color-primary); }
.list { padding: 0 24rpx; }
.row { display: flex; align-items: center; gap: 20rpx; padding: 24rpx 0; border-bottom: 1rpx solid var(--color-border); }
.row:last-child { border-bottom: 0; }
.row-off { opacity: .5; }
.check {
  flex: none; width: 40rpx; height: 40rpx; line-height: 40rpx; text-align: center; font-size: 26rpx; color: #fff;
  border: 2rpx solid #cfc6c0; border-radius: 10rpx;
}
.check-on { background: var(--color-primary); border-color: var(--color-primary); }
.meta { flex: 1; min-width: 0; }
.name { font-size: 28rpx; font-weight: 600; }
.desc { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.restricted { font-size: 24rpx; color: #C8102E; }
.meta .chip { margin-top: 8rpx; }
.price { flex: none; display: flex; align-items: center; width: 150rpx; padding: 8rpx 16rpx; background: #f5f2ee; border-radius: 10rpx; font-size: 28rpx; }
.price input { flex: 1; margin-left: 4rpx; font-size: 28rpx; }
.footer { position: sticky; bottom: 0; padding: 24rpx 0 calc(24rpx + env(safe-area-inset-bottom)); background: var(--color-bg); }
