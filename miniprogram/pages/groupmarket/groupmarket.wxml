<view class="page-container">
  <view class="page-head">
    <view class="icon-box"><image src="/images/modules/group.svg"></image></view>
    <view class="page-head-text">
      <view class="page-head-title">兴趣群组</view>
      <view class="page-head-sub">找搭子、组乐队、兴趣群</view>
    </view>
    <button class="btn-primary btn-sm" bindtap="goToPublish">+ 发布</button>
  </view>

  <view wx:if="{{items.length === 0}}" class="empty-state">
    <view class="icon-box"><image src="/images/modules/group.svg"></image></view>
    <view class="empty-state-text">还没有人发起，来当第一个吧</view>
    <button class="btn-primary" bindtap="goToPublish">发布群组</button>
  </view>

  <view>
    <view wx:for="{{items}}" wx:key="_id" bindtap="goToDetail" data-id="{{item._id}}" class="card group-card">
      <view class="group-card-main">
        <view class="group-card-head">
          <view class="badge">{{item.kindLabel}}</view>
          <view class="group-card-title">{{item.title}}</view>
        </view>
        <view class="text-light group-card-desc">{{item.description}}</view>
        <view wx:if="{{item.event_date || item.location}}" class="text-light group-card-meta">
          <text wx:if="{{item.event_date}}">{{item.event_date}}</text>
          <text wx:if="{{item.event_date && item.location}}"> · </text>
          <text wx:if="{{item.location}}">{{item.location}}</text>
        </view>
      </view>
      <image wx:if="{{item.thumb}}" src="{{item.thumb}}" mode="aspectFill" lazy-load class="group-card-thumb"></image>
    </view>
  </view>
</view>
