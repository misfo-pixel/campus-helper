<wxs src="/i18n/i18n.wxs" module="i18n" />
<!--pages/subletdetail/subletdetail.wxml-->
<view wx:if="{{item}}">
  <!-- 分享卡片会在群里躺很久，点开时房子可能早就租出去了。不放这一条的话，
       页面跟还开着时一模一样，就会有人白白去加发布者微信。放在最顶上，进来第一眼就看到。 -->
  <view wx:if="{{closed}}" class="closed-banner">
    <view class="closed-banner-label">{{closed}}</view>
    <view class="closed-banner-hint">{{reviewHint || (isOwner ? i18n.t('别人点开时也会先看到这一条', lang) : i18n.t('不用再联系发布者了', lang))}}</view>
  </view>

  <!-- 图片轮播 -->
  <swiper wx:if="{{item.images.length > 0}}" style="width: 100%; height: 600rpx;" indicator-dots circular bindchange="onSwiperChange">
    <swiper-item wx:for="{{item.images}}" wx:for-item="img" wx:key="*this">
      <!-- swiper-item 是 swiper 自己绝对定位的，不能直接改它的 position，所以再包一层 -->
      <view style="position: relative; width: 100%; height: 100%; background: #f0f0f0;">
        <!-- 首张先垫一层缩略图：列表页刚显示过它，多半还在缓存里，一进来就有图；原图下完盖在上面 -->
        <image wx:if="{{index === 0 && item.thumb}}" src="{{item.thumb}}" mode="aspectFill" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%;"></image>
        <image wx:if="{{index <= shownUpTo}}" src="{{img}}" mode="aspectFill" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%;"></image>
      </view>
    </swiper-item>
  </swiper>
  <!-- 求租帖本来就没有房子的照片，不显示占位。而且没图时转发卡片会截页面顶部，
       截到一块灰色「暂无图片」很难看 -->
  <view wx:elif="{{!demand}}" style="width: 100%; height: 300rpx; background: #f0f0f0; display: flex; align-items: center; justify-content: center; color: #999;">{{i18n.t('暂无图片', lang)}}</view>

  <!-- 有图时内容区做成盖在图片下沿的圆角面板（app.wxss 的 .detail-sheet） -->
  <view class="page-container {{item.images.length > 0 ? 'detail-sheet' : ''}}">
    <view class="detail-title">{{item.title}}</view>
    <view class="price detail-price">{{i18n.f('{0}${1}/月', lang, demand ? i18n.t('预算 ', lang) : '', rentText)}}</view>

    <!-- 从列表秒开时手上只有列表那几个字段，下面这些（描述、名片、按钮…）等 getDetail 回来再画。
         不能拿不全的数据先画：比如列表没查「带不带家具」，先画出来就成了错误的「不带家具」 -->
    <block wx:if="{{!partial}}">

    <!-- 核心信息 -->
    <view class="kv-list">
      <!-- 求租帖的房型和区域是选填，空着就是都行 -->
      <view class="kv-row"><text class="kv-label">{{i18n.t('房型', lang)}}</text><text class="kv-value">{{item.room_type || i18n.t('不限', lang)}}</text></view>
      <view class="kv-row"><text class="kv-label">{{demand ? i18n.t('想找的区域', lang) : i18n.t('地址', lang)}}</text><text class="kv-value">{{item.address || i18n.t('不限', lang)}}</text></view>
      <!-- 发布者自己看时，点租期改结束日：到期提醒叫人来这儿改，过期的改到以后就重新上架。
           结束日是必填（autoExpire 按它下架），所以不给「不自动下架」 -->
      <picker wx:if="{{canEditEnd}}" mode="date" value="{{item.end_date}}" start="{{endStart}}" header-text="{{i18n.t('租期改到哪天', lang)}}" bindchange="onEndDateChange">
        <view class="kv-row"><text class="kv-label">{{demand ? i18n.t('想租', lang) : i18n.t('租期', lang)}}</text><text class="kv-value">{{i18n.f('{0} 至 {1}', lang, item.start_date, item.end_date)}}</text><text class="form-row-arrow">›</text></view>
      </picker>
      <view wx:else class="kv-row"><text class="kv-label">{{demand ? i18n.t('想租', lang) : i18n.t('租期', lang)}}</text><text class="kv-value">{{i18n.f('{0} 至 {1}', lang, item.start_date, item.end_date)}}</text></view>
      <view class="kv-row"><text class="kv-label">{{i18n.t('家具', lang)}}</text><text class="kv-value">{{item.furnished ? i18n.t('带家具', lang) : i18n.t('不带家具', lang)}}</text></view>
      <view wx:if="{{item.utilities}}" class="kv-row"><text class="kv-label">{{i18n.t('每月水电', lang)}}</text><text class="kv-value">${{item.utilities}}</text></view>
      <view wx:if="{{item.deposit}}" class="kv-row"><text class="kv-label">{{i18n.t('押金', lang)}}</text><text class="kv-value">${{item.deposit}}</text></view>
    </view>

    <!-- 室友情况 -->
    <view wx:if="{{item.roommate_info}}">
      <view class="section-title">{{i18n.t('室友情况', lang)}}</view>
      <view class="detail-text">{{item.roommate_info}}</view>
    </view>

    <!-- 其他说明 -->
    <view wx:if="{{item.description}}">
      <view class="section-title">{{i18n.t('其他说明', lang)}}</view>
      <view class="detail-text">{{item.description}}</view>
    </view>

    <!-- 房东名片。已结束的帖子不给别人亮联系方式：横幅写着结束了，底下还摆着「复制微信号」，照样有人去加。
         发布者自己看的是自己的名片，不受影响。 -->
    <contact-card wx:if="{{!closed || isOwner}}" link-to-store="{{true}}" bindviewstore="goToSellerStore" avatar="{{seller.avatarUrl}}" nickname="{{seller.nickname}}" wechat="{{item.contact_wechat}}" />

    <!-- 发布者标记已租出（已经结束的不用再标）；本人或管理员可以删除 -->
    <view wx:if="{{(isOwner && !closed) || canDelete}}" class="owner-actions">
      <button wx:if="{{isOwner && !closed}}" bindtap="markRented" class="btn-outline">{{i18n.t('标记已租出', lang)}}</button>
      <button wx:if="{{canDelete}}" bindtap="deleteItem" class="btn-danger">{{i18n.t('删除', lang)}}</button>
    </view>

    <!-- 从分享卡片冷启动进来的，页面栈里只有这一页，退无可退。
         给一个往下逛的出口，别让人看完就退出小程序。 -->
    <view wx:if="{{isRootPage}}" class="detail-more" bindtap="goToMarket">{{i18n.t('逛逛更多房源 ›', lang)}}</view>

    <message-board target-type="sublet" target-id="{{item._id}}" owner="{{isOwner}}" />

    <report-bar target-type="sublet" target-id="{{item._id}}" owner="{{isOwner}}" />

    <!-- 免责一行放在最底下 -->
    <disclaimer-bar type="sublet" />
    </block>
    <view wx:else class="text-light" style="margin-top: 32rpx;">{{i18n.t('加载详情…', lang)}}</view>
  </view>
</view>

<!-- 首次进来还没拿到数据。不显示这个的话，慢网络下就是一段白屏。 -->
<skeleton wx:elif="{{loading}}" type="detail" />

<!-- 分享卡片会在群里躺很久，点开时内容可能已删或已下架。
     落地页不能假设数据一定还在，必须给出口。 -->
<view wx:else class="detail-state">
  <view class="detail-state-title">{{i18n.t('这条转租已经下架了', lang)}}</view>
  <view class="text-light" style="margin-top: 12rpx;">{{i18n.t('可能已经完成，或者被发布者删掉了', lang)}}</view>
  <button class="btn-primary" style="margin-top: 40rpx;" bindtap="goToMarket">{{i18n.t('去看看别的房源', lang)}}</button>
</view>
