<!--pages/subletdetail/subletdetail.wxml-->
<view wx:if="{{item}}">
  <!-- 图片轮播 -->
  <swiper wx:if="{{item.images.length > 0}}" style="width: 100%; height: 600rpx;" indicator-dots circular>
    <swiper-item wx:for="{{item.images}}" wx:for-item="img" wx:key="*this">
      <image src="{{img}}" mode="aspectFill" style="width: 100%; height: 100%;"></image>
    </swiper-item>
  </swiper>
  <view wx:else style="width: 100%; height: 300rpx; background: #f0f0f0; display: flex; align-items: center; justify-content: center; color: #999;">暂无图片</view>

  <view class="page-container">
    <view style="font-size: 40rpx; font-weight: bold;">{{item.title}}</view>
    <view class="price" style="font-size: 44rpx; margin: 16rpx 0;">${{item.rent}}/月</view>

    <!-- 核心信息 -->
    <view class="card" style="padding: 28rpx;">
      <view style="margin-bottom: 12rpx;">🏠 房型：{{item.room_type}}</view>
      <view style="margin-bottom: 12rpx;">📍 地址：{{item.address}}</view>
      <view style="margin-bottom: 12rpx;">📅 租期：{{item.start_date}} 至 {{item.end_date}}</view>
      <view style="margin-bottom: 12rpx;">🛋 家具：{{item.furnished ? '带家具' : '不带家具'}}</view>
      <view wx:if="{{item.utilities}}" style="margin-bottom: 12rpx;">💡 每月水电：${{item.utilities}}</view>
      <view wx:if="{{item.deposit}}">💰 押金：${{item.deposit}}</view>
    </view>

    <!-- 室友情况 -->
    <view wx:if="{{item.roommate_info}}">
      <view class="section-title">室友情况</view>
      <view style="line-height: 1.6; color: #555;">{{item.roommate_info}}</view>
    </view>

    <!-- 其他说明 -->
    <view wx:if="{{item.description}}">
      <view class="section-title">其他说明</view>
      <view style="line-height: 1.6; color: #555;">{{item.description}}</view>
    </view>

    <!-- 房东名片 -->
    <contact-card link-to-store="{{true}}" bindviewstore="goToSellerStore" avatar="{{seller.avatarUrl}}" nickname="{{seller.nickname}}" wechat="{{item.contact_wechat}}" />

    <!-- 发布者：标记已租出 -->
    <button wx:if="{{isOwner}}" bindtap="markRented" class="btn-primary" style="margin-top: 24rpx; background: #fff; color: #C8102E; border: 1rpx solid #C8102E;">标记已租出</button>

    <!-- 本人或管理员：删除 -->
    <button wx:if="{{canDelete}}" bindtap="deleteItem" style="margin-top: 24rpx; background: #fff; color: #C8102E; border: 1rpx solid #C8102E;">删除</button>

    <!-- 从分享卡片冷启动进来的，页面栈里只有这一页，退无可退。
         给一个往下逛的出口，别让人看完就退出小程序。 -->
    <view wx:if="{{isRootPage}}" class="detail-more" bindtap="goToMarket">逛逛更多房源 ›</view>

    <disclaimer-bar type="sublet" />

    <report-bar target-type="sublet" target-id="{{item._id}}" />
  </view>
</view>

<!-- 首次进来还没拿到数据。不显示这个的话，慢网络下就是一段白屏。 -->
<view wx:elif="{{loading}}" class="detail-state">加载中…</view>

<!-- 分享卡片会在群里躺很久，点开时内容可能已删或已下架。
     落地页不能假设数据一定还在，必须给出口。 -->
<view wx:else class="detail-state">
  <view class="detail-state-title">这条转租已经下架了</view>
  <view class="text-light" style="margin-top: 12rpx;">可能已经完成，或者被发布者删掉了</view>
  <button class="btn-primary" style="margin-top: 40rpx;" bindtap="goToMarket">去看看别的房源</button>
</view>
