<wxs src="/i18n/i18n.wxs" module="i18n" />
<view class="page-container joined">
  <view class="icon-box tint-cream joined-icon"><image src="/images/modules/shop.svg"></image></view>
  <view class="joined-shop">{{i18n.f('已参团 · {0}', lang, name)}}</view>
  <view class="joined-headline">{{headline}}</view>

  <block wx:if="{{p && !p.open}}">
    <view class="gb-bar {{p.formed ? 'gb-bar-done' : ''}} joined-bar">
      <view class="gb-bar-fill" style="width: {{p.pct}}%"></view>
    </view>
    <view class="joined-count">{{countText}} · {{cutText}}</view>
  </block>
  <view wx:else class="joined-count">{{cutText}}</view>

  <view class="card joined-card">
    <view class="joined-row">
      <text class="text-light">{{i18n.t('取货', lang)}}</text>
      <text>{{pickText}}</text>
    </view>
    <view class="joined-row">
      <text class="text-light">{{i18n.t('之后', lang)}}</text>
      <text>{{p.open ? i18n.t('截单后联系店长确认', lang) : i18n.t('成团后联系店长确认', lang)}}</text>
    </view>
  </view>

  <button class="btn-primary" open-type="share">{{i18n.t('约上饭搭子', lang)}}</button>
  <button class="btn-outline joined-second" bindtap="makePoster" loading="{{posterBusy}}">{{i18n.t('生成海报', lang)}}</button>
  <view class="joined-link" bindtap="goToOrders">{{i18n.t('查看订单', lang)}}</view>
</view>

<group-share id="gs" />
