.joined {
  padding-top: 72rpx;
  text-align: center;
}

.joined-icon {
  width: 144rpx;
  height: 144rpx;
  margin: 0 auto 24rpx;
  border-radius: 40rpx;
}

.joined-icon image {
  width: 104rpx;
  height: 104rpx;
}

.joined-shop {
  font-size: 26rpx;
  color: var(--color-text-light);
}

/* 这一页就为这一句话：大字、栗色 */
.joined-headline {
  margin-top: 12rpx;
  font-family: "HuangYou", -apple-system, "PingFang SC", sans-serif;
  font-size: 64rpx;
  font-weight: 400;
  line-height: 1.25;
  color: var(--color-primary);
}

.joined-bar {
  height: 20rpx;
  margin: 40rpx 40rpx 0;
}

.joined-count {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: var(--color-text-light);
}

.joined-card {
  margin: 56rpx 0 48rpx;
  text-align: left;
}

.joined-row {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  font-size: 28rpx;
  line-height: 2;
}

.joined-second {
  margin-top: 24rpx;
}

.joined-link {
  margin-top: 32rpx;
  font-size: 28rpx;
  color: var(--color-text-light);
}
