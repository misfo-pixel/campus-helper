<loading-spinner wx:if="{{loading}}" />
<view wx:elif="{{loadError}}" class="page-container">
  <view class="text-light empty" bindtap="retry">读取失败，点击重试</view>
</view>

<view wx:else class="page-container">
  <!-- ========== 开队码 ========== -->
  <view class="section-head">
    <view class="section-title section-title-bar">开队码</view>
    <button class="btn-primary btn-sm" bindtap="makeCode" loading="{{busy}}">+ 生成</button>
  </view>

  <view wx:if="{{codes.length === 0}}" class="card text-light block-empty">还没发过开队码</view>
  <view wx:else class="card list">
    <view wx:for="{{codes}}" wx:key="_id" class="code-row">
      <view class="code-main">
        <text class="code {{item.live ? '' : 'code-dead'}}">{{item.code}}</text>
        <text wx:if="{{item.note}}" class="code-note">{{item.note}}</text>
      </view>
      <view class="code-sub">
        <text class="text-light">{{item.stateText}}</text>
        <text wx:if="{{item.live}}" class="code-copy" bindtap="copyCode" data-code="{{item.code}}">复制</text>
      </view>
    </view>
  </view>

  <!-- ========== 配送队 ========== -->
  <view class="section-title section-title-bar">配送队（{{teams.length}}）</view>

  <view wx:if="{{teams.length === 0}}" class="card text-light block-empty">还没有配送队</view>
  <view wx:for="{{teams}}" wx:key="_id" class="card team {{item.takedown ? 'team-down' : ''}}">
    <view class="team-head">
      <text class="team-name">{{item.name}}</text>
      <text wx:if="{{item.takedown}}" class="team-pill">{{item.downText}}</text>
    </view>
    <view class="text-light team-line">队长 {{item.admin_nickname || '未设昵称'}} · 微信 {{item.contact_wechat || '没填'}}</view>
    <view class="team-stats">
      送达 {{item.delivered_count}} 单
      <text class="{{item.no_show_count ? 'team-bad' : ''}}"> · 爽约 {{item.no_show_count}} 次</text>
    </view>
    <view class="team-actions">
      <button class="{{item.takedown ? 'btn-outline' : 'btn-danger'}} btn-sm"
              bindtap="toggleTakedown" data-id="{{item._id}}" data-name="{{item.name}}"
              data-down="{{item.takedown}}">{{item.takedown ? '恢复' : '下架'}}</button>
    </view>
  </view>
</view>
