.head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 8rpx 4rpx 28rpx;
}

/* 这一页说的就是哪一天，日期做大 */
.head-date {
  font-size: 48rpx;
  font-weight: 800;
  color: var(--color-primary);
}

.head-state {
  font-size: 26rpx;
  color: var(--color-text-light);
}

/* 同一天别家的场次：奶油底一块，和店铺页选中场次的底色一致 */
.others {
  margin-bottom: 24rpx;
  padding: 20rpx 24rpx;
  border-radius: var(--radius);
  background: #fbf0dc;
}

.others-title {
  font-size: 24rpx;
  color: #8a6a3a;
  margin-bottom: 6rpx;
}

.others-row {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  font-size: 26rpx;
  line-height: 1.8;
}

.others-name {
  font-weight: 700;
}

.point {
  gap: 20rpx;
}

.point-locked {
  opacity: .6;
}

.point-check {
  flex-shrink: 0;
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  border-radius: 10rpx;
  border: 2rpx solid #d9d2cb;
  font-size: 26rpx;
  font-weight: 700;
  color: #fff;
}

.point-on {
  border-color: var(--color-primary);
  background: var(--color-primary);
}

.point-name {
  font-weight: 700;
}

.no-points {
  color: var(--color-primary);
  text-align: center;
}

.confirm-line {
  margin: 40rpx 0 20rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--color-text-light);
}

.confirm-warn {
  color: #C8102E;
  font-weight: 700;
}

.cancel {
  margin: 48rpx auto 24rpx;
  padding: 16rpx;
  text-align: center;
  font-size: 28rpx;
  color: #C8102E;
}
