<view class="page-container">
  <view class="tabs">
    <view class="tab {{status === 'pending' ? 'tab-on' : ''}}" bindtap="switchStatus" data-status="pending">待核对</view>
    <view class="tab {{status === 'approved' ? 'tab-on' : ''}}" bindtap="switchStatus" data-status="approved">已通过</view>
    <view class="tab {{status === 'rejected' ? 'tab-on' : ''}}" bindtap="switchStatus" data-status="rejected">已驳回</view>
  </view>

  <view wx:if="{{loading}}" class="text-light empty">加载中…</view>
  <view wx:elif="{{teams.length === 0}}" class="text-light empty">没有记录</view>

  <view wx:for="{{teams}}" wx:key="_id" class="card shop">
    <view class="shop-head">
      <view class="shop-logo shop-logo-fallback">🛵</view>
      <view class="shop-meta">
        <view class="shop-name">{{item.name}}</view>
        <view class="text-light">队长 {{item.admin_nickname || '未设昵称'}} · {{item.timeText}}</view>
      </view>
    </view>

    <view wx:if="{{item.description}}" class="shop-row">简介：{{item.description}}</view>
    <view class="shop-row">队长微信：{{item.contact_wechat}}</view>
    <view class="shop-row">收款方式：{{item.payment_note}}</view>

    <view wx:if="{{item.audit_status === 'rejected' && item.audit_reason}}" class="shop-reason">
      驳回原因：{{item.audit_reason}}
    </view>

    <view wx:if="{{status === 'pending'}}" class="shop-actions">
      <button class="btn-outline btn-sm" bindtap="rejectTeam" data-id="{{item._id}}">驳回</button>
      <button class="btn-primary btn-sm" bindtap="approveTeam" data-id="{{item._id}}">通过</button>
    </view>
  </view>
</view>
