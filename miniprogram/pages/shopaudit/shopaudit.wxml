<view class="page-container">
  <view class="kinds">
    <view class="kind {{kind === 'shop' ? 'kind-on' : ''}}" bindtap="switchKind" data-kind="shop">商家</view>
    <view class="kind {{kind === 'team' ? 'kind-on' : ''}}" bindtap="switchKind" data-kind="team">配送队</view>
  </view>

  <view class="tabs">
    <view class="tab {{status === 'pending' ? 'tab-on' : ''}}" bindtap="switchStatus" data-status="pending">待核对</view>
    <view class="tab {{status === 'approved' ? 'tab-on' : ''}}" bindtap="switchStatus" data-status="approved">已通过</view>
    <view class="tab {{status === 'rejected' ? 'tab-on' : ''}}" bindtap="switchStatus" data-status="rejected">已驳回</view>
  </view>

  <view wx:if="{{loading}}" class="text-light empty">加载中…</view>
  <view wx:elif="{{kind === 'shop' && shops.length === 0}}" class="text-light empty">没有记录</view>
  <view wx:elif="{{kind === 'team' && teams.length === 0}}" class="text-light empty">没有记录</view>

  <view wx:if="{{kind === 'shop'}}" wx:for="{{shops}}" wx:key="_id" class="card shop">
    <view class="shop-head">
      <image wx:if="{{item.logo}}" src="{{item.logo}}" mode="aspectFill" class="shop-logo" />
      <view wx:else class="shop-logo shop-logo-fallback">🍽</view>
      <view class="shop-meta">
        <view class="shop-name">{{item.name}}</view>
        <view class="text-light">{{item.category}} · {{item.timeText}}</view>
      </view>
    </view>

    <view wx:if="{{item.description}}" class="shop-row">简介：{{item.description}}</view>
    <view class="shop-row">配送范围：{{item.delivery_area}}</view>
    <view wx:if="{{item.business_hours}}" class="shop-row">营业时间：{{item.business_hours}}</view>
    <view class="shop-row">起送 ${{item.min_order}} · {{item.delivery_mode === 'outsourced' ? '外包配送' : '商家自送'}}</view>
    <view class="shop-row">收款方式：{{item.payment_note}}</view>
    <view class="shop-row">联系微信：{{item.contact_wechat}}</view>

    <view wx:if="{{item.audit_status === 'rejected' && item.audit_reason}}" class="shop-reason">
      驳回原因：{{item.audit_reason}}
    </view>

    <view wx:if="{{status === 'pending'}}" class="shop-actions">
      <button class="btn-outline btn-sm" bindtap="reject" data-id="{{item._id}}">驳回</button>
      <button class="btn-primary btn-sm" bindtap="approve" data-id="{{item._id}}" data-name="{{item.name}}">通过</button>
    </view>
  </view>

  <!-- 配送队 -->
  <view wx:if="{{kind === 'team'}}" wx:for="{{teams}}" wx:key="_id" class="card shop">
    <view class="shop-head">
      <view class="shop-logo shop-logo-fallback">🛵</view>
      <view class="shop-meta">
        <view class="shop-name">{{item.name}}</view>
        <view class="text-light">队长 {{item.admin_nickname || '未设昵称'}} · {{item.timeText}}</view>
      </view>
    </view>

    <view wx:if="{{item.description}}" class="shop-row">简介：{{item.description}}</view>
    <view class="shop-row">队长微信：{{item.contact_wechat}}</view>
    <view class="shop-row">收款方式：{{item.payment_note}}</view>

    <view wx:if="{{item.audit_status === 'rejected' && item.audit_reason}}" class="shop-reason">
      驳回原因：{{item.audit_reason}}
    </view>

    <view wx:if="{{status === 'pending'}}" class="shop-actions">
      <button class="btn-outline btn-sm" bindtap="rejectTeam" data-id="{{item._id}}">驳回</button>
      <button class="btn-primary btn-sm" bindtap="approveTeam" data-id="{{item._id}}">通过</button>
    </view>
  </view>
</view>
