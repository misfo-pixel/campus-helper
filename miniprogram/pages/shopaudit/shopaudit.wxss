@import "../reports/reports.wxss";

.shop {
  padding: 28rpx;
}

.shop-head {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.shop-logo {
  width: 96rpx;
  height: 96rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}

.shop-logo-fallback {
  background: #f2f2f2;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
}

.shop-meta {
  flex: 1;
  min-width: 0;
}

.shop-name {
  font-size: 32rpx;
  font-weight: bold;
}

.shop-row {
  font-size: 26rpx;
  color: #555;
  line-height: 1.7;
}

.shop-reason {
  font-size: 26rpx;
  color: #C8102E;
  margin-top: 12rpx;
}

.shop-actions {
  display: flex;
  justify-content: flex-end;
  gap: 20rpx;
  margin-top: 24rpx;
}

.kinds {
  display: flex;
  margin-bottom: 24rpx;
  border: 1rpx solid var(--color-border);
  border-radius: 12rpx;
  overflow: hidden;
}

.kind {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 28rpx;
  background: var(--color-card);
  color: var(--color-text-light);
}

.kind-on {
  background: var(--color-primary);
  color: #fff;
}
