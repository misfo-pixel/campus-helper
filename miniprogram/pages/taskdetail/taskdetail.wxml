<!--pages/taskdetail/taskdetail.wxml-->
<view wx:if="{{item}}">
  <!-- 图片轮播（委托可能没图） -->
  <swiper wx:if="{{item.images.length > 0}}" style="width: 100%; height: 500rpx;" indicator-dots circular>
    <swiper-item wx:for="{{item.images}}" wx:for-item="img" wx:key="*this">
      <image src="{{img}}" mode="aspectFill" style="width: 100%; height: 100%;"></image>
    </swiper-item>
  </swiper>

  <view class="page-container">
    <view style="display: flex; justify-content: space-between; align-items: flex-start;">
      <view style="font-size: 40rpx; font-weight: bold; flex: 1;">{{item.title}}</view>
      <view class="price" style="font-size: 44rpx; margin-left: 20rpx;">${{item.reward}}</view>
    </view>

    <view class="section-title">任务描述</view>
    <view style="line-height: 1.6; color: #555;">{{item.description}}</view>

    <!-- 补充信息 -->
    <view class="card" style="padding: 28rpx; margin-top: 32rpx;">
      <view wx:if="{{item.deadline}}" style="margin-bottom: 12rpx;">⏰ 截止时间：{{item.deadline}}</view>
      <view wx:if="{{item.location}}">📍 地点：{{item.location}}</view>
      <view wx:if="{{!item.deadline && !item.location}}" class="text-light">无补充信息</view>
    </view>

    <!-- 发布者名片 -->
    <contact-card link-to-store="{{true}}" bindviewstore="goToSellerStore" avatar="{{seller.avatarUrl}}" nickname="{{seller.nickname}}" wechat="{{item.contact_wechat}}" />

    <!-- 发布者：标记完成 -->
    <button wx:if="{{isOwner}}" bindtap="markDone" class="btn-primary" style="margin-top: 24rpx; background: #fff; color: #C8102E; border: 1rpx solid #C8102E;">标记已完成</button>

    <!-- 本人或管理员：删除 -->
    <button wx:if="{{canDelete}}" bindtap="deleteItem" style="margin-top: 24rpx; background: #fff; color: #C8102E; border: 1rpx solid #C8102E;">删除</button>

    <!-- 从分享卡片冷启动进来的，页面栈里只有这一页，退无可退。
         给一个往下逛的出口，别让人看完就退出小程序。 -->
    <view wx:if="{{isRootPage}}" class="detail-more" bindtap="goToMarket">逛逛更多委托 ›</view>

    <disclaimer-bar type="task" />

    <report-bar target-type="task" target-id="{{item._id}}" />
  </view>
</view>

<!-- 首次进来还没拿到数据。不显示这个的话，慢网络下就是一段白屏。 -->
<view wx:elif="{{loading}}" class="detail-state">加载中…</view>

<!-- 分享卡片会在群里躺很久，点开时内容可能已删或已下架。
     落地页不能假设数据一定还在，必须给出口。 -->
<view wx:else class="detail-state">
  <view class="detail-state-title">这条委托已经下架了</view>
  <view class="text-light" style="margin-top: 12rpx;">可能已经完成，或者被发布者删掉了</view>
  <button class="btn-primary" style="margin-top: 40rpx;" bindtap="goToMarket">去看看别的委托</button>
</view>
