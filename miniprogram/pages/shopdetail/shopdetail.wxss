.shop-head {
  display: flex;
  gap: 24rpx;
  padding: 32rpx;
  background: var(--color-card);
}

.shop-logo {
  width: 150rpx;
  height: 150rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
}

.shop-logo-fallback {
  background: #f2f2f2;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60rpx;
}

.shop-meta {
  flex: 1;
  min-width: 0;
}

.shop-name {
  font-size: 38rpx;
  font-weight: bold;
}

.shop-desc {
  font-size: 26rpx;
  color: #666;
  margin-top: 8rpx;
  line-height: 1.5;
  /* 原来「下单须知」里的约定现在写进简介，店长分行写的要按行显示 */
  white-space: pre-wrap;
}

/* 许可证标：店名后面一个蓝色圆标。
   inline-block + 垂直居中，店名折行时跟着最后一行走 */
.license-badge {
  display: inline-block;
  width: 34rpx;
  height: 34rpx;
  line-height: 34rpx;
  margin-left: 10rpx;
  border-radius: 50%;
  background: #1772F6;
  color: #fff;
  font-size: 20rpx;
  font-weight: bold;
  text-align: center;
  vertical-align: 4rpx;
}

.license-badge:active {
  opacity: 0.6;
}

.shop-info {
  font-size: 24rpx;
  color: var(--color-text-light);
  margin-top: 6rpx;
}

/* 场次：店头下面一整条，白底，和店头连成一块 */
.sessions {
  padding: 0 32rpx 28rpx;
  background: var(--color-card);
}

.session-tabs {
  white-space: nowrap;
  margin-bottom: 20rpx;
}

.session-tab {
  display: inline-block;
  margin-right: 16rpx;
  padding: 10rpx 28rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: var(--color-text-light);
  background: var(--color-bg);
}

.session-tab-on {
  color: #fff;
  font-weight: 700;
  background: var(--color-primary);
}

/* 选中那一场：奶油底的一块，进度条和取货点都在里面 */
.session-panel {
  padding: 24rpx;
  border-radius: var(--radius);
  background: #fbf0dc;
}

.session-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.session-when {
  font-size: 30rpx;
  font-weight: 700;
}

.session-bar {
  margin-top: 20rpx;
  background: #fff;
}

.session-points {
  margin-top: 18rpx;
  padding-top: 14rpx;
  border-top: 1rpx dashed #e6d3b3;
}

.session-point {
  display: flex;
  justify-content: space-between;
  font-size: 26rpx;
  line-height: 1.8;
}

.session-point-name {
  font-weight: 700;
}

.no-session {
  padding: 0 32rpx 28rpx;
  font-size: 26rpx;
  color: var(--color-text-light);
  background: var(--color-card);
}

/* 开团提醒 */
.sub-bar {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 32rpx;
  background: var(--color-card);
  border-top: 1rpx solid var(--color-border);
}

.sub-text {
  flex: 1;
  min-width: 0;
}

.sub-title {
  font-size: 28rpx;
  font-weight: bold;
}

.sub-hint {
  font-size: 24rpx;
  color: var(--color-text-light);
  margin-top: 4rpx;
}

.sub-btn {
  flex-shrink: 0;
  font-size: 26rpx;
  color: #fff;
  background: var(--color-primary);
  border-radius: 999rpx;
  padding: 12rpx 32rpx;
}

.sub-btn-more {
  color: var(--color-primary);
  background: #f7ecef;
}

.sub-btn:active {
  opacity: 0.7;
}

.sub-cancel {
  flex-shrink: 0;
  font-size: 24rpx;
  color: #bbb;
  padding: 12rpx 0;
}

.empty {
  text-align: center;
  margin: 100rpx 0;
}

/* 菜品 */
.product {
  display: flex;
  align-items: center;
  padding: 24rpx;
  gap: 20rpx;
}

.product-img {
  width: 150rpx;
  height: 150rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}

.product-img-fallback {
  background: #f2f2f2;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
}

.product-meta {
  flex: 1;
  min-width: 0;
}

.product-name {
  font-size: 30rpx;
  font-weight: bold;
}

.product-off {
  color: #bbb;
}

.product-desc {
  font-size: 24rpx;
  margin-top: 6rpx;
  line-height: 1.5;
}

/* 过敏原要显眼，这是商家在告知书里承诺如实标注的东西 */
.product-specs {
  font-size: 22rpx;
  color: #b8860b;
  margin-top: 8rpx;
  line-height: 1.4;
}

.product-price {
  font-size: 32rpx;
  color: var(--color-primary);
  font-weight: bold;
  margin-top: 10rpx;
}

.product-ops {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}

.product-soldout {
  font-size: 24rpx;
  color: #bbb;
  border: 1rpx solid #e5e5e5;
  border-radius: 20rpx;
  padding: 6rpx 20rpx;
}

.stepper-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  border: 1rpx solid var(--color-primary);
  color: var(--color-primary);
}

.stepper-add {
  background: var(--color-primary);
  color: #fff;
}

.stepper-count {
  min-width: 40rpx;
  text-align: center;
  font-size: 30rpx;
}

/* 转发落地页专用：给没有上一页可退的人一个入口 */
.detail-more {
  margin-top: 32rpx;
  padding: 24rpx;
  text-align: center;
  font-size: 28rpx;
  color: var(--color-primary);
  background: var(--color-card);
  border-radius: var(--radius);
}

.cart-spacer {
  height: 140rpx;
}

/* 底部购物车条 */
.cart-bar {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 24rpx;
  height: 104rpx;
  background: #2b2b2b;
  border-radius: 52rpx;
  display: flex;
  align-items: center;
  padding: 0 16rpx 0 40rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.2);
}

.cart-info {
  flex: 1;
  color: #fff;
}

.cart-total {
  font-size: 34rpx;
  font-weight: bold;
}

.cart-sub {
  font-size: 22rpx;
  color: #bbb;
  margin-top: 2rpx;
}

.cart-btn {
  background: var(--color-primary);
  color: #fff;
  font-size: 30rpx;
  padding: 0 44rpx;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 40rpx;
}

.cart-btn-off {
  background: #666;
  color: #ccc;
}

/* 商家自己写的下单须知。平台只负责展示，内容由商家负责 */
/* 计价单位，跟在价格后面，弱化显示 */
.product-unit {
  font-size: 22rpx;
  font-weight: normal;
  color: #999;
}

/* 黄页模式下底部条左侧放的是微信号，不是金额。
   字号比金额小一档：微信号可能很长，太大会撑破 */
.wechat-id {
  font-size: 32rpx;
  word-break: break-all;
}

.session-poster {
  margin-top: 14rpx;
  text-align: right;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--color-primary);
}

/* ---------- 店铺配色 ----------
   --shop-* 从这家店的 logo 取色（utils/theme.js 的 cssVars），没有时退回小程序自己的颜色 */
.shop-page .session-tab-on {
  color: var(--shop-on-accent, #fff);
  background: var(--shop-accent, var(--color-primary));
}

.shop-page .session-panel {
  background: var(--shop-soft, #fbf0dc);
}

.shop-page .session-points {
  border-top-color: var(--shop-line, #e6d3b3);
}

.shop-page .gb-bar-fill {
  background: var(--shop-accent, var(--color-primary));
}

.shop-page .gb-text,
.shop-page .session-poster,
.shop-page .product-price {
  color: var(--shop-accent, var(--color-primary));
}

.shop-page .stepper-btn {
  border-color: var(--shop-accent, var(--color-primary));
  color: var(--shop-accent, var(--color-primary));
}

.shop-page .stepper-add,
.shop-page .cart-btn,
.shop-page .sub-btn {
  color: var(--shop-on-accent, #fff);
  background: var(--shop-accent, var(--color-primary));
}

.shop-page .sub-btn-more {
  color: var(--shop-accent, var(--color-primary));
  background: var(--shop-soft, #f7ecef);
}

.shop-page .cart-btn-off {
  background: #666;
  color: #ccc;
}
