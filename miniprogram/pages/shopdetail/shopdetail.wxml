<view wx:if="{{shop}}">
  <!-- 店头 -->
  <view class="shop-head">
    <image wx:if="{{shop.logo}}" src="{{shop.logo}}" mode="aspectFill" class="shop-logo" />
    <view wx:else class="shop-logo shop-logo-fallback">🍽</view>
    <view class="shop-meta">
      <view class="shop-name">{{shop.name}}</view>
      <view wx:if="{{shop.description}}" class="shop-desc">{{shop.description}}</view>
      <view class="shop-info">起送 ${{shop.min_order}} · 配送费按取餐点计算</view>
      <view wx:if="{{shop.business_hours}}" class="shop-info">{{shop.business_hours}}</view>
      <view wx:if="{{shop.delivery_area}}" class="shop-info">配送范围：{{shop.delivery_area}}</view>
    </view>
  </view>

  <view wx:if="{{shop.status === 'paused'}}" class="paused-bar">
    该店暂停接单，可以先看看菜单
  </view>

  <view class="page-container">
    <disclaimer-bar type="buyer" />

    <!-- 菜单 -->
    <block wx:for="{{groups}}" wx:key="category">
      <view class="section-title">{{item.category}}</view>

      <view wx:for="{{item.items}}" wx:for-item="dish" wx:key="_id" class="card dish">
        <image wx:if="{{dish.image}}" src="{{dish.image}}" mode="aspectFill" class="dish-img" />
        <view wx:else class="dish-img dish-img-fallback">🍽</view>

        <view class="dish-meta">
          <view class="dish-name {{dish.available ? '' : 'dish-off'}}">{{dish.name}}</view>
          <view wx:if="{{dish.description}}" class="text-light dish-desc">{{dish.description}}</view>
          <view wx:if="{{dish.allergens}}" class="dish-allergens">⚠️ 含：{{dish.allergens}}</view>
          <view class="dish-price">${{dish.price}}</view>
        </view>

        <view class="dish-ops">
          <view wx:if="{{!dish.available}}" class="dish-soldout">售罄</view>
          <block wx:else>
            <view wx:if="{{dish.count > 0}}" class="stepper-btn" bindtap="removeItem" data-id="{{dish._id}}">−</view>
            <view wx:if="{{dish.count > 0}}" class="stepper-count">{{dish.count}}</view>
            <view class="stepper-btn stepper-add" bindtap="addItem" data-id="{{dish._id}}">+</view>
          </block>
        </view>
      </view>
    </block>

    <view wx:if="{{groups.length === 0}}" class="text-light empty">这家店还没上架菜品</view>

    <!-- 给底部购物车条留位置 -->
    <view class="cart-spacer"></view>
  </view>

  <!-- 底部购物车 -->
  <view wx:if="{{cartCount > 0}}" class="cart-bar">
    <view class="cart-info">
      <view class="cart-total">${{cartSubtotal}}</view>
      <view class="cart-sub">{{cartCount}} 件 · 配送费结算时计算</view>
    </view>
    <view class="cart-btn {{canOrder ? '' : 'cart-btn-off'}}" bindtap="checkout">
      {{reachMin ? '去结算' : '差 $' + shop.min_order + ' 起送'}}
    </view>
  </view>
</view>
