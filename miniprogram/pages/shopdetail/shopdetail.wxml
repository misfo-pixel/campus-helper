<skeleton wx:if="{{loading}}" type="shop" />
<view wx:if="{{shop}}" class="shop-page" style="{{themeStyle}}">
  <!-- 店头 -->
  <view class="shop-head">
    <image wx:if="{{shop.logo}}" src="{{shop.logo}}" mode="aspectFill" class="shop-logo" />
    <view wx:else class="shop-logo shop-logo-fallback"><image src="/images/modules/shop.svg" class="ico-fill"></image></view>
    <view class="shop-meta">
      <!-- 店长传了许可证才有这个标，点开看原图。
           用「证」而不用对勾：平台不核实，对勾会被读成「平台认证过」 -->
      <view class="shop-name">
        <text>{{shop.name}}</text>
        <text wx:if="{{shop.license_image}}" class="license-badge" catchtap="previewLicense">证</text>
      </view>
      <view wx:if="{{shop.description}}" class="shop-desc">{{shop.description}}</view>
      <view wx:if="{{ordering && shop.min_order > 0}}" class="shop-info">起送 ${{shop.min_order}}</view>
      <view wx:elif="{{!ordering && shop.contact_wechat}}" class="shop-info">微信：{{shop.contact_wechat}}</view>
    </view>
  </view>

  <!-- 场次：一家店开着好几场时顶上切换 -->
  <view wx:if="{{ordering && sessions.length}}" class="sessions">
    <scroll-view wx:if="{{sessions.length > 1}}" scroll-x class="session-tabs" enhanced show-scrollbar="{{false}}">
      <view wx:for="{{sessions}}" wx:key="_id" class="session-tab {{index === sessionIndex ? 'session-tab-on' : ''}}"
            bindtap="pickSession" data-index="{{index}}">{{item.dayText}}</view>
    </scroll-view>

    <view class="session-panel">
      <view class="session-head">
        <text class="session-when">{{session.dayText}} · {{session.depart_time}} 出发</text>
        <text wx:if="{{session.p.formed && !session.p.open}}" class="gb-sticker">已成团</text>
      </view>
      <view wx:if="{{!session.p.open}}" class="gb-bar {{session.p.formed ? 'gb-bar-done' : ''}} session-bar">
        <view class="gb-bar-fill" style="width: {{session.p.pct}}%"></view>
      </view>
      <view class="gb-line">
        <text class="{{session.p.open ? 'gb-text-quiet' : 'gb-text'}}">{{session.p.text}}</text>
        <text class="{{session.cutHot ? 'gb-cut-hot' : 'gb-cut'}}">{{session.cutText}}</text>
      </view>
      <view class="session-points">
        <view wx:for="{{session.points}}" wx:key="name" class="session-point">
          <text class="session-point-name">{{item.name}}</text>
          <text class="text-light">约 {{item.arrive}} 到{{item.fee > 0 ? ' · 配送费 $' + item.fee : ''}}</text>
        </view>
      </view>
      <view class="session-poster" bindtap="makePoster">生成海报 ›</view>
    </view>
  </view>

  <view wx:elif="{{ordering}}" class="no-session">暂无拼团</view>

  <!-- 开团提醒。没场次时更需要这个：现在买不了，开了再叫我 -->
  <view wx:if="{{subEnabled && !subMine && shop.needs_delivery !== false}}" class="sub-bar">
    <view class="sub-text">
      <view class="sub-title">开团提醒</view>
      <view wx:if="{{subTickets > 0}}" class="sub-hint">还会提醒你 {{subTickets}} 次</view>
    </view>
    <view wx:if="{{subTickets > 0}}" class="sub-cancel" bindtap="unsubscribe">取消</view>
    <view class="sub-btn {{subTickets > 0 ? 'sub-btn-more' : ''}}" bindtap="subscribe">{{subTickets > 0 ? '再加一次' : '订阅'}}</view>
  </view>

  <view class="page-container">
    <!-- 商品 -->
    <block wx:for="{{groups}}" wx:key="category">
      <view wx:if="{{item.category}}" class="section-title">{{item.category}}</view>

      <view wx:for="{{item.items}}" wx:for-item="product" wx:key="_id" class="card product">
        <image wx:if="{{product.image}}" src="{{product.image}}" mode="aspectFill" class="product-img" />
        <view wx:else class="product-img product-img-fallback"><image src="/images/ui/box.svg" class="ico-fill"></image></view>

        <view class="product-meta">
          <view class="product-name {{product.available ? '' : 'product-off'}}">{{product.name}}</view>
          <view wx:if="{{product.description}}" class="text-light product-desc">{{product.description}}</view>
          <view wx:if="{{product.specs}}" class="product-specs">含：{{product.specs}}</view>
          <view class="product-price">${{product.price}}<text wx:if="{{product.unit}}" class="product-unit"> / {{product.unit}}</text></view>
        </view>

        <view class="product-ops">
          <view wx:if="{{!product.available}}" class="product-soldout">售罄</view>
          <block wx:elif="{{ordering}}">
            <view wx:if="{{product.count > 0}}" class="stepper-btn" bindtap="removeItem" data-id="{{product._id}}">−</view>
            <view wx:if="{{product.count > 0}}" class="stepper-count">{{product.count}}</view>
            <view class="stepper-btn stepper-add" bindtap="addItem" data-id="{{product._id}}">+</view>
          </block>
        </view>
      </view>
    </block>

    <view wx:if="{{groups.length === 0}}" class="text-light empty">这家店还没上架商品</view>

    <!-- 从转发卡片冷启动进来的，页面栈里只有这一页，退无可退。
         给一个往下逛的出口，别让人看完就退出小程序。 -->
    <view wx:if="{{isRootPage}}" class="detail-more" bindtap="goToShopList">更多拼团 ›</view>

    <report-bar target-type="shop" target-id="{{shop._id}}" />

    <!-- 免责一行放在最底下：进店先看到的应该是商品 -->
    <disclaimer-bar type="buyer" />

    <!-- 给底部固定条留位置 -->
    <view class="cart-spacer"></view>
  </view>

  <!-- 底部固定条。订单模式是购物车，黄页模式是店长微信 -->
  <view wx:if="{{ordering && cartCount > 0}}" class="cart-bar">
    <view class="cart-info">
      <view class="cart-total">${{cartSubtotal}}</view>
      <view class="cart-sub">{{cartCount}} 件{{session ? ' · ' + session.dayText + '送达' : ''}}</view>
    </view>
    <view class="cart-btn {{canOrder ? '' : 'cart-btn-off'}}" bindtap="checkout">
      {{reachMin ? '去拼团' : '差 $' + shop.min_order + ' 起送'}}
    </view>
  </view>

  <view wx:if="{{!ordering && shop.contact_wechat}}" class="cart-bar">
    <view class="cart-info">
      <view class="cart-total wechat-id">{{shop.contact_wechat}}</view>
      <view class="cart-sub">加微信联系店长</view>
    </view>
    <view class="cart-btn" bindtap="copyWechat">复制微信号</view>
  </view>
</view>

<group-share id="gs" />
