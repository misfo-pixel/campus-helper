<!--pages/summary/summary.wxml-->
<view style="padding: 40rpx;">
  <view style="font-size: 40rpx; font-weight: bold; margin-bottom: 30rpx;">汇总清单</view>

  <!-- 取餐清单 -->
  <view style="font-size: 34rpx; font-weight: bold; margin-bottom: 16rpx;">📋 取餐清单（给餐厅报单）</view>
  <view wx:if="{{itemSummary.length === 0}}" style="color: #999; margin-bottom: 30rpx;">暂无已确认订单</view>
  <view wx:for="{{itemSummary}}" wx:key="name" style="padding: 20rpx; background: #fff; border: 1rpx solid #eee; border-radius: 8rpx; margin-bottom: 12rpx; display: flex; justify-content: space-between;">
    <view>{{item.name}}</view>
    <view style="color: #07c160; font-weight: bold;">×{{item.count}}</view>
  </view>

  <!-- 送餐清单 -->
  <view style="font-size: 34rpx; font-weight: bold; margin: 40rpx 0 16rpx;">🚚 送餐清单（按楼分组）</view>
  <view wx:for="{{buildingGroups}}" wx:key="building" style="margin-bottom: 24rpx;">
    <view style="font-weight: bold; background: #f5f5f5; padding: 16rpx; border-radius: 8rpx;">{{item.building}}（{{item.orders.length}}单）</view>
    <view wx:for="{{item.orders}}" wx:for-item="order" wx:key="pickup_name" style="padding: 16rpx 20rpx; border-bottom: 1rpx solid #eee;">
      {{order.pickup_name}} — {{order.item_name}}
    </view>
  </view>
</view>