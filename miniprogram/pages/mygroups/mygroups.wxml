<view class="page-container">
  <view class="page-title">我的群组</view>

  <view wx:if="{{items.length === 0}}" class="text-light" style="text-align: center; margin-top: 100rpx;">
    你还没发起过
  </view>

  <view wx:for="{{items}}" wx:key="_id" bindtap="goToDetail" data-id="{{item._id}}" class="card" style="padding: 24rpx;">
    <view style="display: flex; align-items: center; gap: 12rpx;">
      <view class="badge">{{item.kindLabel}}</view>
      <view style="font-size: 30rpx; font-weight: bold; flex: 1;">{{item.title}}</view>
    </view>
    <view class="text-light" style="font-size: 24rpx; margin-top: 8rpx;">状态：{{item.statusText}}</view>
  </view>
</view>
