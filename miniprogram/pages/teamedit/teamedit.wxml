<wxs src="/i18n/i18n.wxs" module="i18n" />
<skeleton wx:if="{{loading}}" type="form" />
<!-- 读取失败时不能往下渲染：一张空白的建队表单会让队长以为自己的队没了 -->
<view wx:if="{{!loading && loadError}}" class="page-container">
  <view class="text-light empty" bindtap="retry">{{i18n.t('读取失败，点击重试', lang)}}</view>
</view>

<view wx:elif="{{!loading}}" class="page-container">
  <view class="page-title">{{isNew ? i18n.t('创建配送队', lang) : i18n.t('队伍设置', lang)}}</view>

  <!-- 队员只能看，改不了 -->
  <block wx:if="{{isNew || role === 'admin'}}">
    <!-- 建队要管理员给的开队码：有了群发，建一支队就能收到所有店长的请求 -->
    <block wx:if="{{isNew}}">
      <view class="section-title">{{i18n.t('开队码', lang)}}</view>
      <input placeholder="{{i18n.t('找平台管理员要，8 位，7 天内有效', lang)}}" value="{{create_code}}" bindinput="onInput"
             data-field="create_code" maxlength="8" class="card form-card code-input" />
    </block>

    <view class="section-title">{{i18n.t('基本信息（必填）', lang)}}</view>
    <view class="field-hint">{{i18n.t('店长按对账结果把配送费结给你们，微信和收款方式要填能用的。', lang)}}</view>
    <input placeholder="{{i18n.t('队伍名称', lang)}}" value="{{name}}" bindinput="onInput" data-field="name" class="card form-card" />
    <input placeholder="{{i18n.t('队长微信（店长结算时联系）', lang)}}" value="{{contact_wechat}}" bindinput="onInput" data-field="contact_wechat" class="card form-card" />
    <input placeholder="{{i18n.t('收款方式（如 Venmo @team-handle）', lang)}}" value="{{payment_note}}" bindinput="onInput" data-field="payment_note" class="card form-card" />

    <view class="section-title">{{i18n.t('详细信息（选填）', lang)}}</view>
    <textarea placeholder="{{i18n.t('简介（服务范围、常跑哪几个校区，店长挑队伍时会看到）', lang)}}" value="{{description}}" bindinput="onInput" data-field="description" class="card form-card" style="width: auto; height: 140rpx;"></textarea>


    <button class="btn-primary" bindtap="submit" loading="{{saving}}" style="margin-top: 32rpx;">
      {{isNew ? i18n.t('创建队伍', lang) : i18n.t('保存', lang)}}
    </button>
  </block>

  <block wx:else>
    <view class="card info-card">
      <view class="info-name">{{team.name}}</view>
      <view wx:if="{{team.description}}" class="text-light info-desc">{{team.description}}</view>
      <view class="text-light info-row">{{i18n.f('队长微信：{0}', lang, team.contact_wechat)}}</view>
    </view>
  </block>

  <!-- 邀请码：只有队长看得到 -->
  <block wx:if="{{!isNew && role === 'admin'}}">
    <view class="section-title">{{i18n.t('邀请码', lang)}}</view>
    <view class="field-hint">
      {{i18n.t('新队员用下面的「添加队员」更快。这个码留给已经能看到配送工作台的人（比如店长）自助加入。', lang)}}
    </view>
    <view class="card code-card">
      <text class="code-text">{{team.join_code}}</text>
      <text class="code-op" bindtap="copyCode">{{i18n.t('复制', lang)}}</text>
      <text class="code-op code-reset" bindtap="resetCode">{{i18n.t('重置', lang)}}</text>
    </view>
  </block>

  <!-- 成员 -->
  <block wx:if="{{!isNew}}">
    <view class="members-head">
      <view class="section-title" style="margin: 0;">{{i18n.f('成员（{0}）', lang, members.length)}}</view>
      <button wx:if="{{role === 'admin'}}" class="btn-primary btn-sm" bindtap="addMember">{{i18n.t('+ 添加队员', lang)}}</button>
    </view>
    <view wx:if="{{role === 'admin'}}" class="field-hint">
      {{i18n.t('按微信号添加。对方要先进过小程序，并在「我的 → 编辑资料」里填了微信号。', lang)}}
    </view>
    <view wx:for="{{members}}" wx:key="_id" class="card member">
      <view class="member-name">
        {{item.nickname || i18n.t('未设昵称', lang)}}
        <text wx:if="{{item.role === 'admin'}}" class="member-tag">{{i18n.t('队长', lang)}}</text>
      </view>
      <text wx:if="{{role === 'admin' && item.role !== 'admin'}}" class="member-del"
            bindtap="removeMember" data-openid="{{item.openid}}" data-nickname="{{item.nickname}}">{{i18n.t('移出', lang)}}</text>
    </view>

    <view wx:if="{{role !== 'admin'}}" class="quit" bindtap="quitTeam">{{i18n.t('退出队伍', lang)}}</view>
  </block>
</view>
