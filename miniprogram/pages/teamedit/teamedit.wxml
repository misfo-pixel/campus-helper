<!-- 读取失败时不能往下渲染：一张空白的建队表单会让队长以为自己的队没了 -->
<view wx:if="{{!loading && loadError}}" class="page-container">
  <view class="text-light empty" bindtap="retry">读取失败，点击重试</view>
</view>

<view wx:elif="{{!loading}}" class="page-container">
  <view class="page-title">{{isNew ? '创建配送队 🛵' : '队伍设置'}}</view>

  <!-- 队员只能看，改不了 -->
  <block wx:if="{{isNew || role === 'admin'}}">
    <view class="section-title">基本信息（必填）</view>
    <view class="field-hint">店长按对账结果把配送费结给你们，微信和收款方式要填能用的。</view>
    <input placeholder="队伍名称" value="{{name}}" bindinput="onInput" data-field="name" class="card form-card" />
    <input placeholder="队长微信（店长结算时联系）" value="{{contact_wechat}}" bindinput="onInput" data-field="contact_wechat" class="card form-card" />
    <input placeholder="收款方式（如 Venmo @team-handle）" value="{{payment_note}}" bindinput="onInput" data-field="payment_note" class="card form-card" />

    <view class="section-title">详细信息（选填）</view>
    <textarea placeholder="简介（服务范围、常跑哪几个校区，店长挑队伍时会看到）" value="{{description}}" bindinput="onInput" data-field="description" class="card form-card" style="width: auto; height: 140rpx;"></textarea>


    <button class="btn-primary" bindtap="submit" loading="{{saving}}" style="margin-top: 32rpx;">
      {{isNew ? '创建队伍' : '保存'}}
    </button>
  </block>

  <block wx:else>
    <view class="card info-card">
      <view class="info-name">{{team.name}}</view>
      <view wx:if="{{team.description}}" class="text-light info-desc">{{team.description}}</view>
      <view class="text-light info-row">队长微信：{{team.contact_wechat}}</view>
    </view>
  </block>

  <!-- 邀请码：只有队长看得到 -->
  <block wx:if="{{!isNew && role === 'admin'}}">
    <view class="section-title">邀请码</view>
    <view class="field-hint">
      新队员用下面的「添加队员」更快。这个码留给已经能看到配送工作台的人（比如店长）自助加入。
    </view>
    <view class="card code-card">
      <text class="code-text">{{team.join_code}}</text>
      <text class="code-op" bindtap="copyCode">复制</text>
      <text class="code-op code-reset" bindtap="resetCode">重置</text>
    </view>
  </block>

  <!-- 成员 -->
  <block wx:if="{{!isNew}}">
    <view class="members-head">
      <view class="section-title" style="margin: 0;">成员（{{members.length}}）</view>
      <button wx:if="{{role === 'admin'}}" class="btn-primary btn-sm" bindtap="addMember">+ 添加队员</button>
    </view>
    <view wx:if="{{role === 'admin'}}" class="field-hint">
      按微信号添加。对方要先进过小程序，并在「我的 → 编辑资料」里填了微信号。
    </view>
    <view wx:for="{{members}}" wx:key="_id" class="card member">
      <view class="member-name">
        {{item.nickname || '未设昵称'}}
        <text wx:if="{{item.role === 'admin'}}" class="member-tag">队长</text>
      </view>
      <text wx:if="{{role === 'admin' && item.role !== 'admin'}}" class="member-del"
            bindtap="removeMember" data-openid="{{item.openid}}" data-nickname="{{item.nickname}}">移出</text>
    </view>

    <view wx:if="{{role !== 'admin'}}" class="quit" bindtap="quitTeam">退出队伍</view>
  </block>
</view>
