.menu-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.empty {
  text-align: center;
  margin-top: 120rpx;
}

.dish {
  display: flex;
  align-items: center;
  padding: 24rpx;
  gap: 20rpx;
}

.dish-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}

.dish-img-fallback {
  background: #f2f2f2;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
}

.dish-meta {
  flex: 1;
  min-width: 0;
}

.dish-name {
  font-size: 30rpx;
  font-weight: bold;
}

/* 售罄的菜名灰掉，一眼能扫出哪些下架了 */
.dish-off {
  color: #bbb;
  text-decoration: line-through;
}

.dish-desc {
  font-size: 24rpx;
  margin-top: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dish-price {
  font-size: 30rpx;
  color: var(--color-primary);
  font-weight: bold;
  margin-top: 8rpx;
}

.dish-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 12rpx;
  flex-shrink: 0;
}

.dish-ops {
  display: flex;
  gap: 20rpx;
}

.dish-op {
  font-size: 26rpx;
  color: var(--color-text-light);
}

.dish-op-danger {
  color: #C8102E;
}

/* 计价单位，跟在价格后面，弱化显示 */
.dish-unit {
  font-size: 22rpx;
  font-weight: normal;
  color: #999;
}

/* 右上角的分类开关，占原来「+ 添加商品」的位置 */
.cat-toggle {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 26rpx;
  color: #999;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background: #f5f5f5;
}

.cat-toggle.cat-on {
  color: #7A0019;
  background: #f7ecef;
}

.cat-icon { font-size: 24rpx; }

/* 虚线占位框：列表末尾的「再加一件」 */
.dish-add {
  border: 2rpx dashed #d0d0d0;
  border-radius: 16rpx;
  padding: 44rpx 0;
  margin-top: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  background: #fafafa;
}

.dish-add-icon {
  font-size: 44rpx;
  color: #bbb;
  line-height: 1;
}

.dish-add-text {
  font-size: 26rpx;
  color: #999;
}
