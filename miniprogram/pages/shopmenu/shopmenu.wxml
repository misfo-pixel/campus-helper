<view class="page-container">
  <view class="menu-head">
    <view class="page-title" style="margin-bottom: 0;">商品管理</view>
    <view class="cat-toggle {{useCategory ? 'cat-on' : ''}}" bindtap="toggleCategory">
      <text class="cat-icon">☰</text>
      <text>{{useCategory ? '已开启分类' : '开启分类'}}</text>
    </view>
  </view>

  <view wx:if="{{!loading && itemCount === 0}}" class="text-light empty">
    还没有商品，点下面的框加第一件
  </view>

  <block wx:for="{{groups}}" wx:key="category">
    <view wx:if="{{item.category}}" class="section-title">{{item.category}}</view>

    <view wx:for="{{item.items}}" wx:for-item="product" wx:key="_id" class="card product">
      <image wx:if="{{product.image}}" src="{{product.image}}" mode="aspectFill" class="product-img" />
      <view wx:else class="product-img product-img-fallback">📦</view>

      <view class="product-meta">
        <view class="product-name {{product.available ? '' : 'product-off'}}">{{product.name}}</view>
        <view wx:if="{{product.description}}" class="text-light product-desc">{{product.description}}</view>
        <view class="product-price">${{product.price}}<text wx:if="{{product.unit}}" class="product-unit"> / {{product.unit}}</text></view>
      </view>

      <view class="product-right">
        <switch checked="{{product.available}}" color="#7A0019" bindchange="toggleItem" data-id="{{product._id}}" />
        <view class="product-ops">
          <text class="product-op" bindtap="editItem" data-id="{{product._id}}">编辑</text>
          <text class="product-op product-op-danger" bindtap="deleteItem" data-id="{{product._id}}" data-name="{{product.name}}">删除</text>
        </view>
      </view>
    </view>
  </block>

  <!-- 虚线占位框。比一个顶部按钮更像「这里还能再加一件」 -->
  <view wx:if="{{!loading}}" class="product-add" bindtap="addItem">
    <view class="product-add-icon">＋</view>
    <view class="product-add-text">添加商品</view>
  </view>
</view>
