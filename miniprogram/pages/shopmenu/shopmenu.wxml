<wxs src="/i18n/i18n.wxs" module="i18n" />
<view class="page-container">
  <view class="menu-head">
    <view class="page-title" style="margin-bottom: 0;">{{i18n.t('商品管理', lang)}}</view>
    <view class="cat-toggle {{useCategory ? 'cat-on' : ''}}" bindtap="toggleCategory">
      <text class="cat-icon">☰</text>
      <text>{{useCategory ? i18n.t('已开启分类', lang) : i18n.t('开启分类', lang)}}</text>
    </view>
  </view>

  <skeleton wx:if="{{loading}}" type="row" thumb="{{150}}" count="{{3}}" />
  <view wx:elif="{{itemCount === 0}}" class="text-light empty">
    {{i18n.t('还没有商品，点下面的框加第一件', lang)}}
  </view>

  <block wx:for="{{groups}}" wx:key="category">
    <view wx:if="{{item.category}}" class="section-title">{{i18n.t(item.category, lang)}}</view>

    <view wx:for="{{item.items}}" wx:for-item="product" wx:key="_id" class="card product">
      <image wx:if="{{product.image}}" src="{{product.image}}" mode="aspectFill" class="product-img" />
      <view wx:else class="product-img product-img-fallback"><image src="/images/ui/box.svg" class="ico-fill"></image></view>

      <view class="product-meta">
        <view class="product-name {{product.available ? '' : 'product-off'}}">{{product.name}}</view>
        <view wx:if="{{product.description}}" class="text-light product-desc">{{product.description}}</view>
        <view class="product-price">${{product.price}}<text wx:if="{{product.unit}}" class="product-unit"> / {{product.unit}}</text></view>
      </view>

      <view class="product-right">
        <switch checked="{{product.available}}" color="#7A0019" bindchange="toggleItem" data-id="{{product._id}}" />
        <view class="product-ops">
          <text class="product-op" bindtap="editItem" data-id="{{product._id}}">{{i18n.t('编辑', lang)}}</text>
          <text class="product-op product-op-danger" bindtap="deleteItem" data-id="{{product._id}}" data-name="{{product.name}}">{{i18n.t('删除', lang)}}</text>
        </view>
      </view>
    </view>
  </block>

  <!-- 虚线占位框。比一个顶部按钮更像「这里还能再加一件」 -->
  <view wx:if="{{!loading}}" class="product-add" bindtap="addItem">
    <view class="product-add-icon">＋</view>
    <view class="product-add-text">{{i18n.t('添加商品', lang)}}</view>
  </view>
  <!-- 菜品多的店一件件录太累：贴菜单链接、文字或拍照，在网页上整理好一次导进来 -->
  <view wx:if="{{!loading}}" class="import-link" bindtap="importMenu">{{i18n.t('从网页导入菜单', lang)}} ›</view>
</view>
