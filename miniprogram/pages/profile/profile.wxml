<view class="page-container">
  <!-- 用户信息区：整块点进去就是编辑资料 -->
  <view bindtap="goToEdit" class="card card-tap" style="display: flex; align-items: center; padding: 40rpx;">
    <image wx:if="{{avatarUrl}}" src="{{avatarUrl}}" mode="aspectFill" class="profile-avatar" />
    <view wx:else class="profile-avatar profile-avatar-fallback">🐿️</view>
    <view style="flex: 1; min-width: 0;">
      <view style="font-size: 36rpx; font-weight: bold;">{{nickname || '点击设置昵称'}}</view>
      <view class="text-light">{{isAdmin ? '管理员' : '普通用户'}}</view>
    </view>
    <view style="color: #ccc; font-size: 40rpx;">›</view>
  </view>

  <!-- 功能入口 -->
<view bindtap="goToMyItems" class="card" style="display: flex; align-items: center; padding: 32rpx;">
  <view style="flex: 1; font-size: 30rpx;">♻️ 我发布的闲置</view>
  <view style="color: #ccc; font-size: 40rpx;">›</view>
</view>

<view bindtap="goToMySublets" class="card" style="display: flex; align-items: center; padding: 32rpx;">
  <view style="flex: 1; font-size: 30rpx;">🏠 我发布的转租</view>
  <view style="color: #ccc; font-size: 40rpx;">›</view>
</view>

<view bindtap="goToMyTasks" class="card" style="display: flex; align-items: center; padding: 32rpx;">
  <view style="flex: 1; font-size: 30rpx;">🙋 我发布的委托</view>
  <view style="color: #ccc; font-size: 40rpx;">›</view>
</view>

<view bindtap="goToMyOrders" class="card" style="display: flex; align-items: center; padding: 32rpx;">
  <view style="flex: 1; font-size: 30rpx;">🍱 我的外卖订单</view>
  <view style="color: #ccc; font-size: 40rpx;">›</view>
</view>
</view>
