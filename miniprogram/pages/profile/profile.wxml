<view class="page-container">
  <!-- 用户信息区：整块点进去就是编辑资料 -->
  <view bindtap="goToEdit" class="card card-tap" style="display: flex; align-items: center; padding: 40rpx;">
    <image wx:if="{{avatarUrl}}" src="{{avatarUrl}}" mode="aspectFill" class="profile-avatar" />
    <view wx:else class="profile-avatar profile-avatar-fallback">🐿️</view>
    <view style="flex: 1; min-width: 0;">
      <view style="font-size: 36rpx; font-weight: bold;">{{nickname || '点击设置昵称'}}</view>
      <view class="text-light">{{isAdmin ? '管理员' : '普通用户'}}</view>
    </view>
    <view style="color: #ccc; font-size: 40rpx;">›</view>
  </view>

  <!-- ========== 我发布的 ========== -->
  <view class="profile-group">我发布的</view>

  <view bindtap="goToMyItems" class="card card-tap profile-row">
    <view class="profile-row-label">♻️ 我的闲置</view>
    <view class="profile-row-arrow">›</view>
  </view>

  <view bindtap="goToMySublets" class="card card-tap profile-row">
    <view class="profile-row-label">🏠 我的转租</view>
    <view class="profile-row-arrow">›</view>
  </view>

  <view bindtap="goToMyTasks" class="card card-tap profile-row">
    <view class="profile-row-label">🙋 我的委托</view>
    <view class="profile-row-arrow">›</view>
  </view>

  <!-- ========== 校外服务 ==========
       「我的订单」是买家视角（我在别人店里点的），
       「我的小店」是店长视角（我自己开的店）。分组标题负责把这层区别讲清楚。 -->
  <view wx:if="{{shopEnabled}}" class="profile-group">校外服务</view>

  <view wx:if="{{shopEnabled}}" bindtap="goToShopOrders" class="card card-tap profile-row">
    <view class="profile-row-label">🧾 我的订单</view>
    <view class="profile-row-arrow">›</view>
  </view>

  <view wx:if="{{shopEnabled}}" bindtap="goToShop" class="card card-tap profile-row">
    <view class="profile-row-label">🏪 我的小店</view>
    <view class="profile-row-arrow">›</view>
  </view>

  <!-- 配送工作台：配送队管理员 / 有店的店长 / 已在队里的人才看得到 -->
  <view wx:if="{{teamEnabled && shopEnabled && canSeeDelivery}}" bindtap="goToTeam" class="card card-tap profile-row">
    <view class="profile-row-label">🛵 我的配送</view>
    <view class="profile-row-arrow">›</view>
  </view>

  <!-- ========== 管理 ==========
       标题本身也要跟着权限走，否则普通用户会看到一个空标题。
       配送队核对已经整个撤掉：建队即可用，和店铺「提交即开店」一个口径 -->
  <view wx:if="{{isAdmin}}" class="profile-group">管理</view>

  <!-- 举报处理：只有管理员看得到 -->
  <view wx:if="{{isAdmin}}" bindtap="goToReports" class="card card-tap profile-row">
    <view class="profile-row-label">🛡️ 举报处理</view>
    <view wx:if="{{pendingReports > 0}}" class="profile-row-badge">{{pendingReports}}</view>
    <view class="profile-row-arrow">›</view>
  </view>

  <!-- 意见反馈处理：只有管理员看得到 -->
  <view wx:if="{{isAdmin}}" bindtap="goToFeedbacks" class="card card-tap profile-row">
    <view class="profile-row-label">💬 意见反馈</view>
    <view class="profile-row-arrow">›</view>
  </view>

  <!-- ========== 其他 ========== -->
  <view class="profile-group">其他</view>

  <view bindtap="goToAgreement" class="card card-tap profile-row">
    <view class="profile-row-label">📄 用户协议与免责声明</view>
    <view class="profile-row-arrow">›</view>
  </view>
</view>
