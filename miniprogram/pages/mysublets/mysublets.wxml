<view class="page-container">
  <view class="page-title">我发布的转租</view>

  <view wx:if="{{items.length === 0}}" class="text-light" style="text-align: center; margin-top: 100rpx;">
    你还没发布过转租
  </view>

  <view wx:for="{{items}}" wx:key="_id" bindtap="goToDetail" data-id="{{item._id}}" class="card" style="padding: 24rpx;">
    <view style="font-size: 30rpx; font-weight: bold;">{{item.title}}</view>
    <view class="price" style="margin: 8rpx 0;">${{item.rent}}/月</view>
    <view class="text-light" style="font-size: 24rpx;">{{item.room_type}} · 状态：{{item.status}}</view>
  </view>
</view>