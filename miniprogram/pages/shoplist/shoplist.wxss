/* ---------- 我的拼团 ---------- */
.mine {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 22rpx 24rpx;
  margin-bottom: 16rpx;
  border-radius: var(--radius);
}

.mine-forming {
  background: #f6e3e6;
}

.mine-confirming {
  background: #fff4d1;
}

.mine-main {
  flex: 1;
  min-width: 0;
}

.mine-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.mine-sub {
  margin-top: 2rpx;
  font-size: 24rpx;
  color: #8a5a63;
}

.mine-confirming .mine-title {
  color: #7a5200;
}

.mine-confirming .mine-sub {
  color: #9a7a2a;
}

.mine-btn {
  flex-shrink: 0;
  width: auto !important;
  height: 60rpx;
  line-height: 60rpx;
  margin: 0 !important;
  padding: 0 28rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #fff;
  background: var(--color-primary);
}

.mine-btn:active {
  opacity: .85;
}

.mine-go {
  flex-shrink: 0;
  font-size: 26rpx;
  font-weight: 700;
  color: #7a5200;
}

/* ---------- 按天分组 ---------- */
.day {
  margin-top: 40rpx;
}

/* 日期做成大号数字：一眼扫过去先看到「16」，再看是周几 */
.day-head {
  display: flex;
  align-items: center;
  margin: 0 4rpx 16rpx;
}

.day-num {
  /* 黄油体（utils/fonts.js 加载，没加载上退回系统字体），和转发卡片、海报同一款 */
  font-family: "HuangYou", -apple-system, "PingFang SC", sans-serif;
  font-size: 68rpx;
  font-weight: 400;
  line-height: 1;
  color: var(--color-primary);
  font-variant-numeric: tabular-nums;
}

.day-meta {
  margin-left: 14rpx;
  line-height: 1.2;
}

.day-week {
  font-size: 28rpx;
  font-weight: 700;
}

.day-month {
  font-size: 22rpx;
  color: var(--color-text-light);
}

.day-rel {
  margin-left: auto;
  padding: 4rpx 16rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: var(--color-primary);
  background: var(--color-accent);
  border-radius: 999rpx;
}

/* ---------- 场次卡片 ---------- */
.session {
  padding: 24rpx;
}

.session-top {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.session-logo {
  width: 96rpx;
  height: 96rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
}

.session-logo-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fbf0dc;
}

.session-meta {
  flex: 1;
  min-width: 0;
}

.session-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.session-name {
  min-width: 0;
  font-size: 32rpx;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.session-repeat {
  margin: 0 0 0 auto;
  flex-shrink: 0;
}

.session-points {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--color-text-light);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.session-bar {
  margin-top: 22rpx;
}

.none {
  margin-top: 48rpx;
  text-align: center;
}

/* ---------- 其他小店 ---------- */
.others-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 48rpx 4rpx 16rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-text-light);
}

.others-arrow {
  font-size: 24rpx;
  font-weight: 400;
}

.other {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 24rpx;
}

.other-logo {
  width: 80rpx;
  height: 80rpx;
  border-radius: 14rpx;
  flex-shrink: 0;
}

.other-meta {
  flex: 1;
  min-width: 0;
}

.other-name {
  font-size: 30rpx;
  font-weight: 700;
}

.other-desc {
  margin-top: 4rpx;
  font-size: 24rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.other-arrow {
  color: #ccc;
  font-size: 40rpx;
  flex-shrink: 0;
}
