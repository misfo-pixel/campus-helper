<view class="page-container">
  <view class="list-head">
    <view class="page-title" style="margin-bottom: 0;">校外服务 🏪</view>
    <button class="btn-sm" bindtap="goToMyOrders">我的订单</button>
  </view>


  <view wx:if="{{loading}}" class="text-light empty">加载中…</view>
  <view wx:elif="{{shops.length === 0}}" class="text-light empty">
    还没有小店开张，晚点再来看看
  </view>

  <view wx:for="{{shops}}" wx:key="_id" class="card shop" bindtap="goToShop" data-id="{{item._id}}">
    <image wx:if="{{item.logo}}" src="{{item.logo}}" mode="aspectFill" class="shop-logo" />
    <view wx:else class="shop-logo shop-logo-fallback">🏪</view>

    <view class="shop-meta">
      <view class="shop-name-row">
        <text class="shop-name">{{item.name}}</text>
        <text class="shop-status shop-status-{{item.status}}">{{item.statusText}}</text>
      </view>
      <view wx:if="{{item.description}}" class="text-light shop-desc">{{item.description}}</view>
      <view class="text-light shop-info">
        {{item.category}} · 起送 ${{item.min_order}}{{item.needs_delivery === false ? ' · 不配送' : (item.delivery_mode === 'outsourced' ? ' · 饭搭子配送' : ' · 店长自送')}}
      </view>
      <view wx:if="{{item.business_hours}}" class="text-light shop-info">{{item.business_hours}}</view>
    </view>

    <view class="shop-arrow">›</view>
  </view>
</view>
