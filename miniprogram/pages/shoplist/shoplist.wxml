<view class="page-container">
  <view class="page-head">
    <view class="icon-box tint-cream"><image src="/images/modules/shop.svg"></image></view>
    <view class="page-head-text">
      <view class="page-head-title">校外服务</view>
      <view class="page-head-sub">长期服务，稳定委托</view>
    </view>
    <button wx:if="{{ordering}}" class="btn-outline btn-sm" bindtap="goToMyOrders">我的订单</button>
  </view>

  <skeleton wx:if="{{loading}}" type="row" thumb="{{130}}" />
  <view wx:elif="{{shops.length === 0}}" class="empty-state">
    <view class="icon-box tint-cream"><image src="/images/modules/shop.svg"></image></view>
    <view class="empty-state-text">还没有小店开张，晚点再来看看</view>
  </view>

  <view wx:for="{{shops}}" wx:key="_id" class="card shop" bindtap="goToShop" data-id="{{item._id}}">
    <image wx:if="{{item.logo}}" src="{{item.logo}}" mode="aspectFill" class="shop-logo" />
    <view wx:else class="shop-logo shop-logo-fallback"><image src="/images/modules/shop.svg" class="ico-fill"></image></view>

    <view class="shop-meta">
      <view class="shop-name-row">
        <text class="shop-name">{{item.name}}</text>
        <text class="shop-status shop-status-{{item.status}}">{{item.statusText}}</text>
      </view>
      <view wx:if="{{item.description}}" class="text-light shop-desc">{{item.description}}</view>
      <view wx:if="{{ordering}}" class="text-light shop-info">
        起送 ${{item.min_order}}{{item.needs_delivery === false ? ' · 线上服务' : ''}}
      </view>
      <view wx:if="{{item.business_hours}}" class="text-light shop-info">{{item.business_hours}}</view>
    </view>

    <view class="shop-arrow">›</view>
  </view>
</view>
