.head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 8rpx 4rpx 12rpx;
}

.head-date {
  font-family: "HuangYou", -apple-system, "PingFang SC", sans-serif;
  font-size: 52rpx;
  font-weight: 400;
  color: var(--color-text);
}

/* 长图预览：就是存下来的那张，墨线框 + 偏移投影，像贴在墙上的海报 */
.preview {
  border: 4rpx solid #22141a;
  border-radius: var(--radius);
  overflow: hidden;
  box-shadow: 10rpx 10rpx 0 rgba(34, 20, 26, .9);
}

.preview-img {
  display: block;
  width: 100%;
}

.preview-empty {
  height: 900rpx;
  line-height: 900rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--color-text-light);
  background: #f1ece6;
}

.actions {
  display: flex;
  gap: 20rpx;
}

.actions .action {
  flex: 1;
  width: auto !important;
  margin: 0 !important;
}
