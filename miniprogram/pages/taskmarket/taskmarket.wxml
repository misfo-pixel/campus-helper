<!--pages/taskmarket/taskmarket.wxml-->
<view class="page-container">
  <view class="page-head">
    <view class="icon-box tint-maroon"><image src="/images/modules/task.svg"></image></view>
    <view class="page-head-text">
      <view class="page-head-title">帮个忙</view>
      <view class="page-head-sub">代取、代购、跑腿都行</view>
    </view>
    <button class="btn-primary btn-sm" bindtap="goToPublish">+ 发布</button>
  </view>

  <skeleton wx:if="{{loading}}" type="text" />
  <view wx:elif="{{items.length === 0}}" class="empty-state">
    <view class="icon-box tint-maroon"><image src="/images/modules/task.svg"></image></view>
    <view class="empty-state-text">还没有委托任务，来发布第一个吧</view>
    <button class="btn-primary" bindtap="goToPublish">发布委托</button>
  </view>

  <view wx:for="{{items}}" wx:key="_id" bindtap="goToDetail" data-id="{{item._id}}" class="card card-tap">
    <view class="text-card-head">
      <view class="text-card-title">{{item.title}}</view>
      <view class="price text-card-price">${{item.reward}}</view>
    </view>
    <view class="text-card-desc">{{item.description}}</view>
    <view wx:if="{{item.deadline}}" style="margin-top: 16rpx;"><text class="chip">{{item.deadline}} 截止</text></view>
  </view>
</view>
