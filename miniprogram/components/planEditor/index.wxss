.hint {
  font-size: 24rpx;
  color: var(--color-text-light);
  line-height: 1.6;
  margin-bottom: 16rpx;
}

.row {
  padding: 24rpx;
}

.row-head {
  display: flex;
  align-items: center;
}

.row-name {
  flex: 1;
  font-size: 30rpx;
  font-weight: bold;
}

.row-name-solo {
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid var(--color-border);
}

.row-del {
  font-size: 26rpx;
  color: #C8102E;
  flex-shrink: 0;
}

.row-sub {
  font-size: 26rpx;
  color: #555;
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid var(--color-border);
}

.fee-line {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 12rpx;
  font-size: 26rpx;
}

.dollar {
  margin-left: auto;
  color: var(--color-text-light);
}

.fee-input {
  width: 120rpx;
  text-align: right;
  font-size: 30rpx;
}

.times {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 16rpx;
}

.time {
  font-size: 26rpx;
  color: #555;
  background: #f5f5f5;
  padding: 10rpx 20rpx;
  border-radius: 8rpx;
}

.arrow {
  color: var(--color-text-light);
  font-size: 24rpx;
}

.times .row-del {
  margin-left: auto;
}

.add {
  text-align: center;
  padding: 28rpx;
  border: 2rpx dashed #ccc;
  border-radius: 12rpx;
  color: var(--color-text-light);
  font-size: 28rpx;
  margin-bottom: 24rpx;
}
