/* 这个组件用了 card / text-light / subsection-title 三个全局类，自己不重复定义。
   所以 index.json 里必须是 styleIsolation: apply-shared——默认的 isolated 会把
   app.wxss 整个挡在外面，卡片会连白底圆角都没有。
   宿主页（shopedit / teamedit）的类名跟这里零重名，渗进来不会打架；
   以后给组件加类名时留意别撞上宿主页的。 */

.row {
  padding: 24rpx;
}

.row-head {
  display: flex;
  align-items: center;
}

.row-name {
  flex: 1;
  font-size: 30rpx;
  font-weight: bold;
}

.row-del {
  font-size: 26rpx;
  color: #C8102E;
  flex-shrink: 0;
}

.fee-line {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid var(--color-border);
  font-size: 26rpx;
}

.dollar {
  margin-left: auto;
  color: var(--color-text-light);
}

.fee-input {
  width: 120rpx;
  text-align: right;
  font-size: 30rpx;
}

.time {
  font-size: 26rpx;
  color: #555;
  background: #f5f5f5;
  padding: 10rpx 20rpx;
  border-radius: 8rpx;
}

/* 日期没选或已经过期：把那一格标红，别让商家滑过去 */
.time-warn {
  color: #C8102E;
  background: #fdeaec;
}

.slot-line {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
}

.slot-line:first-child {
  margin-top: 0;
}

.slot-label {
  font-size: 26rpx;
  color: var(--color-text-light);
  margin-right: auto;
}

.expired {
  font-size: 24rpx;
  color: #C8102E;
  line-height: 1.6;
  padding-bottom: 16rpx;
  margin-bottom: 4rpx;
  border-bottom: 1rpx solid var(--color-border);
}

.add {
  text-align: center;
  padding: 28rpx;
  border: 2rpx dashed #ccc;
  border-radius: 12rpx;
  color: var(--color-text-light);
  font-size: 28rpx;
  margin-bottom: 24rpx;
}
