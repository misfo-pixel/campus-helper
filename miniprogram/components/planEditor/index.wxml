<view class="plan-editor {{bare ? 'bare' : ''}}">
  <block wx:if="{{part !== 'time'}}">
  <view wx:if="{{!bare}}" class="subsection-title">服务地点与配送费</view>
  <view wx:for="{{points}}" wx:key="index" class="card row">
    <view class="row-head">
      <input placeholder="服务地点（如 Coffman 门口）" value="{{item.name}}" maxlength="20"
             bindinput="onPointInput" data-index="{{index}}" data-field="name" class="row-name" />
      <text class="row-del" bindtap="removePoint" data-index="{{index}}">删除</text>
    </view>
    <view class="fee-line">
      <text class="text-light">配送费</text>
      <text class="dollar">$</text>
      <input type="digit" value="{{item.fee}}" placeholder="0"
             bindinput="onPointInput" data-index="{{index}}" data-field="fee" class="fee-input" />
    </view>
  </view>

  <view class="add" bindtap="addPoint">+ 添加服务地点</view>
  </block>

  <block wx:if="{{part !== 'points'}}">
  <view wx:if="{{!bare}}" class="subsection-title">服务时间</view>
  <view class="{{bare ? '' : 'card row'}}">
    <!-- 场次过了就没人能下单了，但店还挂在列表里，所以这条提示要显眼 -->
    <view wx:if="{{expired}}" class="expired">
      ⚠️ 上一场（{{batch.date}}）已过，买家现在下不了单，换个日期即可。
    </view>

    <view class="slot-line">
      <text class="slot-label">日期</text>
      <picker mode="date" start="{{today}}" value="{{batch.date || today}}"
              bindchange="onBatchInput" data-field="date">
        <view class="time {{expired || !batch.date ? 'time-warn' : ''}}">{{batch.date || '请选择'}}</view>
      </picker>
    </view>

    <view class="slot-line">
      <text class="slot-label">截单时间</text>
      <picker mode="time" value="{{batch.cutoff}}" bindchange="onBatchInput" data-field="cutoff">
        <view class="time">{{batch.cutoff}}</view>
      </picker>
    </view>

    <view class="slot-line">
      <text class="slot-label">送达时间</text>
      <picker mode="time" value="{{batch.deliver_time}}" bindchange="onBatchInput" data-field="deliver_time">
        <view class="time">{{batch.deliver_time}}</view>
      </picker>
    </view>
  </view>
  </block>
</view>
