<view class="plan-editor">
  <view class="section-title">取餐点与配送费</view>
  <view class="hint">买家到点自取，不送到门口。名字会被订单引用，尽量别改已经在用的。</view>

  <view wx:for="{{points}}" wx:key="index" class="card row">
    <view class="row-head">
      <input placeholder="取餐点名称（如 UMN 东岸）" value="{{item.name}}"
             bindinput="onPointInput" data-index="{{index}}" data-field="name" class="row-name" />
      <text class="row-del" bindtap="removePoint" data-index="{{index}}">删除</text>
    </view>
    <input placeholder="具体位置（如 Coffman 门口）" value="{{item.address}}"
           bindinput="onPointInput" data-index="{{index}}" data-field="address" class="row-sub" />
    <view class="fee-line">
      <text class="text-light">配送费</text>
      <text class="dollar">$</text>
      <input type="digit" value="{{item.fee}}" placeholder="0"
             bindinput="onPointInput" data-index="{{index}}" data-field="fee" class="fee-input" />
    </view>
  </view>

  <view class="add" bindtap="addPoint">+ 添加取餐点</view>

  <view class="section-title">配送批次</view>
  <view class="hint">所有订单按批次统一送。一趟送多单，配送费才压得下来。</view>

  <view wx:for="{{batches}}" wx:key="index" class="card row">
    <input placeholder="批次名（如 午餐班）" value="{{item.label}}"
           bindinput="onBatchInput" data-index="{{index}}" data-field="label" class="row-name row-name-solo" />
    <view class="times">
      <picker mode="time" value="{{item.cutoff}}" bindchange="onBatchInput" data-index="{{index}}" data-field="cutoff">
        <view class="time">截单 {{item.cutoff}}</view>
      </picker>
      <text class="arrow">→</text>
      <picker mode="time" value="{{item.deliver_time}}" bindchange="onBatchInput" data-index="{{index}}" data-field="deliver_time">
        <view class="time">到点 {{item.deliver_time}}</view>
      </picker>
      <text class="row-del" bindtap="removeBatch" data-index="{{index}}">删除</text>
    </view>
  </view>

  <view class="add" bindtap="addBatch">+ 添加批次</view>
</view>
