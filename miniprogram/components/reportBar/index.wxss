.report-row {
  display: flex;
  justify-content: center;
  gap: 24rpx;
}

.report-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  margin: 40rpx 0 20rpx;
  padding: 20rpx;
  font-size: 26rpx;
  color: #999;
}

.report-icon {
  width: 28rpx;
  height: 28rpx;
}

.report-bar:active {
  opacity: 0.6;
}
