.board {
  margin-top: 32rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #eee;
}

.board-head {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
  margin-bottom: 20rpx;
}

.board-title {
  font-size: 30rpx;
  font-weight: bold;
}

.board-count {
  font-size: 24rpx;
  color: var(--color-text-light);
}

.board-empty {
  font-size: 26rpx;
  color: var(--color-text-light);
  padding: 24rpx 0;
}

/* ---------- 单条留言 ---------- */
.msg {
  display: flex;
  gap: 20rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.msg-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: #f2f2f2;
}

.msg-avatar-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #999;
}

.msg-body {
  flex: 1;
  min-width: 0;
}

.msg-head {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.msg-name {
  font-size: 26rpx;
  color: #555;
}

.msg-badge {
  font-size: 20rpx;
  color: var(--color-primary);
  background: #f7ecef;
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
}

.msg-time {
  margin-left: auto;
  font-size: 22rpx;
  color: #bbb;
}

.msg-text {
  font-size: 28rpx;
  line-height: 1.6;
  margin-top: 8rpx;
  word-break: break-word;
}

.msg-reply {
  color: var(--color-text-light);
}

.msg-ops {
  display: flex;
  gap: 28rpx;
  margin-top: 10rpx;
}

.msg-op {
  font-size: 22rpx;
  color: #bbb;
}

.msg-op-danger {
  color: #c88;
}

.msg-op:active {
  opacity: 0.6;
}

/* ---------- 输入区 ---------- */
.board-input {
  margin-top: 24rpx;
}

.reply-tag {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 22rpx;
  color: var(--color-text-light);
  margin-bottom: 10rpx;
}

.reply-cancel {
  font-size: 28rpx;
  color: #bbb;
  padding: 0 8rpx;
}

.input-box {
  width: auto;
  height: 140rpx;
  background: #f7f7f7;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
}

.send-btn {
  margin-top: 16rpx;
  float: right;
}
