/* 整块做成一张白卡，和上面的发布者名片同一个质感。
   原来直接铺在页面底色上，输入框的浅灰和底色几乎一样，看不出哪里能点 */
.board {
  margin-top: 32rpx;
  padding: 28rpx;
  background: var(--color-card);
  border-radius: var(--radius);
  box-shadow: var(--shadow-card);
}

.board-head {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
  margin-bottom: 8rpx;
}

.board-title {
  font-size: 30rpx;
  font-weight: bold;
}

.board-count {
  font-size: 24rpx;
  color: var(--color-text-light);
}

.board-empty {
  font-size: 26rpx;
  color: var(--color-text-light);
  padding: 16rpx 0 8rpx;
}

/* ---------- 单条留言 ---------- */
.msg {
  display: flex;
  gap: 20rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}

.msg-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: #f2f2f2;
}

.msg-avatar-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #999;
}

.msg-body {
  flex: 1;
  min-width: 0;
}

.msg-head {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.msg-name {
  font-size: 26rpx;
  color: #555;
}

.msg-badge {
  font-size: 20rpx;
  color: var(--color-primary);
  background: #f7ecef;
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
}

.msg-time {
  margin-left: auto;
  font-size: 22rpx;
  color: #bbb;
}

.msg-text {
  font-size: 28rpx;
  line-height: 1.6;
  margin-top: 8rpx;
  word-break: break-word;
}

.msg-reply {
  color: var(--color-text-light);
}

.msg-ops {
  display: flex;
  gap: 28rpx;
  margin-top: 10rpx;
}

.msg-op {
  font-size: 22rpx;
  color: #bbb;
}

.msg-op-danger {
  color: #c88;
}

.msg-op:active {
  opacity: 0.6;
}

/* ---------- 输入区 ---------- */
.composer {
  margin-top: 20rpx;
}

.reply-tag {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  color: var(--color-primary);
  background: #f7ecef;
  border-radius: 999rpx;
  padding: 4rpx 8rpx 4rpx 18rpx;
  margin-bottom: 12rpx;
}

.reply-cancel {
  font-size: 28rpx;
  line-height: 1;
  padding: 0 8rpx;
}

.composer-box {
  display: flex;
  align-items: flex-end;
  gap: 16rpx;
  padding: 14rpx 14rpx 14rpx 24rpx;
  background: var(--color-bg);
  border-radius: 20rpx;
}

.composer-input {
  flex: 1;
  width: auto;
  min-height: 44rpx;
  padding: 8rpx 0;
  font-size: 28rpx;
  line-height: 1.5;
}

.composer-ph {
  color: #aaa;
}

/* 没字时是灰的，有字才变栗色——看一眼就知道现在点不点得动 */
.composer-send {
  flex-shrink: 0;
  font-size: 26rpx;
  line-height: 1;
  padding: 16rpx 26rpx;
  border-radius: 999rpx;
  color: #fff;
  background: #d8d4d1;
}

.composer-send-on {
  background: var(--color-primary);
}

.composer-send-on:active {
  opacity: 0.7;
}
