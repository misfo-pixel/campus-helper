/* 贴纸风：深色描边 + 错位实心阴影，和首页横幅、宣传海报同一套 */
.sg-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 1000;
  background: rgba(34, 20, 26, 0.62);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 56rpx;
}

.sg-panel {
  position: relative;
  width: 100%;
  box-sizing: border-box;
  padding: 72rpx 40rpx 28rpx;
  background: #FFF4D6;
  border: 5rpx solid #22141a;
  border-radius: 32rpx;
  box-shadow: 10rpx 10rpx 0 #22141a;
}

.sg-badge {
  position: absolute;
  left: 36rpx;
  top: -28rpx;
  padding: 8rpx 26rpx;
  font-size: 28rpx;
  font-weight: 900;
  color: #22141a;
  background: var(--color-accent);
  border: 5rpx solid #22141a;
  border-radius: 99rpx;
  transform: rotate(-4deg);
}

.sg-art {
  position: absolute;
  right: 28rpx;
  top: -64rpx;
  width: 200rpx;
  height: 150rpx;
}

.sg-headline {
  /* 黄油体只有一个字重；没加载出来时退回系统字体，所以还是要写粗体 */
  font-family: "HuangYou", "PingFang SC", sans-serif;
  font-size: 56rpx;
  font-weight: 900;
  line-height: 1.15;
  color: var(--color-primary);
  margin: 12rpx 0 28rpx;
}

/* 仿微信转发卡片 */
.sg-card {
  background: #fff;
  border: 3rpx solid #22141a;
  border-radius: 16rpx;
  padding: 20rpx 20rpx 14rpx;
  transform: rotate(-1.5deg);
}
.sg-card-title {
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.4;
  color: var(--color-text);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.sg-card-img {
  display: block;
  width: 100%;
  height: 340rpx;   /* 5:4，和转发卡片封面一样 */
  margin-top: 14rpx;
  border-radius: 8rpx;
  background: var(--color-border);
}
.sg-card-foot {
  display: flex;
  align-items: center;
  margin-top: 14rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid var(--color-border);
  font-size: 22rpx;
  color: var(--color-text-light);
}
.sg-card-logo {
  width: 30rpx;
  height: 30rpx;
  margin-right: 10rpx;
  border-radius: 50%;
}

.sg-share {
  width: 100% !important;
  margin: 40rpx 0 0 !important;
  padding: 22rpx 0 !important;
  font-size: 32rpx !important;
  font-weight: 900 !important;
  line-height: 1.4 !important;
  text-align: center;
  color: #fff !important;
  background: var(--color-primary) !important;
  border: 5rpx solid #22141a !important;
  border-radius: 99rpx !important;
  box-shadow: 6rpx 6rpx 0 var(--color-accent);
  box-sizing: border-box;
}
.sg-share-wait {
  color: rgba(255, 255, 255, 0.75) !important;
  background: #a05a68 !important;
}

.sg-note {
  margin-top: 36rpx;
  font-size: 26rpx;
  line-height: 1.5;
  color: var(--color-text-light);
  text-align: center;
}

.sg-links {
  display: flex;
  justify-content: center;
  margin-top: 16rpx;
}
.sg-link {
  padding: 16rpx 32rpx;
  font-size: 28rpx;
  color: var(--color-text-light);
}
.sg-share::after {
  border: none;
}
