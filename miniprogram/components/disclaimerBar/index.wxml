<!-- 完整版：只在开店勾协议那一屏用 -->
<view wx:if="{{full}}" class="disclaimer">
  <view class="disclaimer-head">
    <text class="disclaimer-icon">ⓘ</text>
    <text class="disclaimer-title">{{title}}</text>
  </view>
  <view class="disclaimer-line" wx:for="{{lines}}" wx:key="*this">{{item}}</view>
  <view class="disclaimer-link" bindtap="openFull">查看完整免责声明 ›</view>
</view>

<!-- 默认：一行灰字，点进去看全文 -->
<view wx:else class="brief" bindtap="openFull">
  <text class="brief-text">{{brief}}</text>
  <text class="brief-link">详情 ›</text>
</view>
