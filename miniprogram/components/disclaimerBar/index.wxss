.disclaimer {
  background: #fffaf0;
  border: 1rpx solid #f0e2c8;
  border-radius: 12rpx;
  padding: 24rpx;
  margin: 24rpx 0;
}

.disclaimer-head {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 12rpx;
}

.disclaimer-icon {
  font-size: 26rpx;
  color: #b8860b;
}

.disclaimer-title {
  font-size: 26rpx;
  font-weight: bold;
  color: #8a6d1f;
}

.disclaimer-line {
  font-size: 24rpx;
  line-height: 1.7;
  color: #7a6535;
  padding-left: 20rpx;
  position: relative;
}

.disclaimer-line::before {
  content: '·';
  position: absolute;
  left: 4rpx;
}

.disclaimer-link {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #b8860b;
}

.disclaimer-link:active {
  opacity: 0.6;
}

/* 默认形态：一行灰字。不占视觉重量，需要的人点进去看全文 */
.brief {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  margin: 16rpx 0;
}

.brief-text {
  flex: 1;
  min-width: 0;
  font-size: 22rpx;
  line-height: 1.6;
  color: #aaa;
}

.brief-link {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #bbb;
}

.brief:active {
  opacity: 0.6;
}
