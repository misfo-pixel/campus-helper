/**app.wxss**/

/* ============================================================
   校园助手 · 全局设计规范  ——  改色/改尺寸只动这里
   ============================================================ */

   page {
    /* —— 品牌色 —— */
    --color-primary: #7A0019;      /* UMN 栗色 · 主色 */
    --color-primary-soft: #9c1a33; /* 栗色浅一档 · 渐变用 */
    --color-accent: #FFCC33;       /* UMN 金色 · 点缀 */
  
    /* —— 中性色 —— */
    --color-bg: #f6f4f2;           /* 页面底色(暖白) */
    --color-card: #ffffff;         /* 卡片 */
    --color-text: #2b2b2b;         /* 主文字 */
    --color-text-light: #8a8a8a;   /* 次要文字 */
    --color-border: #ececec;       /* 分隔线 */
  
    /* —— 阴影 / 圆角(统一变量) —— */
    --shadow-card: 0 4rpx 20rpx rgba(122, 0, 25, 0.06);
    --radius: 20rpx;
  
    /* 背景:暖白底 + 极淡栗色圆点纹理 */
    background-color: var(--color-bg);
    background-image: radial-gradient(circle, rgba(122, 0, 25, 0.035) 1rpx, transparent 1rpx);
    background-size: 44rpx 44rpx;
  
    color: var(--color-text);
    font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;

    /* 正文基准。以前没设这一行，没显式写字号的文字就落到浏览器默认 16px
       （≈32rpx），比 28rpx 的 subsection-title 还大——标题反而比正文小。
       字号体系现在是：40 页标题 / 32 分节 / 30 小节 = 30 正文 / 26 次要 / 24 提示。
       小节标题和正文同号，靠字重区分，不靠字号。 */
    font-size: 30rpx;
    line-height: 1.5;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
  }
  
  /* ==================== 布局 ==================== */
  
  .page-container { padding: 32rpx; }
  
  .container {
    display: flex;
    flex-direction: column;
    align-items: center;
    box-sizing: border-box;
  }
  
  /* 顶部品牌横幅(首页用) */
  .hero {
    position: relative;
    overflow: hidden;
    padding: 56rpx 40rpx 48rpx;
    margin-bottom: 32rpx;
    border-radius: var(--radius);
    background: linear-gradient(135deg, var(--color-primary), var(--color-primary-soft));
    color: #fff;
  }
  .hero-title { font-size: 46rpx; font-weight: 700; color: #fff; }
  .hero-sub { font-size: 26rpx; color: rgba(255, 255, 255, .82); margin-top: 10rpx; }
  /* 右上角一抹金色光晕做品牌点缀 */
  .hero::after {
    content: "";
    position: absolute;
    top: -60rpx; right: -60rpx;
    width: 220rpx; height: 220rpx;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(255, 204, 51, .35), transparent 70%);
  }
  
  /* ==================== 卡片 ==================== */
  
  .card {
    background: var(--color-card);
    border-radius: var(--radius);
    padding: 28rpx;
    margin-bottom: 24rpx;
    box-shadow: var(--shadow-card);
  }
  /* 可点击卡片:轻微按压反馈 */
  .card-tap:active { transform: scale(.98); opacity: .9; }
  
  /* ==================== 文字 ==================== */
  
  .page-title {
    font-size: 40rpx; font-weight: 700;
    color: var(--color-text);
    margin-bottom: 32rpx;
  }
  .section-title {
    font-size: 32rpx; font-weight: 700;
    color: var(--color-text);
    margin: 24rpx 0 16rpx;
  }
  /* 分节标题下面还要再分小节时用这个。
     和正文同号（30rpx）但加粗——层级靠字重和位置区分，不靠字号。
     原来是 28rpx，比正文还小，读起来像是正文缩了一圈。 */
  .subsection-title {
    font-size: 30rpx; font-weight: 700;
    color: var(--color-text);
    margin: 24rpx 0 12rpx;
  }
  /* 小节标题前加栗色竖条,更有设计感 */
  .section-title-bar {
    padding-left: 20rpx;
    border-left: 8rpx solid var(--color-primary);
    line-height: 1.2;
  }
  /* 分节标题下面的小字说明 */
  .field-hint {
    font-size: 24rpx;
    color: var(--color-text-light);
    line-height: 1.6;
    margin-bottom: 16rpx;
  }
  .text-light { color: var(--color-text-light); font-size: 26rpx; }
  .price { color: #C8102E; font-weight: 700; }
  
  /* ==================== 按钮(颜色+尺寸一体) ==================== */
  
  .btn-primary, .btn-outline {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 88rpx;
    border-radius: 16rpx;
    font-size: 30rpx;
    font-weight: 600;
    /* 微信 button 基础样式自带 line-height: 2.55，在定高的 flex 容器里会把
       文字顶上去。压成 1 之后 align-items: center 才是真的居中。
       上下 padding 一并清零，size="mini" 的默认内边距也会让文字偏。 */
    line-height: 1;
    padding-top: 0;
    padding-bottom: 0;
  }
  .btn-primary { background: var(--color-primary); color: #fff; }
  .btn-primary:active { opacity: .85; }
  .btn-outline {
    background: #fff;
    color: var(--color-primary);
    border: 2rpx solid var(--color-primary);
  }
  .btn-outline:active { background: rgba(122, 0, 25, .05); }

  /* 详情页联系卡片下面的红框按钮：删除、标记已售 / 已租出 / 已完成。
     尺寸照着卡片里的「复制微信号」做：80rpx 高、30rpx 字、600 字重、胶囊圆角。
     宽度不用写：v2 基础库的 wx-button:not([size=mini]) 把普通按钮定死 184px，两个按钮天然一样宽。
     联系卡片是组件，样式隔离拿不到这个 class，改尺寸时同步 components/contactCard/index.wxss 的 .contact-btn */
  .btn-danger {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 80rpx;
    padding: 0;
    border-radius: 999rpx;
    font-size: 30rpx;
    font-weight: 600;
    line-height: normal;
    background: #fff;
    color: #C8102E;
    border: 1rpx solid #C8102E;
  }
  .btn-danger:active { background: rgba(200, 16, 46, .05); }

  /* ==================== 徽标 / 标签 ==================== */
  
  .badge {
    display: inline-block;
    font-size: 20rpx;
    color: var(--color-primary);
    background: var(--color-accent);
    border-radius: 20rpx;
    padding: 4rpx 14rpx;
  }
  .tag {
    display: inline-block;
    font-size: 22rpx;
    color: var(--color-text-light);
    background: var(--color-bg);
    border-radius: 8rpx;
    padding: 4rpx 14rpx;
  }
  
  /* ==================== WeChat button 复位 ==================== */
  
  button { background: initial; }
  button:focus { outline: 0; }
  button::after { border: none; }

  .btn-sm {
    display: inline-flex !important;
    align-items: center;
    justify-content: center;
    width: auto !important;
    height: 64rpx;
    line-height: 1;
    padding: 0 28rpx;
    font-size: 26rpx;
    margin-left: 0 !important;
    margin-right: 0 !important;
  }

  /* 小按钮一律用 .btn-sm，不要写 size="mini"。
     微信的 wx-button[size=mini] 特异性 (0,1,1) 压得过单个 class (0,1,0)，
     会把 display 打回 inline-block、line-height 顶成 2.3，文字就偏上。
     .btn-sm 走的是普通按钮那条路径，冲突点都用 !important 锁掉了。 */
  /* ==================== 供/求 悬浮切换胶囊 ==================== */

  /* 悬浮在内容之上，不参与文档流——所以加不加它，底下的列表布局完全不变。
     位置在拇指自然落点。用它的页面记得给容器加 .with-kind-pill 留出空间。 */
  .kind-pill {
    position: fixed;
    left: 50%;
    bottom: calc(48rpx + env(safe-area-inset-bottom));
    transform: translateX(-50%);
    display: flex;
    padding: 6rpx;
    border-radius: 999rpx;
    background: #fff;
    box-shadow: 0 8rpx 32rpx rgba(122, 0, 25, .2);
    z-index: 50;
  }
  .kind-pill-item {
    min-width: 128rpx;
    padding: 16rpx 0;
    text-align: center;
    font-size: 30rpx;
    color: var(--color-text-light);
    border-radius: 999rpx;
  }
  .kind-pill-on {
    background: var(--color-primary);
    color: #fff;
    font-weight: 700;
  }

  /* 最后一条内容别被胶囊压住 */
  .with-kind-pill { padding-bottom: 200rpx; }

  /* 发布页顶部的「供/求」选择。这是表单里的一个字段，不是悬浮层，所以走内联分段样式 */
  .kind-switch {
    display: flex;
    gap: 12rpx;
    padding: 8rpx;
    margin-bottom: 32rpx;
    border-radius: 16rpx;
    background: var(--color-bg);
  }
  .kind-switch-item {
    flex: 1;
    padding: 20rpx 0;
    text-align: center;
    font-size: 28rpx;
    color: var(--color-text-light);
    border-radius: 12rpx;
  }
  .kind-switch-on {
    background: var(--color-card);
    color: var(--color-primary);
    font-weight: 700;
    box-shadow: var(--shadow-card);
  }

  /* 列表触底的状态提示 */
  .list-foot {
    text-align: center;
    color: var(--color-text-light);
    font-size: 24rpx;
    padding: 32rpx 0 8rpx;
  }

  /* ==================== 详情页：已结束横幅 ==================== */

  /* 帖子卖掉 / 租出 / 完成 / 过期后，三个详情页最顶上那一整条。
     用深灰，不用栗色也不用红：栗色的意思是「可以点」，红色是价钱和删除，
     这里要说的是「这条不用管了」。 */
  .closed-banner {
    display: flex;
    align-items: baseline;
    padding: 24rpx 32rpx;
    background: #4a4a4a;
    color: #fff;
  }
  .closed-banner-label {
    flex-shrink: 0;
    font-size: 32rpx;
    font-weight: 700;
  }
  .closed-banner-hint {
    flex: 1;
    margin-left: 20rpx;
    font-size: 24rpx;
    color: rgba(255, 255, 255, .8);
  }

  /* ==================== 入口格（首页 / 发布页） ==================== */

  /* 白卡片 + 柔和阴影，颜色只放在图标底下那块圆角方里。
     2026-10-10 试过海报那套粗墨线 + 硬阴影 + 整块平涂，入口页上太冲，退回到这一档。
     图标在 images/modules/，自带墨线描边，个性靠它们就够了。 */
  .tile-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
  }
  .tile {
    position: relative;
    box-sizing: border-box;
    width: calc(50% - 10rpx);
    margin-bottom: 20rpx;
    padding: 28rpx 24rpx;
    border-radius: var(--radius);
    background: var(--color-card);
    box-shadow: var(--shadow-card);
  }
  .tile:active { opacity: .85; }
  .tile-title { margin-top: 20rpx; font-size: 32rpx; font-weight: 700; color: var(--color-text); }
  .tile-sub { margin-top: 4rpx; font-size: 24rpx; color: var(--color-text-light); }

  /* 单数个入口时最后一个铺满一行，图标挪到左边 */
  .tile-wide {
    width: 100%;
    display: flex;
    align-items: center;
    padding: 24rpx;
  }
  .tile-wide .icon-box { margin-right: 24rpx; }
  .tile-wide .tile-title { margin-top: 0; }


  /* 右上角的小标，比如新模块的「新」 */
  .tile-sticker {
    position: absolute;
    top: 24rpx;
    right: 24rpx;
    padding: 2rpx 14rpx;
    font-size: 20rpx;
    font-weight: 700;
    color: var(--color-primary);
    background: var(--color-accent);
    border-radius: 99rpx;
  }

  /* ==================== 自绘图标 ==================== */

  /* 图标在 images/modules/（模块大图标）和 images/ui/（小图标），同一套墨线描边。
     全项目不用系统 emoji：各家手机渲染不一样，跟这套画风也不搭。 */
  .ico-md { display: inline-block; width: 52rpx; height: 52rpx; vertical-align: middle; }
  .ico-lg { display: inline-block; width: 128rpx; height: 128rpx; }
  /* 放进「没图时的灰底占位」里，按容器大小缩放 */
  .ico-fill { width: 56%; height: 56%; }

  /* ==================== 模块图标底块 ==================== */

  /* 自绘模块图标垫一块淡色圆角方。同一个模块在首页、发布页、列表页头、
     发布表单头都是同一种颜色：二手金、委托栗、校外服务奶油，其余暖灰 */
  .icon-box {
    flex-shrink: 0;
    width: 96rpx;
    height: 96rpx;
    border-radius: 24rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #f5f2ee;
  }
  .icon-box image { width: 72rpx; height: 72rpx; }
  .tint-gold   { background: #fff4d1; }
  .tint-maroon { background: #f6e3e6; }
  .tint-cream  { background: #fbf0dc; }

  /* ==================== 列表页 / 表单页的页头 ==================== */

  /* 模块图标 + 标题 + 一行副标题，右边可以放「+ 发布」。
     各模块进来第一眼是同一个结构，知道自己在哪个板块 */
  .page-head {
    display: flex;
    align-items: center;
    margin-bottom: 32rpx;
  }
  .page-head .icon-box { width: 88rpx; height: 88rpx; margin-right: 20rpx; }
  .page-head .icon-box image { width: 64rpx; height: 64rpx; }
  .page-head-text { flex: 1; min-width: 0; }
  .page-head-title { font-size: 40rpx; font-weight: 700; line-height: 1.25; color: var(--color-text); }
  .page-head-sub { margin-top: 2rpx; font-size: 24rpx; color: var(--color-text-light); }

  /* ==================== 搜索框 ==================== */

  .search-bar {
    display: flex;
    align-items: center;
    height: 80rpx;
    padding: 0 28rpx;
    margin-bottom: 28rpx;
    border-radius: 40rpx;
    background: var(--color-card);
    box-shadow: var(--shadow-card);
  }
  .search-bar image { width: 32rpx; height: 32rpx; margin-right: 16rpx; flex-shrink: 0; }
  .search-bar input { flex: 1; font-size: 28rpx; }

  /* ==================== 空状态 ==================== */

  .empty-state {
    padding: 96rpx 32rpx;
    text-align: center;
  }
  .empty-state .icon-box { width: 144rpx; height: 144rpx; margin: 0 auto 24rpx; border-radius: 40rpx; }
  .empty-state .icon-box image { width: 104rpx; height: 104rpx; }
  .empty-state-text { font-size: 28rpx; color: var(--color-text-light); }
  .empty-state .btn-primary { display: inline-flex; width: auto !important; margin-top: 32rpx; padding: 0 48rpx; }

  /* ==================== 列表卡片 ==================== */

  /* 二手「在卖」的两列图片卡 */
  .goods-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
  }
  .goods-card {
    width: calc(50% - 10rpx);
    margin-bottom: 20rpx;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--color-card);
    box-shadow: var(--shadow-card);
  }
  .goods-card:active { opacity: .9; }
  .goods-img { display: block; width: 100%; height: 330rpx; background: #f0ece8; }
  .goods-body { padding: 16rpx 20rpx 20rpx; }
  .goods-title {
    font-size: 28rpx;
    line-height: 1.4;
    height: 78rpx;
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }
  .goods-price { margin-top: 8rpx; font-size: 32rpx; }

  /* 文字为主的列表卡（求购、求租、委托）：标题一行，价钱靠右，描述两行 */
  .text-card-head { display: flex; align-items: baseline; }
  .text-card-title {
    flex: 1;
    min-width: 0;
    font-size: 30rpx;
    font-weight: 700;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .text-card-price { margin-left: 20rpx; flex-shrink: 0; }
  .text-card-desc {
    margin-top: 12rpx;
    font-size: 26rpx;
    color: var(--color-text-light);
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }
  .text-card-meta { margin-top: 12rpx; font-size: 24rpx; color: var(--color-text-light); }

  /* 小灰标签：房型、截止日期这类短信息 */
  .chip {
    display: inline-block;
    margin-right: 12rpx;
    padding: 2rpx 14rpx;
    font-size: 22rpx;
    color: #6b5f57;
    background: #f5f2ee;
    border-radius: 8rpx;
  }

  /* ==================== 发布表单 ==================== */

  /* 同一节的输入框收进一张卡，中间细线分隔。原来每个框一张卡，
     满屏浮着十几张小卡片，看不出哪些是一组。字段名仍写在 placeholder 里 */
  /* 分隔线画在每一项的顶上，再用 -1rpx 把它往上提：第一项的线被卡片的
     overflow: hidden 切掉，其余各项的线正好落在两项中间。
     WXSS 不支持 :last-child / > / + 这些选择器，靠这个办法绕开，
     字段按 wx:if 显隐时也不用管谁是最后一项 */
  .form-group {
    overflow: hidden;
    padding: 0 28rpx;
    margin-bottom: 24rpx;
    border-radius: var(--radius);
    background: var(--color-card);
    box-shadow: var(--shadow-card);
  }
  .form-input,
  .form-textarea,
  .form-row,
  .form-pair,
  .uploader {
    margin-top: -1rpx;
    border-top: 1rpx solid var(--color-border);
  }
  .form-input {
    display: block;
    height: 100rpx;
    min-height: 100rpx;
    font-size: 30rpx;
  }
  .form-textarea {
    display: block;
    width: auto;
    height: 160rpx;
    padding: 28rpx 0;
    font-size: 30rpx;
  }

  /* 选完之后框里只剩值的项（日期、下拉）：左边写是哪一项，右边是值 */
  .form-row {
    display: flex;
    align-items: center;
    min-height: 100rpx;
    font-size: 30rpx;
  }
  .form-row-label { flex-shrink: 0; }
  .form-row-value { margin-left: auto; text-align: right; }
  .form-row-empty { color: #b3b3b3; }
  .form-row-arrow { margin-left: 12rpx; color: #ccc; font-size: 36rpx; line-height: 1; }
  /* 两个并排的输入（预算区间、卧室/卫生间） */
  /* 里面的两项各自加 .form-pair-item，右边那项再加 .form-pair-right */
  .form-pair { display: flex; }
  .form-pair-item { flex: 1; min-width: 0; }
  .form-pair .form-input,
  .form-pair .form-row { margin-top: 0; border-top: none; }
  .form-pair-right { margin-left: 24rpx; padding-left: 24rpx; border-left: 1rpx solid var(--color-border); }

  /* 选图：一行三张，加图那格带相机图标和张数 */
  /* 每格都带右边距，容器往右多伸出同样的 20rpx 抵掉，三格正好排满一行 */
  .uploader {
    display: flex;
    flex-wrap: wrap;
    padding: 24rpx 0 4rpx;
  }
  .uploader-inner {
    display: flex;
    flex-wrap: wrap;
    width: calc(100% + 20rpx);
    margin-right: -20rpx;
  }
  .uploader-cell {
    position: relative;
    width: calc((100% - 60rpx) / 3);
    height: 196rpx;
    margin: 0 20rpx 20rpx 0;
  }
  .uploader-img { width: 100%; height: 100%; border-radius: 16rpx; }
  .uploader-add {
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    border: 2rpx dashed #d9d2cb;
    border-radius: 16rpx;
    background: #faf8f6;
    font-size: 22rpx;
    color: var(--color-text-light);
  }
  .uploader-add image { width: 64rpx; height: 64rpx; margin-bottom: 6rpx; }
  /* 右上角删除：外层透明 padding 把点击区域放大，圆点本身只画 40rpx */
  .uploader-del { position: absolute; top: -20rpx; right: -20rpx; padding: 12rpx; }
  .uploader-del view {
    width: 40rpx; height: 40rpx; border-radius: 50%;
    background: rgba(0, 0, 0, .6); color: #fff;
    font-size: 30rpx; line-height: 40rpx; text-align: center;
  }

  /* 发布按钮钉在底部，长表单不用滑到底才找得到。页面底部留出它的高度 */
  .with-submit-bar { padding-bottom: calc(176rpx + env(safe-area-inset-bottom)); }
  .submit-bar button { width: 100% !important; }
  .submit-bar {
    position: fixed;
    left: 0; right: 0; bottom: 0;
    z-index: 10;
    padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
    background: rgba(255, 255, 255, .96);
    box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, .04);
  }

  /* ==================== 详情页 ==================== */

  /* 有图时，内容区做成一张盖在图片下沿的圆角面板 */
  .detail-sheet {
    position: relative;
    margin-top: -32rpx;
    border-radius: 32rpx 32rpx 0 0;
    background: var(--color-bg);
  }
  .detail-title { font-size: 40rpx; font-weight: 700; line-height: 1.35; }
  .detail-price { margin-top: 12rpx; font-size: 48rpx; }
  .detail-text { line-height: 1.7; color: #555; white-space: pre-wrap; }

  /* 「房型 / 地址 / 租期」这种成对信息：左灰标签，右值 */
  .kv-list {
    overflow: hidden;
    padding: 0 28rpx;
    margin-top: 32rpx;
    border-radius: var(--radius);
    background: var(--color-card);
    box-shadow: var(--shadow-card);
  }
  /* 分隔线的画法同 .form-group */
  .kv-row {
    display: flex;
    margin-top: -1rpx;
    padding: 24rpx 0;
    font-size: 28rpx;
    border-top: 1rpx solid var(--color-border);
  }
  .kv-label { flex-shrink: 0; width: 160rpx; color: var(--color-text-light); }
  .kv-value { flex: 1; min-width: 0; text-align: right; }

  /* 发布者的操作按钮并排放，不再一颗颗竖着排满屏红框 */
  /* 普通按钮被基础库定死 184px 宽（见 .btn-danger 的说明），并排时要放开。
     「标记已售」用栗色框、「删除」用红框，尺寸都照 .btn-danger 的胶囊 */
  .owner-actions { display: flex; margin: 24rpx -10rpx 0; }
  .owner-actions button { flex: 1; width: auto !important; margin: 0 10rpx !important; }
  .owner-actions .btn-outline { height: 80rpx; border-radius: 999rpx; border-width: 1rpx; }

  /* ==================== 一起拼团 ==================== */

  /* 进度条：栗色往前走，成团后换金色。列表、店铺页、参团成功、我的订单、工作台共用 */
  .gb-bar {
    height: 14rpx;
    border-radius: 999rpx;
    background: #f1e9e2;
    overflow: hidden;
  }
  .gb-bar-fill {
    height: 100%;
    border-radius: 999rpx;
    background: var(--color-primary);
  }
  .gb-bar-done .gb-bar-fill { background: var(--color-accent); }

  /* 进度条下面那一行：左边一句话，右边截单时间 */
  .gb-line {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-top: 12rpx;
    font-size: 24rpx;
  }
  .gb-text { font-size: 26rpx; font-weight: 700; color: var(--color-primary); }
  .gb-text-quiet { font-size: 26rpx; color: var(--color-text-light); }
  .gb-cut { color: var(--color-text-light); }
  .gb-cut-hot { color: #C8102E; font-weight: 700; }

  /* 「已成团」小贴纸：金底栗字，歪一点，和首页「新」标同一个意思 */
  .gb-sticker {
    display: inline-block;
    padding: 2rpx 14rpx;
    font-size: 20rpx;
    font-weight: 700;
    color: var(--color-primary);
    background: var(--color-accent);
    border-radius: 8rpx;
    transform: rotate(-4deg);
  }
