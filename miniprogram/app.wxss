/**app.wxss**/

/* ============================================================
   校园助手 · 全局设计规范  ——  改色/改尺寸只动这里
   ============================================================ */

   page {
    /* —— 品牌色 —— */
    --color-primary: #7A0019;      /* UMN 栗色 · 主色 */
    --color-primary-soft: #9c1a33; /* 栗色浅一档 · 渐变用 */
    --color-accent: #FFCC33;       /* UMN 金色 · 点缀 */
  
    /* —— 中性色 —— */
    --color-bg: #f6f4f2;           /* 页面底色(暖白) */
    --color-card: #ffffff;         /* 卡片 */
    --color-text: #2b2b2b;         /* 主文字 */
    --color-text-light: #8a8a8a;   /* 次要文字 */
    --color-border: #ececec;       /* 分隔线 */
  
    /* —— 阴影 / 圆角(统一变量) —— */
    --shadow-card: 0 4rpx 20rpx rgba(122, 0, 25, 0.06);
    --radius: 20rpx;
  
    /* 背景:暖白底 + 极淡栗色圆点纹理 */
    background-color: var(--color-bg);
    background-image: radial-gradient(circle, rgba(122, 0, 25, 0.035) 1rpx, transparent 1rpx);
    background-size: 44rpx 44rpx;
  
    color: var(--color-text);
    font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;

    /* 正文基准。以前没设这一行，没显式写字号的文字就落到浏览器默认 16px
       （≈32rpx），比 28rpx 的 subsection-title 还大——标题反而比正文小。
       字号体系现在是：40 页标题 / 32 分节 / 30 小节 = 30 正文 / 26 次要 / 24 提示。
       小节标题和正文同号，靠字重区分，不靠字号。 */
    font-size: 30rpx;
    line-height: 1.5;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
  }
  
  /* ==================== 布局 ==================== */
  
  .page-container { padding: 32rpx; }
  
  .container {
    display: flex;
    flex-direction: column;
    align-items: center;
    box-sizing: border-box;
  }
  
  /* 顶部品牌横幅(首页用) */
  .hero {
    position: relative;
    overflow: hidden;
    padding: 56rpx 40rpx 48rpx;
    margin-bottom: 32rpx;
    border-radius: var(--radius);
    background: linear-gradient(135deg, var(--color-primary), var(--color-primary-soft));
    color: #fff;
  }
  .hero-title { font-size: 46rpx; font-weight: 700; color: #fff; }
  .hero-sub { font-size: 26rpx; color: rgba(255, 255, 255, .82); margin-top: 10rpx; }
  /* 右上角一抹金色光晕做品牌点缀 */
  .hero::after {
    content: "";
    position: absolute;
    top: -60rpx; right: -60rpx;
    width: 220rpx; height: 220rpx;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(255, 204, 51, .35), transparent 70%);
  }
  
  /* ==================== 卡片 ==================== */
  
  .card {
    background: var(--color-card);
    border-radius: var(--radius);
    padding: 28rpx;
    margin-bottom: 24rpx;
    box-shadow: var(--shadow-card);
  }
  /* 可点击卡片:轻微按压反馈 */
  .card-tap:active { transform: scale(.98); opacity: .9; }
  
  /* ==================== 文字 ==================== */
  
  .page-title {
    font-size: 40rpx; font-weight: 700;
    color: var(--color-text);
    margin-bottom: 32rpx;
  }
  .section-title {
    font-size: 32rpx; font-weight: 700;
    color: var(--color-text);
    margin: 24rpx 0 16rpx;
  }
  /* 分节标题下面还要再分小节时用这个。
     和正文同号（30rpx）但加粗——层级靠字重和位置区分，不靠字号。
     原来是 28rpx，比正文还小，读起来像是正文缩了一圈。 */
  .subsection-title {
    font-size: 30rpx; font-weight: 700;
    color: var(--color-text);
    margin: 24rpx 0 12rpx;
  }
  /* 小节标题前加栗色竖条,更有设计感 */
  .section-title-bar {
    padding-left: 20rpx;
    border-left: 8rpx solid var(--color-primary);
    line-height: 1.2;
  }
  /* 分节标题下面的小字说明 */
  .field-hint {
    font-size: 24rpx;
    color: var(--color-text-light);
    line-height: 1.6;
    margin-bottom: 16rpx;
  }
  .text-light { color: var(--color-text-light); font-size: 26rpx; }
  .price { color: #C8102E; font-weight: 700; }
  
  /* ==================== 按钮(颜色+尺寸一体) ==================== */
  
  .btn-primary, .btn-outline {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 88rpx;
    border-radius: 16rpx;
    font-size: 30rpx;
    font-weight: 600;
    /* 微信 button 基础样式自带 line-height: 2.55，在定高的 flex 容器里会把
       文字顶上去。压成 1 之后 align-items: center 才是真的居中。
       上下 padding 一并清零，size="mini" 的默认内边距也会让文字偏。 */
    line-height: 1;
    padding-top: 0;
    padding-bottom: 0;
  }
  .btn-primary { background: var(--color-primary); color: #fff; }
  .btn-primary:active { opacity: .85; }
  .btn-outline {
    background: #fff;
    color: var(--color-primary);
    border: 2rpx solid var(--color-primary);
  }
  .btn-outline:active { background: rgba(122, 0, 25, .05); }

  /* 详情页联系卡片下面的红框按钮：删除、标记已售 / 已租出 / 已完成。
     尺寸照着卡片里的「复制微信号」做：80rpx 高、30rpx 字、600 字重、胶囊圆角。
     宽度不用写：v2 基础库的 wx-button:not([size=mini]) 把普通按钮定死 184px，两个按钮天然一样宽。
     联系卡片是组件，样式隔离拿不到这个 class，改尺寸时同步 components/contactCard/index.wxss 的 .contact-btn */
  .btn-danger {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 80rpx;
    padding: 0;
    border-radius: 999rpx;
    font-size: 30rpx;
    font-weight: 600;
    line-height: normal;
    background: #fff;
    color: #C8102E;
    border: 1rpx solid #C8102E;
  }
  .btn-danger:active { background: rgba(200, 16, 46, .05); }

  /* ==================== 徽标 / 标签 ==================== */
  
  .badge {
    display: inline-block;
    font-size: 20rpx;
    color: var(--color-primary);
    background: var(--color-accent);
    border-radius: 20rpx;
    padding: 4rpx 14rpx;
  }
  .tag {
    display: inline-block;
    font-size: 22rpx;
    color: var(--color-text-light);
    background: var(--color-bg);
    border-radius: 8rpx;
    padding: 4rpx 14rpx;
  }
  
  /* ==================== WeChat button 复位 ==================== */
  
  button { background: initial; }
  button:focus { outline: 0; }
  button::after { border: none; }

  .btn-sm {
    display: inline-flex !important;
    align-items: center;
    justify-content: center;
    width: auto !important;
    height: 64rpx;
    line-height: 1;
    padding: 0 28rpx;
    font-size: 26rpx;
    margin-left: 0 !important;
    margin-right: 0 !important;
  }

  /* 小按钮一律用 .btn-sm，不要写 size="mini"。
     微信的 wx-button[size=mini] 特异性 (0,1,1) 压得过单个 class (0,1,0)，
     会把 display 打回 inline-block、line-height 顶成 2.3，文字就偏上。
     .btn-sm 走的是普通按钮那条路径，冲突点都用 !important 锁掉了。 */
  /* ==================== 供/求 悬浮切换胶囊 ==================== */

  /* 悬浮在内容之上，不参与文档流——所以加不加它，底下的列表布局完全不变。
     位置在拇指自然落点。用它的页面记得给容器加 .with-kind-pill 留出空间。 */
  .kind-pill {
    position: fixed;
    left: 50%;
    bottom: calc(48rpx + env(safe-area-inset-bottom));
    transform: translateX(-50%);
    display: flex;
    padding: 6rpx;
    border-radius: 999rpx;
    background: #fff;
    box-shadow: 0 8rpx 32rpx rgba(122, 0, 25, .2);
    z-index: 50;
  }
  .kind-pill-item {
    min-width: 128rpx;
    padding: 16rpx 0;
    text-align: center;
    font-size: 30rpx;
    color: var(--color-text-light);
    border-radius: 999rpx;
  }
  .kind-pill-on {
    background: var(--color-primary);
    color: #fff;
    font-weight: 700;
  }

  /* 最后一条内容别被胶囊压住 */
  .with-kind-pill { padding-bottom: 200rpx; }

  /* 发布页顶部的「供/求」选择。这是表单里的一个字段，不是悬浮层，所以走内联分段样式 */
  .kind-switch {
    display: flex;
    gap: 12rpx;
    padding: 8rpx;
    margin-bottom: 32rpx;
    border-radius: 16rpx;
    background: var(--color-bg);
  }
  .kind-switch-item {
    flex: 1;
    padding: 20rpx 0;
    text-align: center;
    font-size: 28rpx;
    color: var(--color-text-light);
    border-radius: 12rpx;
  }
  .kind-switch-on {
    background: var(--color-card);
    color: var(--color-primary);
    font-weight: 700;
    box-shadow: var(--shadow-card);
  }

  /* 列表触底的状态提示 */
  .list-foot {
    text-align: center;
    color: var(--color-text-light);
    font-size: 24rpx;
    padding: 32rpx 0 8rpx;
  }

  /* ==================== 详情页：已结束横幅 ==================== */

  /* 帖子卖掉 / 租出 / 完成 / 过期后，三个详情页最顶上那一整条。
     用深灰，不用栗色也不用红：栗色的意思是「可以点」，红色是价钱和删除，
     这里要说的是「这条不用管了」。 */
  .closed-banner {
    display: flex;
    align-items: baseline;
    padding: 24rpx 32rpx;
    background: #4a4a4a;
    color: #fff;
  }
  .closed-banner-label {
    flex-shrink: 0;
    font-size: 32rpx;
    font-weight: 700;
  }
  .closed-banner-hint {
    flex: 1;
    margin-left: 20rpx;
    font-size: 24rpx;
    color: rgba(255, 255, 255, .8);
  }
